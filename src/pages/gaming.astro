---
// The old address of the Playground (#197 → #216). Links, bookmarks and installed apps that still open
// /gaming/ (or /gaming/#paper-plane) land on /playground/ with the same anchor.
const to = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}playground/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to Playground</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <!-- Relative, so /ja/gaming/ lands on /ja/playground/ (#87). -->
    <meta http-equiv="refresh" content="0; url=../playground/" />
    <script is:inline>
      location.replace('../playground/' + location.hash);
    </script>
  </head>
  <body>
    <p>This page moved to <a href={to}>Playground</a>.</p>
  </body>
</html>
