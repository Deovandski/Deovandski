// Painting/Drawing: each picture captioned with the date it was taken (photo metadata, else filename).
// Pictures with neither can get an approximate day in content/painting/_dates.md, shown as "Circa Q1 2013".
// Oldest first so it reads as a progression; undated ones go last, in filename order.
const circa = new Map(
  [...(existsSync('content/painting/_dates.md') ? readFileSync('content/painting/_dates.md', 'utf8') : '')
