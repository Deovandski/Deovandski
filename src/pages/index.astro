---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ranking from '../components/Ranking.astro';
import TravelerFacet from '../components/TravelerFacet.astro';
import MentorFacet from '../components/MentorFacet.astro';
import MultilingualFacet from '../components/MultilingualFacet.astro';
import Sections from '../components/Sections.astro';
import GymFacet from '../components/GymFacet.astro';
import SexFacet from '../components/SexFacet.astro';
import GalleryGrid from '../components/Gallery.astro';
import kingOfHues from '../assets/king-of-hues.jpg';
import { loadPeeta } from '../lib/peeta';
import { loadGallery } from '../lib/gallery';
import { loadRankedList } from '../lib/ranking';
import { loadSections } from '../lib/sections';
import { loadBotw } from '../lib/botw';

type LinkItem = { href: string; label: string };

const devLinks: LinkItem[] = [
  { href: 'https://www.wizarddeosolutions.com/', label: 'Wizard Deo Solutions' },
  { href: 'https://www.linkedin.com/in/deovandski/', label: 'LinkedIn' },
  { href: 'https://github.com/Deovandski', label: 'GitHub' },
  { href: 'https://deovandski.github.io/Deo-s-Framework16-LED-Matrix-Manager/', label: 'Framework 16 LED Matrix Manager' },
  { href: 'https://stackoverflow.com/users/4830578/deovandski', label: 'StackOverflow' },
  { href: 'https://stoneridgesoftware.com/author/deovandskis/', label: 'My Stoneridge Software posts' },
];

const authorLinks: LinkItem[] = [
  { href: 'https://husbandoutworld.com', label: '#HusbandOutWorld Series' },
  { href: 'https://deovandski.github.io/Vraki-West-March-Campaign-D-D/', label: 'Vraki West March D&D Campaign' },
  { href: 'https://deovandski.github.io/vraki-windows/', label: 'Vraki Writing System' },
  { href: 'https://deovandski.github.io/HusbandOutWorld/blog/', label: 'Blog' },
];

// PM tab: my public GitHub Projects boards (https://github.com/Deovandski?tab=projects).
const boards = [
  {
    title: "Deovandski's Blog",
    about: 'This site: every facet, fix and idea, from backlog to merged.',
    board: 'https://github.com/users/Deovandski/projects/2',
    links: [{ href: 'https://github.com/Deovandski/Deovandski', label: 'Repo' }],
  },
  {
    title: '#HusbandOutWorld Website',
    about: 'The light novel series site: the full novel, the World Lore, and Public and Behind The Scenes layers.',
    board: 'https://github.com/users/Deovandski/projects/4',
    links: [
      { href: 'https://www.husbandoutworld.com', label: 'Website' },
      { href: 'https://github.com/Deovandski/HusbandOutWorld', label: 'Repo' },
    ],
  },
  {
    title: 'Vraki West March Campaign D&D',
    about: 'A West Marches D&D 5e campaign set in the world of #HusbandOutWorld.',
    board: 'https://github.com/users/Deovandski/projects/5',
    links: [
      { href: 'https://deovandski.github.io/Vraki-West-March-Campaign-D-D/', label: 'Website' },
      { href: 'https://github.com/Deovandski/Vraki-West-March-Campaign-D-D', label: 'Repo' },
    ],
  },
  {
    title: 'Sinoi The Fisherman',
    about: 'A touch-first pixel-art fishing game in the world of Vraki. Free, no ads, open source.',
    board: 'https://github.com/users/Deovandski/projects/6',
    links: [
      { href: 'https://deovandski.github.io/Sinoi-the-fisherman/', label: 'Website' },
      { href: 'https://github.com/Deovandski/Sinoi-the-fisherman', label: 'Repo' },
    ],
  },
];

const STEAM = 'https://steamcommunity.com/id/deovandski';
const MAL = 'https://myanimelist.net/profile/Deovandski';

const influencerLinks: LinkItem[] = [
  { href: 'https://www.youtube.com/channel/UCl57I3mRQhtGkesGWOA5Z-w', label: 'YouTube' },
  { href: STEAM, label: 'Steam' },
  { href: MAL, label: 'MyAnimeList' },
  { href: 'https://www.linkedin.com/in/deovandski', label: 'LinkedIn' },
];

const tabs = [
  { id: 'dev', icon: '💻', label: 'Dev' },
  { id: 'author', icon: '✍️', label: 'Author' },
  { id: 'mentor', icon: '🔥', label: 'Mentor' },
  { id: 'pm', icon: '📋', label: 'PM' },
  { id: 'influencer', icon: '📣', label: 'Influencer' },
  { id: 'traveler', icon: '🗺️', label: 'Traveler' },
  { id: 'fishing', icon: '🎣', label: 'Fishing' },
  { id: 'dnd', icon: '🎲', label: 'D&D' },
  { id: 'camping', icon: '⛺', label: 'Camping' },
  { id: 'botw', icon: '📼', label: 'BOTW' },
  { id: 'multilingual', icon: '🗣️', label: 'Multilingual' },
  { id: 'tattoo', icon: '🖋️', label: 'Tattoo' },
  { id: 'gym', icon: '🏋️', label: 'Gym' },
  { id: 'miku', icon: '🎤', label: '初音ミク' },
  { id: 'churrasco', icon: '🥩', label: 'Churrasco' },
  { id: 'drummer', icon: '🥁', label: 'Drummer' },
  { id: 'concert', icon: '🤘', label: 'Concert' },
  { id: 'theater', icon: '🎭', label: 'Theater & Opera' },
  { id: 'gamer', icon: '🎮', label: 'Gamer' },
  { id: 'anime', icon: '🍥', label: 'Anime' },
  { id: 'potato', icon: '🥔', label: 'Potato' },
  { id: 'cat', icon: '🐱', label: 'Cat Dad' },
  { id: 'sex', icon: '😘', label: 'Sex' },
];

// Alphabetical for visitors; 初音ミク sorts as "Hatsune Miku". No tab opens by default: visitors pick one.
const sortKey = (t: { id: string; label: string }) => (t.id === 'miku' ? 'Hatsune Miku' : t.label).toLowerCase();
tabs.sort((a, b) => sortKey(a).localeCompare(sortKey(b)));

const games = loadRankedList('content/gaming/top39.md', 'Hours');
const anime = loadRankedList('content/anime/top39.md');
const tvShows = loadRankedList('content/tv/top39.md');
const movies = loadRankedList('content/movies/top39.md');
const tattoos = loadSections('content/tattoos.md', 'content/tattoos');
const mikuConcerts = loadSections('content/miku.md', 'content/miku');
const churrasco = loadSections('content/churrasco.md', 'content/churrasco');
const concerts = loadSections('content/concerts.md', 'content/concerts');
const theater = loadSections('content/theater.md', 'content/theater');
const fishing = loadGallery('content/fishing', 'Fishing');
const camping = loadSections('content/camping.md', 'content/camping');
const dnd = loadSections('content/dnd.md', 'content/dnd');
const botw = loadBotw();
const nf = new Intl.NumberFormat('en-US');
const totalHours = games.reduce((sum, g) => sum + (g.value ?? 0), 0);

const peeta = loadPeeta();
---

<Base>
  <section class="hero" aria-labelledby="howdy">
    <div class="hero__text">
      <h1 id="howdy">Howdy!</h1>
    </div>
    <figure class="king">
      <Image
        src={kingOfHues}
        alt="Deo in a gold imperial dragon robe and crown on a throne at the Imperial City in Huế, flanked by two attendants in blue áo dài"
        widths={[480, 760, 1120]}
        sizes="(max-width: 820px) 100vw, 544px"
        loading="eager"
      />
      <figcaption>
        <strong>King of Hues.</strong> Crowned in Huế, fluent in <abbr title="How Brazilians laugh online">huehuehue</abbr>.
        I take life as seriously as I laugh at it.
      </figcaption>
    </figure>
  </section>

  <div class="facets">
    <h2 class="facets__title" id="facets-title">The facets that fulfill Deo</h2>
    <div class="tabs" role="tablist" aria-labelledby="facets-title">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected="false"
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
          >
            <span class="tabs__icon" aria-hidden="true">
              {t.icon}
            </span>
            {t.label}
          </button>
        ))
      }
    </div>

    <p class="pick" id="pick-hint">Pick a tab above to dive in.</p>

    <section class="panel" role="tabpanel" id="panel-dev" aria-labelledby="tab-dev" tabindex="0" hidden>
      <div class="story">
        <p class="dev-headline">
          Senior Software Engineer, Dynamics 365 F&amp;O Architect, and Founder &amp; CEO of Wizard Deo Solutions.
        </p>
        <p>
          I specialize in enterprise architecture, integrations, cloud technologies, AI, and full stack development, with
          experience spanning ERP systems, modern web and mobile applications, and multiple industries. I got into the
          Dynamics 365 F&amp;O world through Stoneridge Software, where you can still glance at some of the X++ fun I had.
        </p>
        <p>
          As an extroverted engineer, I thrive at the intersection of technology and people, whether that's architecting
          solutions, mentoring developers, collaborating with stakeholders, or leading client discussions.
        </p>
        <p>
          GitHub only has a fraction of my code because of NDAs, but I'm proud of the LED Matrix Manager I cooked up for
          Framework 16 users. StackOverflow? Haven't used it in a long, long while. Times have changed, and it's fun and weird!
        </p>
        <ul class="pills">
          {devLinks.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}
        </ul>
      </div>
    </section>

    <section class="panel" role="tabpanel" id="panel-author" aria-labelledby="tab-author" tabindex="0" hidden>
      <div class="story">
        <p>
          Yep. As crazy as it sounds, I'm also an author! It all started with the Vraki Writing System, such a cornerstone
          of who I am, and of what became my "author" side, that I had to preserve its history.
        </p>
        <p>
          That grew into HusbandOutWorld, a light novel series that took me to conventions, where I met a lot of people,
          from artists to directors and publishers. It feels surreal how much this project pushed me to grow and challenge
          myself. If you're curious, you can see my evolution through the Light Novel Afterwords.
        </p>
        <p>
          And given how much world lore I created, and that I'm also a technical architect, I put the peanut butter and
          raspberry jelly together and created a West March D&amp;D campaign with Claude so people can party in my world.
          Found an issue or have an idea? Open an issue or send a PR on GitHub!
        </p>
        <ul class="pills">
          {authorLinks.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}
        </ul>
      </div>
    </section>

    <section class="panel" role="tabpanel" id="panel-pm" aria-labelledby="tab-pm" tabindex="0" hidden>
      <div class="story">
        <p>
          Project management isn't my job title, yet it shows up in almost every facet of my life: work, a light novel series, a
          D&amp;D campaign, a game, and this very site. I know JIRA deeply, and I run my personal projects with the same discipline
          I bring to client work. Given how much PM'ing I already do, getting a PM certification is officially on my backlog.
        </p>
        <p>
          Honestly, I think project management should be taught in high school. Breaking a big goal into small steps, being honest
          about scope and deadlines, and tracking what's actually done are life skills, not just job skills.
        </p>
      </div>
      <p class="ranking-lede pm-boards-lede">I run my own projects in the open. These are my public Kanban boards: what's next, what's in progress, and what shipped.</p>
      <ul class="boards">
        {
          boards.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.about}</p>
              <ul class="pills">
                <li><a href={b.board}>Kanban board</a></li>
                {b.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel" role="tabpanel" id="panel-mentor" aria-labelledby="tab-mentor" tabindex="0" hidden>
      <MentorFacet />
    </section>

    <section class="panel" role="tabpanel" id="panel-influencer" aria-labelledby="tab-influencer" tabindex="0" hidden>
      <div class="story">
      <p>
        I was very active back in the day, getting ~15 million views… Focus on <em>was</em>, for there’s nothing left of it.
        Only an empty YT, my Steam and MyAnimeList profiles, and my LinkedIn, which remains active.
      </p>
      <p>
        Will I ever come back? Likely not, because the ROI in knowledge and fun I was getting from being a social influencer
        towards the end of the journey was gone, and it had become hypervigilance and misery instead. I noticed I was being
        stalked too, so, like an infection, I cut it off at the root, healed, and moved on.
      </p>
      <ul class="pills">
        {influencerLinks.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}
      </ul>
      </div>
    </section>

    <section class="panel" role="tabpanel" id="panel-traveler" aria-labelledby="tab-traveler" tabindex="0" hidden>
      <TravelerFacet />
    </section>

    <section class="panel" role="tabpanel" id="panel-fishing" aria-labelledby="tab-fishing" tabindex="0" hidden>
      <GalleryGrid gallery={fishing} name="fishing" captions empty="Fishing photos are on their way." />
    </section>

    <section class="panel" role="tabpanel" id="panel-dnd" aria-labelledby="tab-dnd" tabindex="0" hidden>
      <Sections data={dnd} id="dnd" slots={1} empty="D&D adventures are on their way." photoAlt={(t) => `Party art for D&D ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-botw" aria-labelledby="tab-botw" tabindex="0" hidden>
      <div class="list-head">
        <div class="botw-intro">{botw.intro.map((para) => <p class="ranking-lede">{para}</p>)}</div>
        <a class="list-link" href="https://www.youtube.com/@RedLetterMedia">Red Letter Media on YouTube</a>
      </div>
      {
        botw.episodes.length === 0 ? (
          <p class="empty">My 39 favorite Best of the Worst episodes are on their way.</p>
        ) : (
          <ol class="botw">
            {botw.episodes.map((e) => (
              <li>
                <span class="botw__tape" aria-hidden="true">📼</span>
                <div>
                  <a href={e.url}><span class="sr-only">#{e.rank}: </span>{e.title}</a>
                  {e.description && <p>{e.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="panel" role="tabpanel" id="panel-camping" aria-labelledby="tab-camping" tabindex="0" hidden>
      <Sections data={camping} id="camping" layout="cards" slots={2} empty="Campsites are on their way." photoAlt={(t) => `Camping at ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-multilingual" aria-labelledby="tab-multilingual" tabindex="0" hidden>
      <MultilingualFacet />
    </section>

    <section class="panel" role="tabpanel" id="panel-tattoo" aria-labelledby="tab-tattoo" tabindex="0" hidden>
      <Sections data={tattoos} id="tattoo" photoAlt={(t) => `Tattoo on my ${t.toLowerCase()}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-gym" aria-labelledby="tab-gym" tabindex="0" hidden>
      <GymFacet />
    </section>

    <section class="panel" role="tabpanel" id="panel-miku" aria-labelledby="tab-miku" tabindex="0" hidden>
      <Sections data={mikuConcerts} id="miku" layout="cards" slots={2} titleAbove noDescription="Description coming soon." photoAlt={(t) => `Me at ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-churrasco" aria-labelledby="tab-churrasco" tabindex="0" hidden>
      <Sections data={churrasco} id="churrasco" layout="cards" slots={1} titleAbove noDescription="Description coming soon." empty="Churrasco stories are on their way." photoAlt={(t) => `Churrasco: ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-drummer" aria-labelledby="tab-drummer" tabindex="0" hidden>
      <div class="story">
        <p>This is a facet of my life that is on the backlog, as I am literally at max bandwidth having too much fun.</p>
      </div>
    </section>

    <section class="panel" role="tabpanel" id="panel-concert" aria-labelledby="tab-concert" tabindex="0" hidden>
      <Sections data={concerts} id="concert" layout="cards" sortAlpha avatarsDir="content/concerts/bands" photoAlt={(t) => `At ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-theater" aria-labelledby="tab-theater" tabindex="0" hidden>
      <Sections data={theater} id="theater" layout="cards" sortAlpha avatarsDir="content/theater/shows" photoAlt={(t) => `At ${t}`} />
    </section>

    <section class="panel" role="tabpanel" id="panel-gamer" aria-labelledby="tab-gamer" tabindex="0" hidden>
      <Ranking items={games} unit="hours">
        <div class="list-head">
          <p class="ranking-lede">
            My top 39 favorite games, ranked, with how many hours I've sunk into each. {nf.format(totalHours)} hours in total.
          </p>
          <a class="list-link" href={STEAM}>My profile on Steam</a>
        </div>
      </Ranking>
    </section>

    <section class="panel" role="tabpanel" id="panel-anime" aria-labelledby="tab-anime" tabindex="0" hidden>
      <Ranking items={anime}>
        <div class="list-head">
          <p class="ranking-lede">My top 39 favorite anime, ranked, and what each one means to me.</p>
          <a class="list-link" href={MAL}>My full list on MyAnimeList</a>
        </div>
      </Ranking>
    </section>

    <section class="panel" role="tabpanel" id="panel-potato" aria-labelledby="tab-potato" tabindex="0" hidden>
      <div class="switch" role="tablist" aria-label="TV shows or movies">
        <button type="button" role="tab" id="potato-tab-tv" aria-controls="potato-tv" aria-selected="true" data-potato="tv">📺 TV shows</button>
        <button type="button" role="tab" id="potato-tab-movies" aria-controls="potato-movies" aria-selected="false" tabindex="-1" data-potato="movies">🎬 Movies</button>
      </div>
      <div id="potato-tv" role="tabpanel" aria-labelledby="potato-tab-tv">
        <Ranking items={tvShows}>
          <p class="ranking-lede">My top 39 TV shows. Anime gets its own tab because of how much it means to me.</p>
        </Ranking>
      </div>
      <div id="potato-movies" role="tabpanel" aria-labelledby="potato-tab-movies" hidden>
        <Ranking items={movies}>
          <p class="ranking-lede">My top 39 movies.</p>
        </Ranking>
      </div>
    </section>

    <section class="panel" role="tabpanel" id="panel-cat" aria-labelledby="tab-cat" tabindex="0" hidden>
      <GalleryGrid gallery={peeta} name="cat" captions empty="Peeta's photos are on their way." />
    </section>

    <section class="panel" role="tabpanel" id="panel-sex" aria-labelledby="tab-sex" tabindex="0" hidden>
      <SexFacet />
    </section>
  </div>

  <noscript><style>.panel[hidden] { display: block; } .tabs, .pick { display: none; }</style></noscript>

  <dialog class="viewer" aria-label="Photo">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <div class="viewer__bar">
      <button type="button" class="viewer__prev" aria-label="Previous photo">‹</button>
      <button type="button" class="viewer__close">Close</button>
      <button type="button" class="viewer__next" aria-label="Next photo">›</button>
    </div>
  </dialog>
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    padding-block: 0.5rem 3rem;
  }
  .king { max-width: 46rem; }
  .king { margin: 0; }
  .king img {
    display: block;
    width: 100%;
    border-radius: 18px;
    box-shadow:
      0 0 0 1px rgba(57, 197, 187, 0.45),
      0 0 60px rgba(57, 197, 187, 0.28),
      0 30px 60px rgba(0, 0, 0, 0.5);
  }
  .king figcaption {
    margin-top: 0.75rem;
    color: var(--silver);
    font-size: var(--step--1);
  }
  .king abbr { text-decoration: underline dotted; cursor: help; }
  .king figcaption strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--teal);
  }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    margin: 0;
    color: var(--teal);
    text-shadow: 0 0 28px rgba(57, 197, 187, 0.45);
    margin-bottom: 0.25em;
  }

  .facets {
    border: 1px solid rgba(57, 197, 187, 0.25);
    border-radius: 22px;
    background: rgba(14, 22, 54, 0.6);
    backdrop-filter: blur(4px);
  }
  .facets__title {
    margin: 0;
    padding: 1.1rem 1.1rem 0;
    font-size: var(--step-1);
    color: var(--silver);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.85rem;
    border-bottom: 1px solid rgba(57, 197, 187, 0.2);
  }
  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--silver);
    background: rgba(7, 11, 31, 0.5);
    border: 1px solid rgba(190, 200, 209, 0.18);
    border-radius: 14px;
    padding: 0.6rem 1rem;
    cursor: pointer;
  }
  .tabs button:hover { color: var(--text); border-color: rgba(57, 197, 187, 0.5); }
  .tabs button[aria-selected='true'] {
    color: var(--night);
    background: var(--teal);
    border-color: var(--teal);
    box-shadow: 0 0 24px rgba(57, 197, 187, 0.4);
  }
  .tabs__icon { font-size: 1.1em; line-height: 1; }

  .panel { padding: clamp(1.25rem, 3vw, 2.25rem); }
  .pick { margin: 0; padding: clamp(1.25rem, 3vw, 2.25rem); color: var(--muted); }
  .pick[hidden] { display: none; }
  .panel:focus-visible { outline-offset: -4px; }
  .panel > :last-child { margin-bottom: 0; }

  .story { max-width: var(--measure); }
  .story .pills { margin-top: 1.5rem; }
  .dev-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--teal);
  }
  .pills { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.25rem 0 0; padding: 0; }
  .pills a {
    display: inline-block;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(57, 197, 187, 0.55);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .pills a:hover { background: rgba(57, 197, 187, 0.14); }

  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .list-head .ranking-lede { margin-bottom: 0; }
  .list-link {
    display: inline-block;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(57, 197, 187, 0.55);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }
  .list-link:hover { background: rgba(57, 197, 187, 0.14); }

  .empty { color: var(--muted); }
  .switch {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(57, 197, 187, 0.35);
    border-radius: 999px;
    background: rgba(7, 11, 31, 0.55);
  }
  .switch button {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--silver);
    background: transparent;
    border: 0;
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    cursor: pointer;
  }
  .switch button:hover { color: var(--text); }
  .switch button[aria-selected='true'] {
    color: var(--night);
    background: var(--teal);
    box-shadow: 0 0 18px rgba(57, 197, 187, 0.35);
  }
  .botw-intro { max-width: var(--measure); }
  .botw-intro .ranking-lede { margin-bottom: 0; }
  .botw { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; counter-reset: botw; }
  .botw li {
    counter-increment: botw;
    display: grid;
    grid-template-columns: 2.25rem 1.6rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.65rem 0.9rem;
    border: 1px solid rgba(190, 200, 209, 0.12);
    border-radius: 12px;
    background: rgba(7, 11, 31, 0.4);
  }
  .botw li::before {
    content: counter(botw);
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--teal);
    text-align: right;
  }
  .botw__tape { font-size: 1.2rem; }
  .botw a { font-weight: 700; }
  .botw p { margin: 0.2rem 0 0; color: var(--silver); }
  .pm-boards-lede { margin-top: 1.75rem; }
  .boards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .boards > li {
    padding: 1.1rem 1.2rem 1.25rem;
    border: 1px solid rgba(57, 197, 187, 0.25);
    border-radius: 16px;
    background: rgba(7, 11, 31, 0.45);
  }
  .boards h3 { font-size: var(--step-0); color: var(--teal); margin: 0 0 0.4rem; }
  .boards p { margin: 0; color: var(--silver); }
  .boards .pills { margin-top: 0.9rem; }
  .viewer {
    width: min(100% - 2rem, 56rem);
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 1rem;
    color: var(--text);
    background: var(--night-2);
    border: 1px solid rgba(57, 197, 187, 0.45);
    border-radius: 20px;
  }
  .viewer::backdrop { background: rgba(3, 5, 15, 0.85); }
  .viewer figure { margin: 0; text-align: center; }
  .viewer img { max-height: 70vh; width: auto; border-radius: 12px; }
  .viewer figcaption { margin-top: 0.6rem; color: var(--silver); }
  .viewer__bar { display: flex; justify-content: center; gap: 0.6rem; margin-top: 0.75rem; }
  .viewer__bar button {
    font: inherit;
    font-weight: 700;
    min-width: 2.75rem;
    padding: 0.35rem 1rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--teal);
    border-radius: 999px;
    cursor: pointer;
  }
  .viewer__bar button[hidden] { display: none; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; padding-bottom: 2rem; }
    .hero h1 { text-align: center; }
  }
  /* Large screens: center Howdy!, the photo and its caption, and keep the photo smaller. On mobile only Howdy! is centered. */
  @media (min-width: 821px) {
    .hero { justify-items: center; text-align: center; }
    .king { max-width: 34rem; }
  }
  @media (max-width: 560px) {
    .facets__title { padding: 0.9rem 0.8rem 0; }
    .tabs { gap: 0.4rem; padding: 0.6rem; }
    .tabs button { flex: 1 1 auto; max-width: calc(50% - 0.2rem); justify-content: center; padding: 0.5rem 0.65rem; font-size: 0.8rem; white-space: nowrap; gap: 0.35rem; }
  }
</style>

<script>
  // Tabs: click, arrow keys, and #dev / #author / ... links
  // Tabs hidden for this visitor (see "Per-source visibility" in global.css) are skipped entirely.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')).filter(
    (t) => getComputedStyle(t).display !== 'none',
  );

  function select(tab: HTMLButtonElement, focus = false, updateHash = true) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    document.getElementById('pick-hint')!.hidden = true;
    document.dispatchEvent(new CustomEvent('tabchange', { detail: tab.getAttribute('aria-controls') }));
    if (focus) tab.focus();
    if (updateHash) history.replaceState(null, '', `#${tab.dataset.tab}`);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select(tabs[(keys[e.key] + tabs.length) % tabs.length], true);
    });
  });

  // Potato tab: TV shows | Movies switch. #potato opens TV shows, #potato-movies opens Movies.
  const potatoButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-potato]'));
  function potato(which: string, updateHash = true) {
    for (const b of potatoButtons) {
      const on = b.dataset.potato === which;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (updateHash) history.replaceState(null, '', which === 'movies' ? '#potato-movies' : '#potato');
  }
  potatoButtons.forEach((b, i) => {
    b.addEventListener('click', () => potato(b.dataset.potato!));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      e.stopPropagation();
      const next = potatoButtons[(i + 1) % potatoButtons.length];
      potato(next.dataset.potato!);
      next.focus();
    });
  });

  // Old links: #weeb is now #anime; #tv and #movie (the old TV/Movie Potato tabs) open the Potato switch.
  const renamed: Record<string, string> = { '#weeb': '#anime', '#tv': '#potato', '#movie': '#potato-movies' };
  const hash = renamed[location.hash] ?? location.hash;
  const fromHash = tabs.find((t) => `#${t.dataset.tab}` === hash || (t.dataset.tab === 'potato' && hash === '#potato-movies'));
  if (fromHash) select(fromHash, false, false);
  if (hash === '#potato-movies') potato('movies', false);

  // Photo viewer for the galleries (Cat Dad, Fishing): ‹ › move within the clicked gallery.
  const viewer = document.querySelector<HTMLDialogElement>('.viewer')!;
  const img = viewer.querySelector('img')!;
  const caption = viewer.querySelector('figcaption')!;
  const allPhotos = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery]'));
  let photos: HTMLButtonElement[] = [];
  let index = 0;

  function show(i: number) {
    index = (i + photos.length) % photos.length;
    const b = photos[index];
    img.src = b.dataset.full!;
    img.alt = b.dataset.alt!;
    caption.textContent = b.dataset.alt!;
  }
  allPhotos.forEach((b) =>
    b.addEventListener('click', () => {
      photos = allPhotos.filter((p) => p.dataset.gallery === b.dataset.gallery);
      const many = photos.length > 1;
      viewer.querySelector<HTMLButtonElement>('.viewer__prev')!.hidden = !many;
      viewer.querySelector<HTMLButtonElement>('.viewer__next')!.hidden = !many;
      show(photos.indexOf(b));
      viewer.showModal();
    }),
  );
  viewer.querySelector('.viewer__prev')!.addEventListener('click', () => show(index - 1));
  viewer.querySelector('.viewer__next')!.addEventListener('click', () => show(index + 1));
  viewer.querySelector('.viewer__close')!.addEventListener('click', () => viewer.close());
  viewer.addEventListener('click', (e) => {
    if (e.target === viewer) viewer.close();
  });
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
