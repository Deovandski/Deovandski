---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GimmickPlay from '../components/GimmickPlay.astro';
import Ranking from '../components/Ranking.astro';
import TravelerFacet from '../components/TravelerFacet.astro';
import MentorFacet from '../components/MentorFacet.astro';
import MultilingualFacet from '../components/MultilingualFacet.astro';
import Sections from '../components/Sections.astro';
import MtgScore from '../components/MtgScore.astro';
import ChurrascoFacet from '../components/ChurrascoFacet.astro';
import LifeHacksFacet from '../components/LifeHacksFacet.astro';
import FamilyFacet from '../components/FamilyFacet.astro';
import GymFacet from '../components/GymFacet.astro';
import LustFacet from '../components/LustFacet.astro';
import DeathFacet from '../components/DeathFacet.astro';
import PetsFacet from '../components/PetsFacet.astro';
import PhotoGrid from '../components/reusable/PhotoGrid.astro';
import YouTube from '../components/YouTube.astro';
import { Content as AviationText } from '../../content/aviation.md';
import kingOfHues from '../assets/king-of-hues.jpg';
import stickyNotes from '../../content/pm/2023-03-20-sticky-note-madness.jpg';
import influencerShot from '../../content/influencer/Screenshot_20260803-210132.png';
// The screenshot links to a large webp copy (the photo viewer opens it), not the original PNG.
const influencerFull = (await getImage({ src: influencerShot, width: Math.min(1800, influencerShot.width), format: 'webp', quality: 85 })).src;
import { loadGallery } from '../lib/gallery';
import { photoDate } from '../lib/photoDate';
import { resolve } from 'node:path';
import { existsSync, readFileSync } from 'node:fs';
import { loadRankedList } from '../lib/ranking';
import { loadSections } from '../lib/sections';
import { loadBotw } from '../lib/botw';
import botwStats from '../../content/botw-stats.json';
import FacetMilestoneEggs from '../components/FacetMilestoneEggs.astro';

type LinkItem = { href: string; label: string };

const devLinks: LinkItem[] = [
  { href: 'https://www.wizarddeosolutions.com/', label: 'Wizard Deo Solutions' },
  { href: 'https://www.linkedin.com/in/deovandski/', label: 'LinkedIn' },
  { href: 'https://github.com/Deovandski', label: 'GitHub' },
  { href: 'https://deovandski.github.io/Deo-s-Framework16-LED-Matrix-Manager/', label: 'Framework 16 LED Matrix Manager' },
  { href: 'https://stackoverflow.com/users/4830578/deovandski', label: 'StackOverflow' },
  { href: 'https://stoneridgesoftware.com/author/deovandskis/', label: 'My Stoneridge Software posts' },
];

const musicianLinks: LinkItem[] = [{ href: 'https://suno.com/@deovandski', label: 'My Suno songs' }];

const authorLinks: LinkItem[] = [
  { href: 'https://www.husbandoutworld.com/', label: '#HusbandOutWorld Series' },
  { href: 'https://deovandski.github.io/Vraki-West-March-Campaign-D-D/', label: 'Vraki West March D&D Campaign' },
  { href: 'https://deovandski.github.io/vraki-windows/', label: 'Vraki Writing System' },
  { href: 'https://www.husbandoutworld.com/blog/', label: 'Blog' },
];

// PM tab: my public GitHub Projects boards (https://github.com/Deovandski?tab=projects).
const boards = [
  {
    title: "Deovandski's Blog",
    about: 'This site: every facet, fix and idea, from backlog to merged.',
    board: 'https://github.com/users/Deovandski/projects/2',
    links: [{ href: 'https://github.com/Deovandski/Deovandski', label: 'Repo' }],
  },
  {
    title: '#HusbandOutWorld Website',
    about: 'The light novel series site: the full novel, the World Lore, and Public and Behind The Scenes layers.',
    board: 'https://github.com/users/Deovandski/projects/4',
    links: [
      { href: 'https://www.husbandoutworld.com', label: 'Website' },
      { href: 'https://github.com/Deovandski/HusbandOutWorld', label: 'Repo' },
    ],
  },
  {
    title: 'Vraki West March Campaign D&D',
    about: 'A West Marches D&D 5e campaign set in the world of #HusbandOutWorld.',
    board: 'https://github.com/users/Deovandski/projects/5',
    links: [
      { href: 'https://deovandski.github.io/Vraki-West-March-Campaign-D-D/', label: 'Website' },
      { href: 'https://github.com/Deovandski/Vraki-West-March-Campaign-D-D', label: 'Repo' },
    ],
  },
  {
    title: 'Sinoi The Fisherman',
    about: 'A touch-first pixel-art fishing game in the world of Vraki. Free, no ads, open source.',
    board: 'https://github.com/users/Deovandski/projects/6',
    links: [
      { href: 'https://deovandski.github.io/Sinoi-the-fisherman/', label: 'Website' },
      { href: 'https://github.com/Deovandski/Sinoi-the-fisherman', label: 'Repo' },
    ],
  },
  {
    title: 'Deovandski Repo Template',
    about: 'The shared template for all my repos: AI disclosure, language support, website compilation, and more.',
    board: 'https://github.com/users/Deovandski/projects/8',
    links: [
      { href: 'https://deovandski.github.io/Deovandski-repo-template/', label: 'Website' },
      { href: 'https://github.com/Deovandski/Deovandski-repo-template', label: 'Repo' },
    ],
  },
];

const STEAM = 'https://steamcommunity.com/id/deovandski';
const MAL = 'https://myanimelist.net/profile/Deovandski';

const influencerLinks: LinkItem[] = [
  { href: 'https://www.youtube.com/channel/UCl57I3mRQhtGkesGWOA5Z-w', label: 'YouTube' },
  { href: STEAM, label: 'Steam' },
  { href: MAL, label: 'MyAnimeList' },
  { href: 'https://www.linkedin.com/in/deovandski', label: 'LinkedIn' },
];

// Every facet (a tab of content). Where each one sits in the tree is decided by `branches` below.
const facets = [
  { id: 'death', icon: '💀', label: 'Death' },
  { id: 'dev', icon: '💻', label: 'Dev' },
  { id: 'family', icon: '👨‍👩‍👦', label: 'Family' },
  { id: 'aviation', icon: '✈️', label: 'Aviation' },
  { id: 'author', icon: '✍️', label: 'Author' },
  { id: 'mentor', icon: '🔥', label: 'Mentor' },
  { id: 'pm', icon: '📋', label: 'PM/Life hacks' },
  { id: 'influencer', icon: '📣', label: 'Influencer' },
  { id: 'traveler', icon: '🗺️', label: 'Traveler' },
  { id: 'fishing', icon: '🎣', label: 'Fishing' },
  { id: 'dnd', icon: '🎲', label: 'D&D' },
  { id: 'boardgames', icon: '♟️', label: 'Board Games' },
  { id: 'mtg', icon: '🃏', label: 'MTG' },
  { id: 'camping', icon: '⛺', label: 'Camping' },
  { id: 'botw', icon: '📼', label: 'BOTW' },
  { id: 'multilingual', icon: '🗣️', label: 'Multilingual' },
  { id: 'tattoo', icon: '🖋️', label: 'Tattoo' },
  { id: 'gym', icon: '🏋️', label: 'Gym' },
  { id: 'miku', icon: '🎤', label: '初音ミク' },
  { id: 'churrasco', icon: '🥩', label: 'Churrasco' },
  { id: 'musician', icon: '🎶', label: 'Musician' },
  { id: 'painting', icon: '🖌️', label: 'Painting/Drawing' },
  { id: 'cooking', icon: '🍳', label: 'Cooking' },
  { id: 'concert', icon: '🤘', label: 'Concert' },
  { id: 'theater', icon: '🎭', label: 'Theater & Opera' },
  { id: 'gamer', icon: '🎮', label: 'Gamer' },
  { id: 'anime', icon: '🍥', label: 'Anime' },
  { id: 'potato', icon: '🥔', label: 'Potato' },
  { id: 'pets', icon: '🐾', label: 'Pets' },
  { id: 'lust', icon: '❤️‍🔥', label: 'Lust' },
];

// The facet tree: Deo → branch → facet (two levels, no sub-facets). Order here is the order visitors see.
// No facet opens by default: visitors grow a branch, then pick a facet.
const branches = [
  { id: 'philosophy', icon: '🧭', label: 'Philosophy', blurb: 'How Deo thinks: mortality, mentoring, discipline, desire and ink.', facets: ['death', 'mentor', 'gym', 'lust', 'tattoo'] },
  { id: 'craft', icon: '💼', label: 'Craft', blurb: 'What Deo builds, writes, plays and paints.', facets: ['dev', 'pm', 'author', 'influencer', 'painting', 'musician'] },
  { id: 'explorer', icon: '🌏', label: 'Explorer', blurb: 'Where Deo goes and the languages he speaks there.', facets: ['traveler', 'aviation', 'multilingual', 'camping', 'fishing'] },
  { id: 'frontrow', icon: '🎟️', label: 'Front Row', blurb: 'What Deo watches: live shows, the diva herself, anime, and the movies and TV worth (or not worth) the time.', facets: ['concert', 'theater', 'miku', 'anime', 'botw', 'potato'] },
  { id: 'play', icon: '🕹️', label: 'Play', blurb: 'Games at the table and on the screen, cards included.', facets: ['gamer', 'dnd', 'boardgames', 'mtg'] },
  { id: 'hearth', icon: '🏡', label: 'Hearth', blurb: 'Family, pets, the grill and the kitchen.', facets: ['family', 'pets', 'churrasco', 'cooking'] },
];

// Every facet must sit in exactly one branch, and a branch holds at most 6 (one row of the tree).
{
  const placed = branches.flatMap((b) => b.facets);
  const missing = facets.filter((f) => !placed.includes(f.id)).map((f) => f.id);
  const unknown = placed.filter((id) => !facets.some((f) => f.id === id));
  const twice = placed.filter((id, i) => placed.indexOf(id) !== i);
  const tooBig = branches.filter((b) => b.facets.length > 6).map((b) => b.id);
  if (missing.length || unknown.length || twice.length || tooBig.length) {
    throw new Error(`Facet tree: missing ${missing}, unknown ${unknown}, listed twice ${twice}, over 6 facets ${tooBig}`);
  }
}
const facetById = new Map(facets.map((f) => [f.id, f]));
const tree = branches.map((b) => ({ ...b, items: b.facets.map((id) => facetById.get(id)!) }));

const games = loadRankedList('content/gaming/top39.md', 'Hours');
const anime = loadRankedList('content/anime/top39.md');
const tvShows = loadRankedList('content/tv/top39.md');
const movies = loadRankedList('content/movies/top39.md');
const tattoos = loadSections('content/tattoos.md', 'content/tattoos');
const mikuConcerts = loadSections('content/miku.md', 'content/miku');
const concerts = loadSections('content/concerts.md', 'content/concerts');
const concertWishlist = loadSections('content/concerts-wishlist.md', 'content/concerts');
const theater = loadSections('content/theater.md', 'content/theater');
const theaterWishlist = loadSections('content/theater-wishlist.md', 'content/theater');
const fishing = loadGallery('content/fishing', 'Fishing');
// Painting/Drawing: each picture captioned with the date it was taken (photo metadata, else filename).
// Pictures with neither can get an approximate day in content/painting/_dates.md, shown as "Circa Q1 2013".
// Oldest first so it reads as a progression; undated ones go last, in filename order.
const circa = new Map(
  [...(existsSync('content/painting/_dates.md') ? readFileSync('content/painting/_dates.md', 'utf8') : '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .matchAll(/^- +(.+?): *(\d{4})-(\d{2})-(\d{2}) *$/gm)].map((m) => [m[1].trim(), `${m[2]}-${m[3]}-${m[4]}`]),
);
const quarterOf = (iso: string) => `Circa Q${Math.ceil(Number(iso.slice(5, 7)) / 3)} ${iso.slice(0, 4)}`;
const painting = (
  await Promise.all(
    loadGallery('content/painting', 'Painting or drawing').photos.map(async (p) => {
      const date = await photoDate(resolve('content/painting', p.file), p.file);
      const approx = date ? undefined : circa.get(p.file);
      return { src: p.src, file: p.file, alt: 'Painting or drawing', date, dateLabel: approx && quarterOf(approx), sortKey: date ?? approx ?? '9999' };
    }),
  )
).sort((a, b) => a.sortKey.localeCompare(b.sortKey) || a.file.localeCompare(b.file, undefined, { numeric: true }));
const camping = loadSections('content/camping.md', 'content/camping');
const dnd = loadSections('content/dnd.md', 'content/dnd');
const boardgames = loadSections('content/boardgames.md', 'content/boardgames');
const mtg = loadSections('content/mtg.md', 'content/mtg');
const cooking = loadSections('content/cooking.md', 'content/cooking');
const botw = loadBotw();
// Watch time behind the VHS pile, written by scripts/botw-from-history.mjs --stats.
const usDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const botwNumbers = {
  hours: new Intl.NumberFormat('en-US').format(Math.round(botwStats.hours)),
  views: new Intl.NumberFormat('en-US').format(botwStats.views),
  videos: botwStats.videos,
  from: usDate(botwStats.from),
  to: usDate(botwStats.to),
};
// BOTW intro lines may hold Markdown links: [text](https://...) or a facet link like [Churrasco](#churrasco).
const linkify = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\[([^\]]+)\]\(((?:https?:\/\/|#)[^)\s]+)\)/g, '<a href="$2">$1</a>');
const nf = new Intl.NumberFormat('en-US');
const totalHours = games.reduce((sum, g) => sum + (g.value ?? 0), 0);

---

<Base>
  <section class="hero" aria-labelledby="howdy">
    <h1 id="howdy" class="sr-only">Howdy! I'm Deo</h1>
    <figure class="king">
      <Image
        src={kingOfHues}
        alt="Deo in a gold imperial dragon robe and crown on a throne at the Imperial City in Huế, flanked by two attendants in blue áo dài"
        widths={[480, 760, 1120]}
        sizes="(max-width: 820px) 100vw, 544px"
        loading="eager"
      />
      <figcaption>
        <strong>King of Hues.</strong> Crowned in Huế, fluent in <abbr title="How Brazilians laugh online">huehuehue</abbr>.
        <em>I take life as seriously as I laugh at how absurd, finite and fickle it all is.</em>
      </figcaption>
    </figure>
  </section>

  <div class="facets">
    <h2 class="sr-only" id="facets-title">The facets that fulfill Deo</h2>
    <nav class="tree" aria-labelledby="facets-title">
      <div class="tree__root">
        <button type="button" class="tree__node tree__node--root" data-root aria-label="Deo: fold the tree back up">
          <span class="tree__disc" aria-hidden="true">D</span>
          <span class="tree__label">Deo</span>
        </button>
      </div>
      <div class="wire wire--root" aria-hidden="true">
        <span class="wire__drop"></span><span class="wire__bus"></span><span class="wire__hl"></span>
      </div>
      <div class="tree__grid">
        {
          tree.map((b) => (
            <Fragment>
              <div class="tree__branch" data-branch-cell={b.id}>
                <button
                  type="button"
                  class="tree__node tree__node--branch"
                  id={`branch-${b.id}`}
                  data-branch={b.id}
                  data-blurb={b.blurb}
                  aria-expanded="false"
                  aria-controls={`branch-group-${b.id}`}
                >
                  <span class="tree__disc" aria-hidden="true">{b.icon}</span>
                  <span class="tree__label">{b.label}</span>
                  <span class="tree__count" data-count>{b.items.length} facets</span>
                  <svg class="tree__chev" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                </button>
              </div>
              <div class="tree__group" id={`branch-group-${b.id}`} data-group={b.id} role="group" aria-labelledby={`branch-${b.id}`} hidden>
                <div class="wire" aria-hidden="true">
                  <span class="wire__drop"></span><span class="wire__bus"></span><span class="wire__hl"></span>
                </div>
                <div class="tree__row">
                  {b.items.map((t, i) => (
                    <div class="tree__leaf" style={`--i:${i}`}>
                      <button
                        type="button"
                        class="tree__node tree__node--facet"
                        id={`tab-${t.id}`}
                        data-tab={t.id}
                        data-icon={t.icon}
                        aria-controls={`panel-${t.id}`}
                        aria-pressed="false"
                      >
                        <span class="tree__disc" aria-hidden="true">{t.icon}</span>
                        <span class="tree__label">{t.label}</span>
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            </Fragment>
          ))
        }
      </div>
    </nav>

    <div class="facet-head" id="facet-head" hidden>
      <nav class="crumbs" aria-label="Breadcrumb"><ol></ol></nav>
      <div class="facet-head__row">
        <h3 class="facet-head__title" aria-live="polite"><span class="facet-head__icon" aria-hidden="true"></span> <span class="facet-head__label"></span></h3>
        <!-- ▶ Play: shown on tabs with a gimmick (src/lib/gimmicks.ts); opens it in a FastTab under the title (GimmickPlay.astro). -->
        <button type="button" class="facet-head__play" aria-expanded="false" hidden>
          <svg class="facet-head__play-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
          <svg class="facet-head__hide-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10.5l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="facet-head__play-label">Play</span>
        </button>
      </div>
      <p class="facet-head__blurb" hidden></p>
      <div class="facet-head__chips" hidden></div>
    </div>

    <p class="pick" id="pick-hint">Pick a branch above to grow the tree.</p>

    <section class="panel" role="region" id="panel-dev" aria-labelledby="tab-dev" tabindex="0" hidden>
      <div class="story">
        <p class="dev-headline">
          Senior Software Engineer, Dynamics 365 F&amp;O Architect, and Founder &amp; CEO of Wizard Deo Solutions.
        </p>
        <p>
          I specialize in enterprise architecture, integrations, cloud technologies, AI, and full stack development, with
          experience spanning ERP systems, modern web and mobile applications, and multiple industries. I got into the
          Dynamics 365 F&amp;O world through Stoneridge Software, where you can still glance at some of the X++ fun I had.
        </p>
        <p>
          As an extroverted engineer, I thrive at the intersection of technology and people, whether that's architecting
          solutions, mentoring developers, collaborating with stakeholders, or leading client discussions.
        </p>
        <p>
          GitHub only has a fraction of my code because of NDAs, but I'm proud of the LED Matrix Manager I cooked up for
          Framework 16 users. StackOverflow? Haven't used it in a long, long while. Times have changed, and it's fun and weird!
        </p>
        <ul class="pills">
          {devLinks.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}
        </ul>
      </div>
    </section>

    <section class="panel" role="region" id="panel-author" aria-labelledby="tab-author" tabindex="0" hidden>
      <div class="story">
        <p>
          Yep. As crazy as it sounds, I'm also an author! It all started with the Vraki Writing System, such a cornerstone
          of who I am, and of what became my "author" side, that I had to preserve its history.
        </p>
        <p>
          That grew into HusbandOutWorld, a light novel series that took me to conventions, where I met a lot of people,
          from artists to directors and publishers. It feels surreal how much this project pushed me to grow and challenge
          myself. If you're curious, you can see my evolution through the Light Novel Afterwords.
        </p>
        <p>
          And given how much world lore I created, and that I'm also a technical architect, I put the peanut butter and
          raspberry jelly together and created a West March D&amp;D campaign with Claude so people can party in my world.
          Found an issue or have an idea? Open an issue or send a PR on GitHub!
        </p>
        <ul class="pills">
          {authorLinks.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}
        </ul>
      </div>
    </section>

    <section class="panel" role="region" id="panel-pm" aria-labelledby="tab-pm" tabindex="0" hidden>
      <div class="switch" role="tablist" aria-label="PM or life hacks">
        <button type="button" role="tab" id="pm-tab-pm" aria-controls="pm-pm" aria-selected="true" data-switch-hash="#pm">📋 PM</button>
        <button type="button" role="tab" id="pm-tab-hacks" aria-controls="pm-hacks" aria-selected="false" tabindex="-1" data-switch-hash="#life-hacks">💡 Life hacks</button>
      </div>
      <div id="pm-pm" role="tabpanel" aria-labelledby="pm-tab-pm">
      <div class="story">
        <p>
          Project management isn't my job title, yet it shows up in almost every facet of my life: work, a light novel series, a
          D&amp;D campaign, a game, and this very site. I know JIRA deeply, and I run my personal projects with the same discipline
          I bring to client work. Given how much PM'ing I already do, getting a PM certification is officially on my backlog.
        </p>
        <p>
          Honestly, I think project management should be taught in high school. Breaking a big goal into small steps, being honest
          about scope and deadlines, and tracking what's actually done are life skills, not just job skills.
        </p>
        <h3 class="pm-subhead">How I track my own life</h3>
        <p>
          At home, a whiteboard holds my major goals and anything that isn't tied to a date. If it is tied to a date, it goes on
          the calendar; how I keep 5+ calendars in one place is <a href="#life-hacks">Life hack #2: Calendar bound</a>.
        </p>
        <p>
          I also use sticky notes, but I'm actively trying to get away from them. My rule now: it goes on the calendar, on the
          whiteboard, or on a board (GitHub Projects for open source, JIRA for work). Those keep the history of past and current
          work, so I can see burndown and trends, and spot where I'm losing efficiency.
        </p>
        <figure class="pm-photo">
          <Image
            src={stickyNotes}
            alt="Deo grinning and waving at his desk, with his monitors, keyboard and desk covered in dozens of green sticky notes"
            widths={[480, 760, 1120]}
            sizes="(max-width: 720px) 100vw, 560px"
          />
          <figcaption>Sticky note madness, March 2023.</figcaption>
        </figure>
        <p>
          Because if I'm spending too much time on something, is it worth doing? And what can I do about it? That kind of data
          helps me improve my workflows, my tools and my skill set. Being efficient with my time gives me more time for everything
          else in life, including rest.
        </p>
      </div>
      <p class="ranking-lede pm-boards-lede">I run my own projects in the open. These are my public Kanban boards: what's next, what's in progress, and what shipped.</p>
      <ul class="boards">
        {
          boards.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.about}</p>
              <ul class="pills">
                <li><a href={b.board}>Kanban board</a></li>
                {b.links.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
              </ul>
            </li>
          ))
        }
      </ul>
      </div>
      <div id="pm-hacks" role="tabpanel" aria-labelledby="pm-tab-hacks" hidden>
        <LifeHacksFacet />
      </div>
    </section>

    <section class="panel" role="region" id="panel-death" aria-labelledby="tab-death" tabindex="0" hidden>
      <DeathFacet />
    </section>

    <section class="panel" role="region" id="panel-family" aria-labelledby="tab-family" tabindex="0" hidden>
      <div class="story">
        <FamilyFacet />
      </div>
    </section>

    <section class="panel" role="region" id="panel-aviation" aria-labelledby="tab-aviation" tabindex="0" hidden>
