  /* A line that sends the visitor to a related tab (#302). */
  .cross-link { margin-top: 1rem; }
  /* Pill switches (PillSwitch, like the Biomarker Lab's views): the site's display font. */
  .panel {
    --switch-font: var(--font-display);
    --switch-size: var(--step-0);
    /* YouTube embeds (reusable YouTube) in the site's colours. */
    --yt-font: var(--font-display);
