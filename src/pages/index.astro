        <Ranking items={tvShows}>
          <p class="ranking-lede">My top 39 TV shows. Anime gets its own tab because of how much it means to me.</p>
        </Ranking>
      </div>
      <div id="potato-movies" role="region" aria-labelledby="sub-potato-movies" data-sub-panel hidden>
        <Ranking items={movies}>
          <p class="ranking-lede">My top 39 movies.</p>
        </Ranking>
      </div>
    </section>

    <section class="panel" role="region" id="panel-pets" aria-labelledby="tab-pets" tabindex="0" hidden>
      <GimmickPlay tab="pets" />
      <PetsFacet />
    </section>

    <section class="panel" role="region" id="panel-lust" aria-labelledby="tab-lust" tabindex="0" hidden>
      <GimmickPlay tab="lust" />
      <LinksMenu id="lust-links" toggle="external" items={[{ links: lustLinks }]} />
      <LustFacet />
    </section>
  </div>

  <noscript><style>.panel[hidden] { display: block; } .tree, .facet-head, .pick { display: none; }</style></noscript>

  <FacetMilestoneEggs />
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.5rem 3rem;
  }
  .king { max-width: 46rem; }
  .king { margin: 0; }
  .king img {
    display: block;
    width: 100%;
    border-radius: 18px;
    box-shadow:
      0 0 0 1px rgba(57, 197, 187, 0.45),
      0 0 60px rgba(57, 197, 187, 0.28),
      0 30px 60px rgba(0, 0, 0, 0.5);
  }
  .king figcaption {
    margin-top: 0.75rem;
    color: var(--silver);
    font-size: var(--step--1);
  }
  .king abbr { text-decoration: underline dotted; cursor: help; }
  .king figcaption strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-0);
    color: var(--teal);
  }

  .facets {
    border: 1px solid rgba(57, 197, 187, 0.25);
    border-radius: 22px;
    background: rgba(14, 22, 54, 0.6);
    backdrop-filter: blur(4px);
  }


  /* Facet tree. Desktop: Deo on top, branches fan out in a row, the open branch grows a row of facets below it,
     joined by "wires" the script positions (12-column grid, every node spans 2 columns, rows centered).
     Phone (≤ 640px): the same markup becomes a vertical accordion. */
  .tree { scroll-margin-top: 6rem; padding: 1.25rem 1rem 1.5rem; --wire: rgba(154, 168, 187, 0.35); }
  .tree__root { display: flex; justify-content: center; }
  .tree__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 44px;
    padding: 4px;
    background: none;
    border: 0;
    border-radius: 14px;
    color: var(--silver);
    font: inherit;
    cursor: pointer;
  }
  .tree__node:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  .tree__disc {
    width: 64px;
    height: 64px;
    box-sizing: border-box;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    background: var(--night-2);
    border: 2px solid var(--night-3);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .tree__node:hover .tree__disc { border-color: rgba(57, 197, 187, 0.6); }
  .tree__node--root .tree__disc {
    width: 72px;
    height: 72px;
    border-color: var(--teal);
    color: var(--teal);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.9rem;
  }
  .tree__node--facet .tree__disc { width: 56px; height: 56px; font-size: 1.5rem; }
  .tree__label { font-family: var(--font-display); font-weight: 800; font-size: var(--step-0); line-height: 1.25; text-align: center; }
  .tree__node--facet .tree__label { font-size: var(--step--1); }
  .tree__count { color: var(--muted); font-size: var(--step--1); }
  .tree__node--facet .tree__count { font-size: 0.75rem; margin-top: -0.25rem; }
  /* Sub-tabs (the third level, #296): smaller nodes under their facet. */
  .tree__node--sub .tree__disc { width: 44px; height: 44px; font-size: 1.2rem; }
  .tree__node--sub .tree__label { font-size: var(--step--1); font-weight: 700; }
  .tree__chev { display: none; }
  .tree__node[aria-expanded='true'], .tree__node[aria-pressed='true'] { color: var(--text); }
  .tree__node[aria-expanded='true'] .tree__disc { border-color: var(--teal); background-color: rgba(57, 197, 187, 0.14); }
  .tree__node[aria-pressed='true'] .tree__disc {
    border-color: var(--pink);
    background-color: rgba(225, 40, 133, 0.18);
    box-shadow: 0 0 20px rgba(225, 40, 133, 0.35);
  }

  .wire { position: relative; height: 40px; }
  .wire span { position: absolute; display: block; }
  .wire__drop { top: 0; width: 2px; height: 20px; background: var(--teal); transform-origin: 50% 0; animation: grow-y 0.2s ease-out both; }
  .wire--root .wire__drop { background: var(--wire); }
  .tree.is-open .wire--root .wire__drop { background: var(--teal); }
  .wire__bus { top: 19px; height: 2px; background: var(--wire); animation: grow-x 0.3s 0.18s ease-out both; }
  .wire__hl { top: 19px; height: 2px; background: var(--teal); animation: grow-x 0.3s 0.18s ease-out both; transition: left 0.25s ease, width 0.25s ease; }
  .wire :global(.wire__tick) { position: absolute; display: block; top: 20px; width: 2px; height: 20px; background: var(--wire); transform-origin: 50% 0; animation: grow-y 0.2s 0.42s ease-out both; transition: background-color 0.2s; }
  .wire :global(.wire__tick.is-on) { background: var(--teal); }

  .tree__grid, .tree__row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .tree__branch { grid-row: 1; display: flex; justify-content: center; padding: 0 4px; }
  .tree__group { grid-row: 2; grid-column: 1 / -1; margin-top: 0.5rem; }
  .tree__group[hidden] { display: none; }
  .tree__leaf { display: flex; justify-content: center; padding: 0 4px; animation: pop-in 0.32s calc(var(--i) * 60ms + 0.45s) ease-out both; }
  .tree__row > .tree__leaf { grid-row: 1; }
  .tree__subgroup { grid-row: 2; grid-column: 1 / -1; margin-top: 0.5rem; }
  .tree__subgroup[hidden] { display: none; }

  @keyframes grow-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes pop-in { from { opacity: 0; transform: translateY(-10px) scale(0.92); } to { opacity: 1; transform: none; } }

  .facet-head { scroll-margin-top: 6rem; padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem) 0; border-top: 1px solid rgba(57, 197, 187, 0.2); }
  .facet-head[hidden], .facet-head [hidden] { display: none; }
  #panel-death, #panel-mentor, #panel-cycling {
    --sources-title: var(--silver);
    --sources-title-font: var(--font-display);
    --sources-text: var(--muted);
    --sources-name: var(--text);
    --sources-accent: var(--teal);
  }
  .crumbs {
    flex: 1 1 0;
    min-width: 0;
    --breadcrumb-size: var(--step-1);
    --breadcrumb-color: var(--muted);
    --breadcrumb-current: var(--text);
    --breadcrumb-current-font: var(--font-display);
    --breadcrumb-accent: var(--teal);
  }
  .facet-head__row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; }
  .facet-head__play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.1rem;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: 999px;
    border: 2px solid var(--teal);
    background: transparent;
    color: var(--teal);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .facet-head__actions { display: flex; flex-wrap: wrap; gap: 0.6rem 1.1rem; margin-inline-start: auto; }
  .facet-head__play:hover:not(:disabled) { background: rgba(57, 197, 187, 0.14); }
  .facet-head__play:disabled { opacity: 0.4; cursor: not-allowed; }
  .facet-head__play:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .facet-head__play[aria-expanded='true'] { background: var(--teal); color: var(--bg, #070b1f); }
  .facet-head__play .facet-head__hide-icon, .facet-head__play[aria-expanded='true'] .facet-head__play-icon { display: none; }
  .facet-head__play[aria-expanded='true'] .facet-head__hide-icon { display: inline; }
  /* Phones: Play and Links in a row under the breadcrumb, each centred in half the header's width (#262). */
  @media (max-width: 640px) {
    .facet-head__actions { flex: 1 0 100%; display: grid; grid-template-columns: 1fr 1fr; justify-items: center; gap: 0.6rem; }
    .facet-head__actions[hidden] { display: none; }
  }
  .facet-head__links-chevron { transition: transform 0.2s; }
  .facet-head__links[aria-expanded='true'] .facet-head__links-chevron { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .facet-head__links-chevron { transition: none; } }
  .facet-head__blurb { margin: 0.5rem 0 0; color: var(--muted); max-width: var(--measure); }
  .facet-head__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; padding-bottom: clamp(1.25rem, 3vw, 2.25rem); }
  .facet-head__chips :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgba(57, 197, 187, 0.55);
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .facet-head__chips :global(button:hover) { background: rgba(57, 197, 187, 0.14); }
  .facet-head__chips :global(button:focus-visible) { outline: 2px solid var(--teal); outline-offset: 2px; }

  .panel { padding: clamp(1.25rem, 3vw, 2.25rem); }
  .pick { margin: 0; max-width: none; padding: clamp(1.25rem, 3vw, 2.25rem); color: var(--muted); border-top: 1px solid rgba(57, 197, 187, 0.2); }
