        <Sections data={theaterWishlist} id="theater-wish" layout="cards" sortAlpha avatarsDir="content/theater/shows" empty="The wishlist is on its way." photoAlt={(t) => `At ${t}`} />
      </div>
    </section>

    <section class="panel" role="region" id="panel-gamer" aria-labelledby="tab-gamer" tabindex="0" hidden>
      <GimmickPlay tab="gamer">
        <p slot="intro">You are the obstacles. The dino runs. You throw things at it. Mana builds every second from now; time your throws (catch it while it&apos;s still in the air) and take it down before you run dry.</p>
      </GimmickPlay>
      <LinksMenu
        id="gamer-links"
        toggle="external"
        items={[
          {
            links: [
              { href: STEAM, label: 'My profile on Steam' },
              { href: XBOX, label: 'My profile on Xbox' },
            ],
          },
          { separator: 'Third party trackers' },
          {
            style: 'secondary',
            links: [
              { href: 'https://www.truetrophies.com/gamer/Deovandski', label: 'TrueTrophies' },
              { href: 'https://truesteamachievements.com/gamer/Deovandski', label: 'TrueSteamAchievements' },
              { href: 'https://www.trueachievements.com/gamer/deovandski', label: 'TrueAchievements' },
            ],
          },
        ]}
      />
      <div class="list-head gamer-head">
        <div class="gamer-intro">
          {gamer.intro.map((para) => <p class="ranking-lede">{para}</p>)}
          <!-- Gamer ↔ Developer › Games (#302). -->
          <p class="ranking-lede cross-link">I make games too, now and then: see what I've cooked so far on <a href="#dev-games">Developer › Games</a>.</p>
        </div>
      </div>
      <HoursByCategory
        id="gamer"
        categories={gamer.categories}
        total={gamer.totalHours}
        totalLabel="hours played"
        stats={[
          { value: gamer.played, label: 'games played' },
          { value: gamer.owned, label: 'games owned on Steam' },
          { value: gamer.categories.length, label: 'categories' },
        ]}
        excludeLabel="Count idle games ({value} h left running)"
        shareLabel="{share} of my hours"
        excludedShareLabel="not counted in my hours"
        countLabel="{n} games"
        countLabelOne="1 game"
        chipColors={CHIP_COLORS}
        excludedByDefault
        defaultView="sphere"
        views={[
          { id: 'pie', label: 'Pie' },
          { id: 'sphere', label: 'Sphere' },
          { id: 'orbits', label: 'Orbits' },
          { id: 'days', label: 'Days of my life' },
          { id: 'shelf', label: 'Cartridge shelf' },
        ]}
      >
        <HoursPie
          slot="pie"
          id="gamer-pie"
          categories={gamerViews}
          excluded
          label="Pie chart of my hours by category: {list}"
          hint="Press a slice or a row to see its games."
          shareLabel="{share} of my hours"
          countLabel="{n} games"
          countLabelOne="1 game"
          moreLabel="+ {n} more games"
          chipColors={CHIP_COLORS}
        />
        <ExplodedSphere
          slot="sphere"
          id="gamer-sphere"
          categories={gamerViews}
          excluded
          hint="Each chunk is a category, as big as its hours. Drag to turn it; press a chunk to open it."
          openHint="Each layer is a game; its volume is its hours. Drag to turn it."
          moreLabel="+ {n} more games"
          countLabel="{n} games"
          countLabelOne="1 game"
          label="An exploded sphere of my hours by category: {list}"
        />
        <HoursOrbits
          slot="orbits"
          id="gamer-orbits"
          categories={gamerViews}
          excluded
          hint="Each planet is a category, sized by its hours. Press one to fly in."
          openHint="Each moon is a game, sized by its hours."
          countLabel="{n} games"
          countLabelOne="1 game"
          label="My hours by category as planets around a sun: {list}"
        />
        <DaysGrid
          slot="days"
          id="gamer-days"
          categories={gamerViews}
          excluded
          subline="The games on the list add up to {days} days of nonstop play, 24 hours a day. Each square is one of those days."
          hint="Hover a square to see which game that day went to. Press a category to light up only its days."
          label="{span} of play, one square per day, coloured by category"
        />
        <CartridgeShelf
          slot="shelf"
          id="gamer-shelf"
          categories={gamerViews}
          excluded
          hint="Every cartridge is a game, as wide as its hours. Hover one to pull it out; press it to keep it out. Dashed ones are estimated."
          countLabel="{n} games"
          countLabelOne="1 game"
          label="My games as cartridges on shelves, one shelf per category, each as wide as its hours"
          chipColors={CHIP_COLORS}
        />
      </HoursByCategory>
      <p class="gamer-foot">Hours from my Steam library, my Xbox profile and my own estimates. Games with under 10 hours are left out.</p>
      <p class="gamer-foot gamer-foot--more">* Estimated hours, from way before playtime tracking and achievements were widely available.</p>
    </section>

    <section class="panel" role="region" id="panel-anime" aria-labelledby="tab-anime" tabindex="0" hidden>
      <LinksMenu id="anime-links" toggle="external" items={[{ links: [{ href: MAL, label: 'My full list on MyAnimeList' }] }]} />
