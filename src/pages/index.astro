const botwNumbers = {
  hours: new Intl.NumberFormat('en-US').format(Math.round(botwStats.hours)),
  views: new Intl.NumberFormat('en-US').format(botwStats.views),
  videos: botwStats.videos,
  from: usDate(botwStats.from),
  to: usDate(botwStats.to),
};
// BOTW intro lines may hold Markdown links: [text](https://...) or a facet link like [Churrasco](#churrasco).
const linkify = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\[([^\]]+)\]\(((?:https?:\/\/|#)[^)\s]+)\)/g, '<a href="$2">$1</a>');
const nf = new Intl.NumberFormat('en-US');

