        <div class="crumbs"><Breadcrumb /></div>
        <!-- Kept for screen readers and the page outline only: on screen it would repeat the breadcrumb's last item (#264). -->
        <h3 class="facet-head__title sr-only" aria-live="polite"><span class="facet-head__icon" aria-hidden="true"></span> <span class="facet-head__label"></span></h3>
        <!-- ▶ Play and Links show on every tab (#262), disabled when the tab has nothing for them. On desktop they sit at the
             right end of the breadcrumb's row; on phones, in a row under it, half the width each. -->
        <div class="facet-head__actions" hidden>
        <!-- ▶ Play: opens the tab's gimmick (src/lib/gimmicks.ts) in a FastTab under the title (GimmickPlay.astro). -->
