  .botw-note { margin: 0 0 0.75rem; color: var(--muted); font-size: var(--step--1); }
  .botw-pile { margin: 0.5rem 0 1.75rem; --vhs-pile-accent: var(--teal); --vhs-pile-muted: var(--muted); }
  .botw-pile :global(.botw-pile__fine) { color: var(--muted); font-size: var(--step--1); }
  .botw .botw__count {
    margin: 0;
    font-family: var(--font-display);
