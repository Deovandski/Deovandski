  }
  .botw .botw__count span { color: var(--muted); font-weight: 600; font-size: var(--step--1); }
  @media (max-width: 560px) {
    /* Phones: the count moves under the title so long titles keep their width. */
    .botw li.botw--counted { grid-template-columns: 2.25rem 1.6rem minmax(0, 1fr); }
    .botw .botw__count { grid-column: 3; text-align: left; margin-top: 0.15rem; }
  }
  .botw__tape { font-size: 1.2rem; }
  .botw a { font-weight: 700; }
  .botw p { margin: 0.2rem 0 0; color: var(--silver); }
  .pm-boards-lede { margin-top: 1.75rem; }
  .pm-subhead { font-size: var(--step-1); color: var(--teal); margin: 2rem 0 0.75rem; }
  .pm-photo { margin: 1.5rem 0; max-width: 560px; }
  .pm-photo img { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid rgba(190, 200, 209, 0.15); }
  .pm-photo figcaption { margin-top: 0.5rem; text-align: center; color: var(--muted); font-size: var(--step--1); }
  .influencer-links { margin: 0 0 1.25rem; }
  .influencer-q { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); line-height: 1.3; color: var(--teal); margin-top: 1.75rem; }
  .influencer-shot { margin: 1rem auto 1.5rem; max-width: 320px; }
  .influencer-shot img { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid rgba(190, 200, 209, 0.15); }
  .influencer-shot figcaption { margin-top: 0.5rem; text-align: center; color: var(--muted); font-size: var(--step--1); }
  .boards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .boards > li {
    padding: 1.1rem 1.2rem 1.25rem;
    border: 1px solid rgba(57, 197, 187, 0.25);
    border-radius: 16px;
    background: rgba(7, 11, 31, 0.45);
  }
  .boards h3 { font-size: var(--step-0); color: var(--teal); margin: 0 0 0.4rem; }
  .boards p { margin: 0; color: var(--silver); }
  .boards .pills { margin-top: 0.9rem; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; padding-bottom: 2rem; }
  }
  /* Large screens: center the photo and its caption, and keep the photo smaller. */
  @media (min-width: 821px) {
    .hero { justify-items: center; text-align: center; }
    .king { max-width: 34rem; }
  }
  @media (max-width: 560px) {
  }
  @media (max-width: 640px) {
    .tree { padding: 0.9rem 0.75rem 1rem; }
    .tree__root, .wire { display: none; }
    .tree__grid { display: flex; flex-direction: column; gap: 0.5rem; }
    .tree__branch { padding: 0; }
    .tree__node--branch, .tree__node--facet {
      flex-direction: row;
      width: 100%;
      gap: 0.7rem;
      padding: 0 0.9rem;
      background: rgba(7, 11, 31, 0.5);
      border: 1px solid rgba(190, 200, 209, 0.18);
      transition: background-color 0.2s, border-color 0.2s;
    }
    .tree__node--branch { min-height: 56px; }
    .tree__node--facet { min-height: 44px; border-radius: 12px; }
    .tree__node .tree__disc,
    .tree__node--facet .tree__disc { width: 1.75rem; height: auto; border: 0; background: none !important; box-shadow: none !important; font-size: 1.35rem; }
    .tree__node--facet .tree__disc { font-size: 1.15rem; }
    .tree__label { flex: 1 1 auto; text-align: left; }
    .tree__node--facet .tree__label { font-size: var(--step-0); font-family: var(--font-body); font-weight: 400; }
    .tree__chev { display: block; flex: 0 0 18px; color: var(--muted); transition: transform 0.2s; }
    .tree__node[aria-expanded='true'] { border-color: var(--teal); background: rgba(57, 197, 187, 0.12); }
    .tree__node[aria-expanded='true'] .tree__chev { transform: rotate(180deg); }
    .tree__node[aria-pressed='true'] { border-color: var(--pink); background: rgba(225, 40, 133, 0.18); }
    .tree__group { margin: 0 0 0.25rem 1.6rem; padding: 0.35rem 0; border-left: 2px solid var(--teal); transform-origin: 50% 0; animation: grow-y 0.22s ease-out both; }
    .tree__row { display: flex; flex-direction: column; gap: 0.3rem; }
    .tree__leaf { position: relative; padding: 0 0 0 14px; animation-delay: calc(var(--i) * 50ms + 0.1s); }
    .tree__leaf::before { content: ''; position: absolute; left: 0; top: 50%; width: 14px; height: 2px; background: var(--wire); }
    .tree__leaf:has([aria-pressed='true'])::before { background: var(--pink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tree *, .tree__group { animation: none !important; transition: none !important; }
  }
</style>

<script>
  // Facet tree: Deo → branch → facet. Growing a branch shows its facets; opening a facet shows its panel below.
  // Facets hidden for this visitor (see "Per-source visibility" in global.css) drop out of the tree entirely,
  // and the rows re-center around what's left.
  type Wire = { el: HTMLElement; hl: HTMLElement; ticks: HTMLElement[]; p: number; cs: number[] };
  type Branch = { id: string; button: HTMLButtonElement; cell: HTMLElement; group: HTMLElement; facets: HTMLButtonElement[]; wire: Wire };

  const treeEl = document.querySelector<HTMLElement>('.tree')!;
  const rootButton = treeEl.querySelector<HTMLButtonElement>('[data-root]')!;
  const head = document.getElementById('facet-head')!;
  const hint = document.getElementById('pick-hint')!;
  const crumbList = head.querySelector('.crumbs ol')!;
  const headIcon = head.querySelector('.facet-head__icon')!;
  const headLabel = head.querySelector('.facet-head__label')!;
  const headBlurb = head.querySelector<HTMLElement>('.facet-head__blurb')!;
  const headChips = head.querySelector<HTMLElement>('.facet-head__chips')!;
  const playButton = head.querySelector<HTMLButtonElement>('.facet-head__play')!;
  const playLabel = playButton.querySelector('.facet-head__play-label')!;
  const phone = window.matchMedia('(max-width: 640px)');
  const panelOf = (f: HTMLButtonElement) => document.getElementById(f.getAttribute('aria-controls')!)!;
  const labelOf = (b: HTMLButtonElement) => b.querySelector('.tree__label')!.textContent!.trim();
  const iconOf = (b: HTMLButtonElement) => b.querySelector('.tree__disc')!.textContent!.trim();

  // Each row sits on a 12-column grid, every node spanning 2 columns, centered: a row of K starts at column 6 − K + 1.
  // Node centers are then plain percentages of the row width, which is what the wires are drawn with.
  const rowLayout = (k: number) =>
    Array.from({ length: k }, (_, j) => {
      const col = 6 - k + 2 * j + 1;
      return { col, center: (col / 12) * 100 };
    });

  function wireUp(el: HTMLElement, p: number, cs: number[]): Wire {
    const [drop, bus, hl] = ['wire__drop', 'wire__bus', 'wire__hl'].map((c) => el.querySelector<HTMLElement>(`.${c}`)!);
    const left = Math.min(p, ...cs);
    const right = Math.max(p, ...cs);
    drop.style.left = `calc(${p}% - 1px)`;
    bus.style.left = `${left}%`;
    bus.style.width = `${right - left}%`;
    bus.style.transformOrigin = `${right > left ? ((p - left) / (right - left)) * 100 : 50}% 50%`; // grows out of the parent
    el.querySelectorAll('.wire__tick').forEach((t) => t.remove());
    const ticks = cs.map((c) => {
      const t = document.createElement('span');
      t.className = 'wire__tick';
      t.style.left = `calc(${c}% - 1px)`;
      el.append(t);
      return t;
    });
    const wire = { el, hl, ticks, p, cs };
    light(wire, -1);
    return wire;
  }

  // Lights the path from the parent to child i (or nothing for -1).
  function light(w: Wire, i: number) {
    w.ticks.forEach((t, j) => t.classList.toggle('is-on', j === i));
    if (i < 0) {
      w.hl.style.display = 'none';
      return;
    }
    const c = w.cs[i];
    w.hl.style.display = '';
    w.hl.style.left = `${Math.min(w.p, c)}%`;
    w.hl.style.width = `${Math.abs(c - w.p)}%`;
    w.hl.style.transformOrigin = c >= w.p ? '0% 50%' : '100% 50%';
  }

  const branches: Branch[] = [];
  for (const button of treeEl.querySelectorAll<HTMLButtonElement>('[data-branch]')) {
    const cell = button.closest<HTMLElement>('.tree__branch')!;
    const group = document.getElementById(button.getAttribute('aria-controls')!)!;
    const facets: HTMLButtonElement[] = [];
    for (const f of group.querySelectorAll<HTMLButtonElement>('[data-tab]')) {
      if (getComputedStyle(f).display === 'none') f.closest('.tree__leaf')!.remove();
      else facets.push(f);
    }
    if (!facets.length) {
      cell.remove();
      group.remove();
      continue;
    }
    button.querySelector('[data-count]')!.textContent = `${facets.length} ${facets.length === 1 ? 'facet' : 'facets'}`;
    branches.push({ id: button.dataset.branch!, button, cell, group, facets, wire: null! });
  }
  const branchLayout = rowLayout(branches.length);
  branches.forEach((b, i) => {
    b.cell.style.gridColumn = `${branchLayout[i].col} / span 2`;
    const facetLayout = rowLayout(b.facets.length);
    b.facets.forEach((f, j) => (f.closest<HTMLElement>('.tree__leaf')!.style.gridColumn = `${facetLayout[j].col} / span 2`));
    b.wire = wireUp(b.group.querySelector<HTMLElement>('.wire')!, branchLayout[i].center, facetLayout.map((x) => x.center));
  });
  const rootWire = wireUp(treeEl.querySelector<HTMLElement>('.wire--root')!, 50, branchLayout.map((x) => x.center));
  const allFacets = branches.flatMap((b) => b.facets);
  const branchOf = (f: HTMLButtonElement) => branches.find((b) => b.facets.includes(f))!;

  let openBranch: Branch | null = null;
  let openFacet: HTMLButtonElement | null = null;

  function setBranch(b: Branch | null) {
    for (const x of branches) {
      x.button.setAttribute('aria-expanded', String(x === b));
      x.group.hidden = x !== b; // un-hiding replays the wire and pop-in animations
    }
    treeEl.classList.toggle('is-open', !!b);
    light(rootWire, b ? branches.indexOf(b) : -1);
    openBranch = b;
  }

  function setFacet(f: HTMLButtonElement | null) {
    // Gimmicks start closed on every visit to a tab.
    if (f !== openFacet) document.dispatchEvent(new CustomEvent('gimmick:close', { detail: {} }));
    for (const x of allFacets) {
      x.setAttribute('aria-pressed', String(x === f));
      panelOf(x).hidden = x !== f;
    }
    if (openBranch) light(openBranch.wire, f ? openBranch.facets.indexOf(f) : -1);
    openFacet = f;
  }

  // Phone back button (#208): while a tab is open there is exactly one history entry for it, on top of
  // the tree's. Back from a tab returns to the tree (its branch still open); back again leaves the site,
  // which closes the installed app. Switching tabs replaces the entry, so it never stacks up.
  const FACET_ENTRY = 'deoFacet';
  const onFacetEntry = () => history.state?.[FACET_ENTRY] === true;
  let skipPop = false; // set when we go back ourselves, after already showing the tree
  function rememberFacet(hash: string) {
    if (onFacetEntry()) {
      history.replaceState({ [FACET_ENTRY]: true }, '', hash);
      return;
    }
    // A tab opened straight from a link has no tree entry under it: turn that entry into the tree first.
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    history.pushState({ [FACET_ENTRY]: true }, '', hash);
  }
  const clearHash = () => {
    if (onFacetEntry()) {
      skipPop = true;
      history.back(); // drop the tab's entry, so the next back leaves the site
      return;
    }
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  };

  function crumb(text: string, onClick?: () => void) {
    const li = document.createElement('li');
    const el = document.createElement(onClick ? 'button' : 'span');
    el.textContent = text;
    if (onClick) {
      (el as HTMLButtonElement).type = 'button';
      el.addEventListener('click', onClick);
    } else el.setAttribute('aria-current', 'location');
    li.append(el);
    crumbList.append(li);
  }

  // The header above the panel: breadcrumb, title, and (with only a branch open) its blurb and a chip per facet.
  function renderHead() {
    hint.hidden = !!openBranch;
    head.hidden = !openBranch;
    if (!openBranch) return;
    const b = openBranch;
    crumbList.replaceChildren();
    crumb('Deo', () => collapse(true));
    const branchText = `${iconOf(b.button)} ${labelOf(b.button)}`;
    if (openFacet) {
      crumb(branchText, () => backToBranch());
      crumb(`${iconOf(openFacet)} ${labelOf(openFacet)}`);
    } else crumb(branchText);
    const node = openFacet ?? b.button;
    headIcon.textContent = iconOf(node);
    headLabel.textContent = labelOf(node);
    headBlurb.hidden = headChips.hidden = !!openFacet;
    // ▶ Play for a tab with a gimmick.
    const gimmick = openFacet ? panelOf(openFacet).querySelector<HTMLElement>('.gimmick-play') : null;
    playButton.hidden = !gimmick;
    if (gimmick) {
      playButton.dataset.tab = gimmick.dataset.gimmickTab;
      playButton.setAttribute('aria-controls', gimmick.id);
      setPlay(!gimmick.hidden);
    }
    headBlurb.textContent = openFacet ? '' : b.button.dataset.blurb ?? '';
    headChips.replaceChildren(
      ...(openFacet
        ? []
        : b.facets.map((f) => {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.innerHTML = '<span aria-hidden="true"></span>';
            chip.firstElementChild!.textContent = iconOf(f);
            chip.append(labelOf(f));
            chip.addEventListener('click', () => openFacetFrom(f, 'user'));
            return chip;
          })),
    );
  }

  function setPlay(open: boolean) {
    playButton.setAttribute('aria-expanded', String(open));
    playLabel.textContent = open ? 'Hide' : 'Play';
  }
  playButton.addEventListener('click', () => {
    const tab = playButton.dataset.tab;
    const open = playButton.getAttribute('aria-expanded') === 'true';
    document.dispatchEvent(new CustomEvent(open ? 'gimmick:close' : 'gimmick:open', { detail: { tab, immersive: true, returnFocus: true } }));
  });
  document.addEventListener('gimmick:state', (e) => {
    const { tab, open, returnFocus } = (e as CustomEvent).detail;
    if (tab !== playButton.dataset.tab) return;
    setPlay(open);
    if (!open && returnFocus && !playButton.hidden) playButton.focus();
  });

  function collapse(focusRoot = false) {
    setFacet(null);
    setBranch(null);
    renderHead();
    clearHash();
    if (focusRoot) (phone.matches ? branches[0]?.button : rootButton)?.focus();
  }

  function growBranch(b: Branch) {
    if (openBranch === b) return collapse();
    setFacet(null);
    setBranch(b);
    renderHead();
    clearHash();
  }

  function backToBranch() {
    const b = openBranch;
    setFacet(null);
    renderHead();
    clearHash();
    b?.button.focus();
  }

  // Opens a facet's panel. `source` says whether a visitor picked it ('user') or a link did ('hash');
  // LustFacet only counts the visitor's own picks.
  function openFacetFrom(f: HTMLButtonElement, source: 'user' | 'hash') {
    const b = branchOf(f);
    if (openBranch !== b) setBranch(b);
    setFacet(f);
    renderHead();
    document.dispatchEvent(new CustomEvent('tabchange', { detail: panelOf(f).id }));
    document.dispatchEvent(new CustomEvent('facetopen', { detail: { id: f.dataset.tab, source } }));
    if (source === 'user') {
      rememberFacet(`#${f.dataset.tab}`);
      if (phone.matches) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  rootButton.addEventListener('click', () => collapse());
  for (const b of branches) b.button.addEventListener('click', () => growBranch(b));
  for (const f of allFacets) f.addEventListener('click', () => openFacetFrom(f, 'user'));

  // Keyboard: arrows (and Home/End) move between siblings in a row, Enter/Space opens,
  // Escape goes back up a level (facet → its branch, branch → Deo).
  function onKey(e: KeyboardEvent, row: HTMLButtonElement[], up: () => void) {
    const i = row.indexOf(e.currentTarget as HTMLButtonElement);
    const moves: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: row.length - 1 };
    if (e.key === 'Escape') {
      e.preventDefault();
      up();
    } else if (e.key in moves) {
      e.preventDefault();
      row[(moves[e.key] + row.length) % row.length].focus();
    }
  }
  const branchButtons = branches.map((b) => b.button);
  for (const b of branches) {
    b.button.addEventListener('keydown', (e) => onKey(e, branchButtons, () => collapse(true)));
    for (const f of b.facets) f.addEventListener('keydown', (e) => onKey(e, b.facets, () => b.button.focus()));
  }

  // In-tab switches (Potato: TV shows | Movies, PM/Life hacks: PM | Life hacks, Concert and Theater & Opera: Seen live | Wishlist). Each button carries the
  // link that opens it (data-switch-hash), e.g. #potato-movies or #concert-wishlist.
  const switchButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-switch-hash]'));
  function flip(button: HTMLButtonElement, updateHash = true) {
    const group = Array.from(button.closest('.switch')!.querySelectorAll<HTMLButtonElement>('[data-switch-hash]'));
    for (const b of group) {
      const on = b === button;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (updateHash) history.replaceState(history.state, '', button.dataset.switchHash); // keeps the tab's back entry
  }
  for (const b of switchButtons) {
    b.addEventListener('click', () => flip(b));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      e.stopPropagation();
      const group = Array.from(b.closest('.switch')!.querySelectorAll<HTMLButtonElement>('[data-switch-hash]'));
      const next = group[(group.indexOf(b) + (e.key === 'ArrowRight' ? 1 : -1) + group.length) % group.length];
      flip(next);
      next.focus();
    });
  }

  // Old links: #weeb is now #anime, #drummer is now #musician; #sex is now #lust; #tv and #movie (the old TV/Movie Potato tabs) open the Potato switch.
  const renamed: Record<string, string> = { '#weeb': '#anime', '#tv': '#potato', '#movie': '#potato-movies', '#cat': '#pets-peeta', '#sex': '#lust', '#drummer': '#musician' };
  // Opens the facet a link like #death points to, growing its branch. Returns false if the hash isn't a facet.
  function openFromHash(rawHash: string): boolean {
    const hash = renamed[rawHash] ?? rawHash;
    // #aviation-play: the tab with its gimmick already open.
    const play = /^#(.+)-play$/.exec(hash);
    const playFacet = play && allFacets.find((f) => f.dataset.tab === play[1] && panelOf(f).querySelector('.gimmick-play'));
    if (playFacet) {
      openFacetFrom(playFacet, 'hash');
      document.dispatchEvent(new CustomEvent('gimmick:open', { detail: { tab: playFacet.dataset.tab, immersive: false } }));
      return true;
    }
    const switchButton = switchButtons.find((b) => b.dataset.switchHash === hash);
    const facet = allFacets.find(
      (f) =>
        `#${f.dataset.tab}` === hash ||
        (switchButton && panelOf(f).contains(switchButton)) ||
        (f.dataset.tab === 'pets' && hash.startsWith('#pets-')),
    );
    if (!facet) return false;
    openFacetFrom(facet, 'hash');
    if (switchButton) flip(switchButton, false);
    return true;
  }
  // #qr is the hidden QR Code page's short link: deovandski.com/#qr → /qr/.
  if (location.hash.toLowerCase() === '#qr') location.replace(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}qr/`);
  // #playground (and the older #gaming) do the same for the Playground page: …/#playground → /playground/.
  if (['#playground', '#gaming'].includes(location.hash.toLowerCase())) location.replace(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}playground/`);
  openFromHash(location.hash);

  // Links between facets (e.g. Mentor → "#death") switch facets too, then bring the facet's header into view.
  // A plain link would add a history entry of its own, so it's handled here and shares the tab's one entry.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const hash = a.getAttribute('href')!;
    if (hash.length < 2 || !openFromHash(hash)) return;
    e.preventDefault();
    rememberFacet(renamed[hash] ?? hash);
    head.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  window.addEventListener('hashchange', () => {
    if (openFromHash(location.hash)) head.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  // Back from a tab: show the tree again, with the tab's branch still open.
  window.addEventListener('popstate', () => {
    if (skipPop) {
      skipPop = false;
      return;
    }
    if (location.hash || !openFacet) return; // forward to a tab is handled by hashchange
    document.dispatchEvent(new CustomEvent('gimmick:close', { detail: {} }));
    const b = openBranch;
    setFacet(null);
    renderHead();
    (b?.button ?? treeEl).scrollIntoView({ behavior: 'smooth', block: 'center' });
    b?.button.focus({ preventScroll: true });
  });
  // Photos open in the site-wide PhotoViewer (src/components/reusable/PhotoViewer.astro, in Base.astro).
</script>
