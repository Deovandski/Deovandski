        <Sections data={concerts} id="concert" layout="cards" sortAlpha avatarsDir="content/concerts/bands" photoAlt={(t) => `At ${t}`} />
      </div>
      <div id="concert-wishlist" role="region" aria-labelledby="sub-concert-wishlist" data-sub-panel hidden>
        <Sections data={concertWishlist} id="concert-wish" layout="cards" sortAlpha avatarsDir="content/concerts/bands" photoAlt={(t) => `At ${t}`} />
      </div>
