  .crumbs :global([aria-current]) { color: var(--text); font-weight: 700; }
  .facet-head__title { margin: 0.1rem 0 0; font-size: var(--step-2); color: var(--text); }
  .facet-head__row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.1rem; }
  .facet-head__play {
    display: inline-flex;
