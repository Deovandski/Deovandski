                </button>
              </div>
              <div class="tree__group" id={`branch-group-${b.id}`} data-group={b.id} role="group" aria-labelledby={`branch-${b.id}`} hidden>
                <div class="wire" aria-hidden="true">
                  <span class="wire__drop"></span><span class="wire__bus"></span><span class="wire__hl"></span>
                </div>
                <div class="tree__row">
                  {b.items.map((t, i) => (
                    <Fragment>
                      <div class="tree__leaf" style={`--i:${i}`}>
                        <button
                          type="button"
                          class="tree__node tree__node--facet"
                          id={`tab-${t.id}`}
                          data-tab={t.id}
                          data-icon={t.icon}
                          aria-controls={`panel-${t.id}`}
                          aria-pressed="false"
                          aria-expanded={t.subs ? 'false' : undefined}
                        >
                          <span class="tree__disc" aria-hidden="true">{t.icon}</span>
                          <span class="tree__label">{t.label}</span>
                          {t.subs && <span class="tree__count">{`${t.subs.length} sub-facets`}</span>}
                          {t.subs && <svg class="tree__chev" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>}
                        </button>
                      </div>
                      {t.subs && (
                        <div class="tree__subgroup" id={`subs-${t.id}`} data-subs-of={t.id} role="group" aria-labelledby={`tab-${t.id}`} hidden>
                          <div class="wire" aria-hidden="true">
                            <span class="wire__drop"></span><span class="wire__bus"></span><span class="wire__hl"></span>
                          </div>
                          <div class="tree__row tree__row--sub">
