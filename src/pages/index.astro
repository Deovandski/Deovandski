    margin-top: 0.1rem;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: 999px;
    border: 2px solid var(--teal);
    background: transparent;
    color: var(--teal);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .facet-head__play:hover { background: rgba(57, 197, 187, 0.14); }
  .facet-head__play:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .facet-head__play[aria-expanded='true'] { background: var(--teal); color: var(--bg, #070b1f); }
  .facet-head__play .facet-head__hide-icon, .facet-head__play[aria-expanded='true'] .facet-head__play-icon { display: none; }
  .facet-head__play[aria-expanded='true'] .facet-head__hide-icon { display: inline; }
  .facet-head__blurb { margin: 0.5rem 0 0; color: var(--muted); max-width: var(--measure); }
  .facet-head__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; padding-bottom: clamp(1.25rem, 3vw, 2.25rem); }
  .facet-head__chips :global(button) {
