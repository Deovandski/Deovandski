// The facet tree: Deo → branch → facet → sub-tab (the third level only where a facet lists `subs`).
// Visitors see both levels A to Z (#280): the branches by label, and the facets inside each branch by label. The code
// below sorts them, so the order of these lists doesn't matter; they're kept A to Z anyway so they read the same.
// No facet opens by default: visitors grow a branch, then pick a facet.
const branches = [
  { id: 'craft', icon: '💼', label: 'Craft', blurb: 'What Deo builds, writes, plays and paints.', facets: ['author', 'dev', 'influencer', 'musician', 'painting', 'pm'] },
  { id: 'explorer', icon: '🌏', label: 'Explorer', blurb: 'Where Deo goes and the languages he speaks there.', facets: ['aviation', 'camping', 'fishing', 'multilingual', 'traveler'] },
  { id: 'frontrow', icon: '🎟️', label: 'Front Row', blurb: 'What Deo watches: live shows, the diva herself, anime, and the movies and TV worth (or not worth) the time.', facets: ['anime', 'botw', 'concert', 'miku', 'potato', 'theater'] },
  { id: 'hearth', icon: '🏡', label: 'Hearth', blurb: 'Family, pets, the grill, the kitchen, and the body that carries it all.', facets: ['biomarkers', 'churrasco', 'cooking', 'family', 'pets'] },
  { id: 'philosophy', icon: '🧭', label: 'Philosophy', blurb: 'How Deo thinks: mortality, mentoring, discipline, desire and ink.', facets: ['cycling', 'death', 'gym', 'lust', 'mentor', 'tattoo'] },
  { id: 'play', icon: '🕹️', label: 'Play', blurb: 'Games at the table and on the screen, cards included.', facets: ['boardgames', 'dnd', 'gamer', 'mtg'] },
];

// Every facet must sit in exactly one branch, and a branch holds at most 6 (one row of the tree).
{
  const placed = branches.flatMap((b) => b.facets);
  const missing = facets.filter((f) => !placed.includes(f.id)).map((f) => f.id);
  const unknown = placed.filter((id) => !facets.some((f) => f.id === id));
  const twice = placed.filter((id, i) => placed.indexOf(id) !== i);
  const tooBig = branches.filter((b) => b.facets.length > 6).map((b) => b.id);
  if (missing.length || unknown.length || twice.length || tooBig.length) {
    throw new Error(`Facet tree: missing ${missing}, unknown ${unknown}, listed twice ${twice}, over 6 facets ${tooBig}`);
  }
  // Sub-tabs: 2 to 6 per facet, one of them opened by the facet's own link, and every link used once.
  const hashes = facets.flatMap((f) => [`#${f.id}`, ...(f.subs ?? []).filter((s) => s.hash !== `#${f.id}`).map((s) => s.hash)]);
  const badSubs = facets
    .filter((f) => f.subs && (f.subs.length < 2 || f.subs.length > 6 || f.subs.filter((s) => s.hash === `#${f.id}`).length !== 1 || new Set(f.subs.map((s) => s.id)).size !== f.subs.length))
    .map((f) => f.id);
  const twiceHash = hashes.filter((h, i) => hashes.indexOf(h) !== i);
  if (badSubs.length || twiceHash.length) {
    throw new Error(`Facet tree: sub-tabs need 2 to 6, one opened by #<facet>, unique ids (${badSubs}); links used twice: ${twiceHash}`);
  }
}
const facetById = new Map(facets.map((f) => [f.id, f]));
// A to Z by the English label (what the tab shows), ignoring case, accents, emoji and punctuation, so "D&D" sorts as
// "dd" and "Painting/Drawing" as "paintingdrawing". A label in another script sorts by its `sortAs` (初音ミク as Hatsune Miku).
const alphaKey = (x: { label: string; sortAs?: string }) =>
  (x.sortAs ?? x.label).normalize('NFD').replace(/[^\p{L}\p{N} ]/gu, '').toLowerCase();
const byAlpha = <T extends { label: string; sortAs?: string }>(a: T, b: T) => alphaKey(a).localeCompare(alphaKey(b), 'en');
const tree = [...branches]
  .sort(byAlpha)
  .map((b) => ({
    ...b,
    items: b.facets
      .map((id) => facetById.get(id)!)
      .sort(byAlpha)
      .map((f) => ({ ...f, subs: f.subs ? [...f.subs].sort(byAlpha) : undefined })),
  }));

