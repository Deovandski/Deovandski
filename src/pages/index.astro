  /* Facet tree. Desktop: Deo on top, branches fan out in a row, the open branch grows a row of facets below it,
     joined by "wires" the script positions (12-column grid, every node spans 2 columns, rows centered).
     Phone (≤ 640px): the same markup becomes a vertical accordion. */
  .tree { scroll-margin-top: 6rem; padding: 1.25rem 1rem 1.5rem; --wire: rgba(154, 168, 187, 0.35); }
  .tree__root { display: flex; justify-content: center; }
  .tree__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 44px;
    padding: 4px;
    background: none;
    border: 0;
    border-radius: 14px;
    color: var(--silver);
    font: inherit;
    cursor: pointer;
  }
  .tree__node:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  .tree__disc {
    width: 64px;
    height: 64px;
    box-sizing: border-box;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    line-height: 1;
    background: var(--night-2);
    border: 2px solid var(--night-3);
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }
  .tree__node:hover .tree__disc { border-color: rgba(57, 197, 187, 0.6); }
  .tree__node--root .tree__disc {
    width: 72px;
    height: 72px;
    border-color: var(--teal);
    color: var(--teal);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.9rem;
  }
  .tree__node--facet .tree__disc { width: 56px; height: 56px; font-size: 1.5rem; }
  .tree__label { font-family: var(--font-display); font-weight: 800; font-size: var(--step-0); line-height: 1.25; text-align: center; }
  .tree__node--facet .tree__label { font-size: var(--step--1); }
  .tree__count { color: var(--muted); font-size: var(--step--1); }
  .tree__chev { display: none; }
  .tree__node[aria-expanded='true'], .tree__node[aria-pressed='true'] { color: var(--text); }
  .tree__node[aria-expanded='true'] .tree__disc { border-color: var(--teal); background-color: rgba(57, 197, 187, 0.14); }
  .tree__node[aria-pressed='true'] .tree__disc {
    border-color: var(--pink);
    background-color: rgba(225, 40, 133, 0.18);
    box-shadow: 0 0 20px rgba(225, 40, 133, 0.35);
  }

  .wire { position: relative; height: 40px; }
  .wire span { position: absolute; display: block; }
  .wire__drop { top: 0; width: 2px; height: 20px; background: var(--teal); transform-origin: 50% 0; animation: grow-y 0.2s ease-out both; }
  .wire--root .wire__drop { background: var(--wire); }
  .tree.is-open .wire--root .wire__drop { background: var(--teal); }
  .wire__bus { top: 19px; height: 2px; background: var(--wire); animation: grow-x 0.3s 0.18s ease-out both; }
  .wire__hl { top: 19px; height: 2px; background: var(--teal); animation: grow-x 0.3s 0.18s ease-out both; transition: left 0.25s ease, width 0.25s ease; }
  .wire :global(.wire__tick) { position: absolute; display: block; top: 20px; width: 2px; height: 20px; background: var(--wire); transform-origin: 50% 0; animation: grow-y 0.2s 0.42s ease-out both; transition: background-color 0.2s; }
  .wire :global(.wire__tick.is-on) { background: var(--teal); }

  .tree__grid, .tree__row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .tree__branch { grid-row: 1; display: flex; justify-content: center; padding: 0 4px; }
  .tree__group { grid-row: 2; grid-column: 1 / -1; margin-top: 0.5rem; }
  .tree__group[hidden] { display: none; }
  .tree__leaf { display: flex; justify-content: center; padding: 0 4px; animation: pop-in 0.32s calc(var(--i) * 60ms + 0.45s) ease-out both; }

  @keyframes grow-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes pop-in { from { opacity: 0; transform: translateY(-10px) scale(0.92); } to { opacity: 1; transform: none; } }

  .facet-head { scroll-margin-top: 6rem; padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem) 0; border-top: 1px solid rgba(57, 197, 187, 0.2); }
  .facet-head[hidden], .facet-head [hidden] { display: none; }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; margin: 0; padding: 0; color: var(--muted); font-size: var(--step--1); }
  .crumbs :global(li + li)::before { content: '›'; padding: 0 0.35rem; }
  .crumbs :global(button) { min-height: 44px; padding: 0 0.25rem; background: none; border: 0; color: var(--muted); font: inherit; cursor: pointer; }
  .crumbs :global(button:hover) { color: var(--text); text-decoration: underline; }
