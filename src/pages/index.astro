          <svg class="facet-head__hide-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10.5l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span class="facet-head__play-label">Play</span>
        </button>
        <!-- Links: opens the tab's links box (a LinksMenu with toggle="external" at the top of the tab's panel). See "Tab links" in CLAUDE.md. -->
        <button type="button" class="facet-head__play facet-head__links" aria-expanded="false" disabled>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3M7 4.5l1-1a2.8 2.8 0 0 1 4 4l-1 1M9 11.5l-1 1a2.8 2.8 0 0 1-4-4l1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          <span>Links</span>
          <svg class="facet-head__links-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        </div>
