---
// Hidden QR Code page (/qr/, or #qr on the home page): just the header, the footer and QR codes,
// for sharing contact info on the fly. Not in the menu, the facet tree, the sitemap or search results.
// To add a code, add a row to `codes`; they stack top to bottom in this order.
import Base from '../layouts/Base.astro';
import QrCode from '../components/reusable/QrCode.astro';

// BASE_URL may lack its trailing slash (/Deovandski); the site's real address ends in one.
const website = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href;

const codes = [{ title: 'Website', value: website }];
---

<Base title="QR Code" description="QR codes for sharing Deovandski's contact info." noindex>
  <h1 class="sr-only">QR Code</h1>
  <div class="qr-stack">
    {codes.map((c) => <QrCode title={c.title} value={c.value} label={`QR code for Deovandski's ${c.title.toLowerCase()}: ${c.value}`} />)}
  </div>
</Base>

<style>
  .qr-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding: 1.5rem 0 2.5rem;
    --qr-title-color: var(--teal, #39c5bb);
    --qr-value-color: var(--muted, #9aa3b5);
  }
</style>
