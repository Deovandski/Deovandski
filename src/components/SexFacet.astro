---
import { Content } from '../../content/sex.md';
import { url } from '../lib/url';
---

<!-- Two banners: one when the Sex tab is the very first click, one when the visitor clicked something else first. -->
<div class="ara" data-variant="first" hidden role="status">
  <img data-src={url('/ara-ara.webp')} alt="" width="159" height="229" />
  <div>
    <p class="ara__title">Ara ara~ That's the first thing you click?</p>
    <p>Don't worry. You're human and curious. I am not tracking IPs or any other metrics.</p>
    <p>You don't have to trust me, you can check <a href="https://github.com/Deovandski/Deovandski">the source code</a> yourself.</p>
    <button type="button" class="ara__close">Close</button>
  </div>
</div>

<div class="ara" data-variant="later" hidden role="status">
  <img data-src={url('/yeah-yes.gif')} alt="" width="220" height="225" />
  <div>
    <p class="ara__title">You didn't fall for the UX trap I set!</p>
    <p>I would have clicked this tab first, so we have different mindsets. Huehuehue.</p>
    <button type="button" class="ara__close">Close</button>
  </div>
</div>

<div class="sex">
  <Content />
</div>

<style>
  .ara {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(225, 40, 133, 0.2), rgba(57, 197, 187, 0.12)), var(--night);
    border: 1px solid rgba(225, 40, 133, 0.55);
    box-shadow: 0 0 40px rgba(225, 40, 133, 0.25);
  }
  .ara[hidden] { display: none; }
  .ara img { width: 110px; height: auto; border-radius: 12px; }
  .ara p { margin: 0 0 0.4rem; }
  .ara__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--pink);
  }
  .ara__close {
    margin-top: 0.4rem;
    font: inherit;
    font-weight: 700;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--pink);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
  }

  .sex { max-width: var(--measure); }
  .sex :global(strong) { color: var(--teal); }
  .sex :global(h2) { font-size: var(--step-1); color: var(--silver); margin: 2.25rem 0 0.75rem; }
  .sex :global(blockquote) {
    margin: 0 0 1.25rem;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 4px solid var(--pink);
    color: var(--silver);
    font-style: italic;
  }

  @media (max-width: 560px) {
    .ara { grid-template-columns: 1fr; text-align: center; }
    .ara img { margin: 0 auto; }
  }
</style>

<script>
  // The first time the Sex tab is clicked, show a banner: "Ara ara~" if it was the very first click
  // on the page, or the "you didn't fall for the UX trap" one if the visitor clicked something else first.
  const banners = {
    first: document.querySelector<HTMLElement>('.ara[data-variant="first"]'),
    later: document.querySelector<HTMLElement>('.ara[data-variant="later"]'),
  };
  let clicks = 0;
  let shown = false;
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target as Element | null;
      if (!shown && target?.closest('#tab-sex')) {
        const banner = clicks === 0 ? banners.first : banners.later;
        const img = banner?.querySelector<HTMLImageElement>('img');
        if (img?.dataset.src) img.src = img.dataset.src;
        if (banner) banner.hidden = false;
        shown = true;
      }
      clicks++;
    },
    { capture: true },
  );
  for (const banner of Object.values(banners)) {
    banner?.querySelector('.ara__close')?.addEventListener('click', () => (banner.hidden = true));
  }
</script>
