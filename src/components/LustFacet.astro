---
import { Content } from '../../content/lust.md';
import { url } from '../lib/url';
import EasterEggBanner from './reusable/EasterEggBanner.astro';
---

<!-- Two banners: one when Lust is the first facet the visitor opens, one when they opened another facet first. -->
<EasterEggBanner name="lust-first" image={url('/ara-ara.webp')} imageWidth={159} imageHeight={229} title="Ara ara~ That's the first thing you click?">
  <p>Don't worry. You're human and curious. I am not tracking IPs or any other metrics.</p>
  <p>You don't have to trust me, you can check the source code yourself.</p>
</EasterEggBanner>

<EasterEggBanner name="lust-later" image={url('/yeah-yes.gif')} imageWidth={220} imageHeight={225} title="Huh. You didn't take the bait.">
  <p>Zero tracking, zero metrics. I'll never know, so if you see me out in the wild, brag about it. 😉</p>
</EasterEggBanner>

<div class="lust">
  <Content />
</div>

<style>
  .lust { max-width: var(--measure); }
  .lust :global(strong) { color: var(--teal); }
  .lust :global(h2) { font-size: var(--step-1); color: var(--silver); margin: 2.25rem 0 0.75rem; }

</style>

<script>
  // The first time the Lust facet is opened, show a banner: "Ara ara~" if it's the first facet the visitor opened,
  // or the "you didn't take the bait" one if they opened another facet first. Only facets the visitor opens
  // themselves count ('user'); growing or folding branches in the tree, other clicks on the page, and links
  // (#lust or #sex on arrival, links between facets) don't. The tree announces each open with a `facetopen` event.
  const banners = {
    first: document.querySelector<HTMLElement>('[data-egg="lust-first"]'),
    later: document.querySelector<HTMLElement>('[data-egg="lust-later"]'),
  };
  let firstFacet: string | null = null;
  let shown = false;
  document.addEventListener('facetopen', (e) => {
    const { id, source } = (e as CustomEvent<{ id: string; source: 'user' | 'hash' }>).detail;
    if (source !== 'user') return;
    firstFacet ??= id;
    if (id !== 'lust' || shown) return;
    const banner = firstFacet === 'lust' ? banners.first : banners.later;
    if (banner) banner.hidden = false; // EasterEggBanner loads the picture and handles Close
    shown = true;
  });
</script>
