---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Content as Story } from '../../content/biomarkers/story.md';
import MetricLab from './reusable/MetricLab.astro';
import { url } from '../lib/url';

// Hearth › Biomarker Lab. The numbers come from content/biomarkers/daily.json (scripts/biomarkers-from-takeout.mjs),
// served as /biomarkers.json (src/pages/biomarkers.json.ts) with the Cycling tab's rides as the "event".
const { exported, days } = JSON.parse(readFileSync(resolve('content/biomarkers/daily.json'), 'utf8')) as { exported: string; days: { date: string }[] };
const from = new Date(`${days[0].date}T00:00:00Z`), to = new Date(`${days[days.length - 1].date}T00:00:00Z`);
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="biomarkers">
  <div class="biomarkers__story"><Story /></div>

  <MetricLab
    id="bio"
    src={url('/biomarkers.json')}
    hash="#biomarkers"
    metrics={[
      { key: 'rhr', label: 'Resting heart rate', unit: 'bpm', decimals: 1 },
      { key: 'hrv', label: 'Heart rate variability', unit: 'ms' },
      { key: 'sleepMin', label: 'Time asleep', format: 'duration' },
      { key: 'bedH', label: 'Bedtime', format: 'clock' },
      { key: 'sleepScore', label: 'Sleep score' },
      { key: 'deep', label: 'Deep sleep', unit: 'min' },
      { key: 'rem', label: 'REM sleep', unit: '%', decimals: 1 },
      { key: 'resp', label: 'Breathing rate', unit: '/min', decimals: 1 },
      { key: 'spo2', label: 'Blood oxygen', unit: '%', decimals: 1 },
      { key: 'skinC', label: 'Skin temperature', unit: '°F', decimals: 1 },
      { key: 'steps', label: 'Steps' },
      { key: 'azm', label: 'Active zone minutes', unit: 'min' },
      { key: 'stress', label: 'Stress score' },
      { key: 'vo2', label: 'Cardio fitness (VO₂ max)', decimals: 1 },
      { key: 'ready', label: 'Readiness' },
    ]}
    event={{ view: 'Ride nights', day: 'ride day', after: 'After a ride', other: 'Other nights', value: 'Rode {n} mi', slug: 'rides' }}
    defaults={{ timeline: ['rhr', 'hrv', 'sleepMin', 'sleepScore', 'deep', 'steps', 'spo2', 'vo2'], calendar: 'sleepScore', seasons: 'rhr', x: 'steps', y: 'hrv' }}
  />

  <p class="biomarkers__fine">
    From my Pixel Watch, through Google Health, {month(from)} to {month(to)} (exported {exported}). Rides come from the
    <a href="#cycling">Cycling</a> tab. Dates and numbers only: no places.
  </p>
</div>

<style>
  .biomarkers {
    --lab-font: var(--font-body);
    --lab-display-font: var(--font-display);
    --lab-accent: var(--teal);
    --lab-event: var(--pink);
    --lab-surface: var(--night-2, #0d1430);
    --lab-text: var(--text);
    --lab-muted: var(--muted);
  }
  .biomarkers__story { max-width: var(--measure); margin-bottom: 1.5rem; }
  .biomarkers__story :global(h2) { font-size: var(--step-1); color: var(--silver); margin: 0 0 0.5rem; }
  .biomarkers__fine { margin-top: 1.5rem; font-size: var(--step--1); color: var(--muted); max-width: var(--measure); }
</style>
