---
import { loadTopGames } from '../lib/games';

const games = loadTopGames();
const max = Math.max(1, ...games.map((g) => g.hours));
const total = games.reduce((sum, g) => sum + g.hours, 0);
const nf = new Intl.NumberFormat('en-US');
---

<p class="lede">My top 10 favorites, ranked, with how many hours I've sunk into each. {nf.format(total)} hours in total.</p>

<ol class="ranking">
  {
    games.map((g) => (
      <li style={`--share:${(g.hours / max).toFixed(3)}`}>
        <span class="rank" aria-hidden="true">{g.rank}</span>
        <div class="info">
          <h3>
            <span class="sr-only">Rank {g.rank}: </span>
            {g.game}
          </h3>
          <div class="bar" aria-hidden="true">
            <span />
          </div>
        </div>
        <p class="hours">
          {nf.format(g.hours)}
          <span>hours</span>
        </p>
      </li>
    ))
  }
</ol>

<style>
  .lede { margin-bottom: 1.5rem; }
  .ranking { list-style: none; margin: 0; padding: 0; }
  .ranking li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 6rem;
    align-items: center;
    gap: 1.1rem;
    padding-block: 0.9rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
  }
  .rank {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--silver);
    text-align: right;
  }
  .ranking li:first-child .rank {
    color: var(--teal);
    text-shadow: 0 0 22px rgba(57, 197, 187, 0.6);
  }
  .ranking li:nth-child(2) .rank,
  .ranking li:nth-child(3) .rank { color: #8fded7; }
  .info h3 { font-size: var(--step-0); margin: 0 0 0.45rem; }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: rgba(190, 200, 209, 0.12);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: calc(var(--share) * 100%);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--teal-deep), var(--teal));
  }
  .hours {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hours span {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ranking li { grid-template-columns: 2.25rem minmax(0, 1fr) 4.5rem; gap: 0.7rem; }
    .rank { font-size: var(--step-1); }
    .hours { font-size: var(--step-0); }
  }
</style>
