---
import { Content as Story } from '../../content/cycling/story.md';
import YouTube from './reusable/YouTube.astro';

// ---- data: src/lib/cycling.ts (rides.json, estimated.md, cities.json), shared with the tab's ▶ Play map ----
import { log, MILE, estimates, rides, caught, caughtHours, outdoor, guessed, guessedKm, estimatedKm, totalKm, star, places, totalMi, passed, ahead, EARTH_MI } from '../lib/cycling';
import type { Ride } from '../lib/cycling';

const hours = rides.reduce((s, r) => s + r.minutes, 0) / 60;
const longest = outdoor.filter((r) => !r.estimated).reduce<Ride | null>((best, r) => (!best || r.km > best.km ? r : best), null);
const mountain = rides.filter((r) => r.kind === 'mountain').length;
const n0 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
const n1 = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });
const usDate = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Distance by year (outdoor rides), for the bars: measured, then estimated.
const byYear = new Map<number, { km: number; est: number; rides: number }>();
for (const r of outdoor) {
  const y = Number(r.date.slice(0, 4));
  const e = byYear.get(y) ?? { km: 0, est: 0, rides: 0 };
  if (r.estimated) e.est += r.km;
  else e.km += r.km;
  e.rides++;
  byYear.set(y, e);
}
const years = [...byYear.entries()].sort((a, b) => a[0] - b[0]);
const maxYear = Math.max(1, ...years.map(([, v]) => v.km + v.est));
const indoor = rides.length - outdoor.length;

---

<div class="cycling">
  <section class="cycling__world" aria-labelledby="cycling-world">
    <h2 id="cycling-world">Around the World in 80 Gears</h2>
    <p class="cycling__lap">
      {n0.format(totalMi)} mi{star} on the bike: <strong>{n1.format((totalMi / EARTH_MI) * 100)}%</strong> of the way around the world.
      Press <strong>▶ Play</strong> to ride it on the map.
    </p>
    {
      totalMi > 0 && (passed || ahead) && (
        <p class="cycling__compare">
          {passed && <>That's farther than {places.start.name} to {passed.label} ({n0.format(passed.distance)} mi as the crow flies). </>}
          {ahead && <>Next stop: {ahead.label}, {n0.format(ahead.distance - totalMi)} mi to go.</>}
        </p>
      )
    }
    {
      rides.length === 0 && estimates.length === 0 ? (
        <p class="cycling__empty">The ride log is on its way: it comes from my Google Health export.</p>
      ) : (
        <>
          <dl class="cycling__stats">
            <div><dt>Rides</dt><dd>{n0.format(rides.length)}</dd></div>
            <div><dt>Distance</dt><dd>{n0.format(totalKm / MILE)} mi{star} <span>({n0.format(totalKm)} km)</span></dd></div>
            <div><dt>In the saddle</dt><dd>{n1.format(hours)} h</dd></div>
            {longest && <div><dt>Longest ride</dt><dd>{n1.format(longest.km / MILE)} mi <span>({usDate(longest.date)})</span></dd></div>}
            {mountain > 0 && <div><dt>Mountain rides</dt><dd>{n0.format(mountain)}</dd></div>}
          </dl>
          {
            years.length > 1 && (
              <ul class="cycling__years" aria-label="Distance by year">
                {years.map(([y, v]) => (
                  <li>
                    <span class="cycling__year">{y}</span>
                    <span class="cycling__bars" aria-hidden="true">
                      <span class="cycling__bar" style={`--w:${((v.km / maxYear) * 100).toFixed(1)}%`} />
                      <span class="cycling__bar cycling__bar--est" style={`--w:${((v.est / maxYear) * 100).toFixed(1)}%`} />
                    </span>
                    <span class="cycling__km">{n0.format((v.km + v.est) / MILE)} mi{v.est > 0 ? '*' : ''}</span>
                  </li>
                ))}
              </ul>
            )
          }
          {log.exported && <p class="cycling__foot">Rides from my Google Health export, updated on {usDate(log.exported)}.{indoor > 0 && ' Indoor bikes count as rides and time, not distance.'}</p>}
          {guessed.length > 0 && <p class="cycling__foot">* {n0.format(guessed.length)} rides were logged without GPS, so their distance ({n0.format(guessedKm / MILE)} mi, the lighter part of the bars) is estimated from their time, at my median speed of {n1.format((log.medianKmh ?? 14) / MILE)} mph.</p>}
          {estimatedKm > 0 && <p class="cycling__foot">* Includes {n0.format(estimatedKm / MILE)} mi I estimated myself, from before the tracking.</p>}
        </>
      )
    }
  </section>
  {
    caught.length > 0 && (
      <section class="cycling__peeta" aria-labelledby="cycling-peeta">
        <h2 id="cycling-peeta">Ridin' with Peeta</h2>
        <p>
          My watch logged {n0.format(caught.length)} more "bike rides" on its own ({n0.format(caughtHours)} hours of them). Most of those
          were me pushing my cat, <a href="#pets-peeta">Peeta</a>, in his stroller, or me on the elliptical when it's too cold outside, so
          they don't count toward the miles above.
        </p>
        <YouTube id="Ez7ppSYdJmI" title="Ridin' with Peeta" short ratio="1:1" />
      </section>
    )
  }
  <div class="cycling__story"><Story /></div>
</div>

<style>
  .cycling { max-width: 52rem; }
  .cycling__lap { font-weight: 700; }
  .cycling h2,
  .cycling :global(h2) {
    font-size: var(--step-2);
    color: var(--text);
    margin: 2.4em 0 0.6em;
    padding-top: 1.1em;
    border-top: 1px solid rgba(225, 40, 133, 0.35);
  }
  .cycling__world h2 { margin-top: 0; padding-top: 0; border-top: 0; }
  .cycling__compare { margin: 0.35rem 0 0; color: var(--text); }
  .cycling__empty,
  .cycling__foot { color: var(--muted); font-size: var(--step--1); margin: 0.5rem 0 0; }
  .cycling__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
  }
  .cycling__stats div {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(57, 197, 187, 0.35);
    border-radius: 14px;
    background: rgba(57, 197, 187, 0.06);
  }
  .cycling__stats dt { color: var(--muted); font-size: var(--step--1); }
  .cycling__stats dd { margin: 0.2rem 0 0; font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); color: var(--text); }
  .cycling__stats dd span { display: block; font-family: inherit; font-weight: 400; font-size: var(--step--1); color: var(--muted); }
  .cycling__years { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.4rem; }
  .cycling__years li { display: grid; grid-template-columns: 3.5rem 1fr 5.5rem; align-items: center; gap: 0.6rem; }
  .cycling__year { color: var(--muted); font-variant-numeric: tabular-nums; }
  .cycling__bars { display: flex; gap: 2px; }
  .cycling__bar { height: 0.8rem; width: var(--w); border-radius: 999px; background: var(--teal); }
  .cycling__bar--est { background: repeating-linear-gradient(135deg, rgba(57, 197, 187, 0.55) 0 4px, rgba(57, 197, 187, 0.25) 4px 8px); }
  .cycling__km { font-variant-numeric: tabular-nums; text-align: end; }
  .cycling :global(strong) { color: var(--teal); }
  .cycling :global(ul) { padding-inline-start: 1.2rem; }
  .cycling :global(li) { margin: 0.35rem 0; }
</style>
