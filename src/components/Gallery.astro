---
import { Image, getImage } from 'astro:assets';
import type { Gallery } from '../lib/gallery';

interface Props {
  gallery: Gallery;
  name: string; // groups photos for the zoom viewer, e.g. "cat" or "fishing"
  empty: string; // shown when the folder has no photos yet
  captions?: boolean; // show each photo's description (from its filename) above it on the grid
}

const { gallery, name, empty, captions = false } = Astro.props;
const photos = await Promise.all(
  gallery.photos.map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.src, width: Math.min(1800, p.src.width), format: 'webp', quality: 80 })).src,
  })),
);
---

{gallery.intro.map((para) => <p>{para}</p>)}
{
  photos.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="gallery-grid">
      {photos.map((p, i) => (
        <li>
          {captions && <p class="gallery-caption" aria-hidden="true" title={p.alt}>{p.alt}</p>}
          <button type="button" data-gallery={name} data-index={i} data-full={p.full} data-alt={p.alt} aria-label={`Enlarge: ${p.alt}`}>
            <Image src={p.src} alt="" width={480} widths={[240, 480]} sizes="(max-width: 560px) 50vw, 240px" />
          </button>
        </li>
      ))}
    </ul>
  )
}

<style>
  .empty { color: var(--muted); }
  .gallery-grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .gallery-grid li { display: flex; flex-direction: column; gap: 0.4rem; }
  .gallery-caption {
    margin: 0;
    min-height: 2.6em; /* two lines, so photos in a row line up */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    color: var(--silver);
  }
  .gallery-grid button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--night-3);
    cursor: zoom-in;
    line-height: 0;
  }
  .gallery-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .gallery-grid button:hover img { filter: brightness(1.1); }
  @media (max-width: 560px) {
    .gallery-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
