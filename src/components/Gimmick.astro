---
// Renders one gimmick by its id from src/lib/gimmicks.ts, with the same props and saves wherever it shows:
// in a tab's ▶ Play FastTab (GimmickPlay.astro) and on the Playground page (/playground/).
import DiceTray from './reusable/DiceTray.astro';
import DinoAmbush from './reusable/DinoAmbush.astro';
import DrawingPad from './reusable/DrawingPad.astro';
import DrumKit from './reusable/DrumKit.astro';
import FireMeter from './reusable/FireMeter.astro';
import IceFlasher from './reusable/IceFlasher.astro';
import IsoFarm from './reusable/IsoFarm.astro';
import KitKot from './reusable/KitKot.astro';
import LedMatrix from './reusable/LedMatrix.astro';
import PaperPlane from './reusable/PaperPlane.astro';
import PerfectEgg from './reusable/PerfectEgg.astro';
import PlanetLap from './reusable/PlanetLap.astro';
import PhotoQuiz from './reusable/PhotoQuiz.astro';
import PhotoShoot from './reusable/PhotoShoot.astro';
import PixelHammock from './reusable/PixelHammock.astro';
import RepoPulse from './reusable/RepoPulse.astro';
import { travelQuiz } from '../lib/travelQuiz';
import EasterEggBanner from './reusable/EasterEggBanner.astro';
import UrsuSprite from './UrsuSprite.astro';
import { url } from '../lib/url';
import PixelPet from './reusable/PixelPet.astro';
import StageDancer from './reusable/StageDancer.astro';
import TerminalTyper from './reusable/TerminalTyper.astro';
import VhsPile from './reusable/VhsPile.astro';
import WhackAMole from './reusable/WhackAMole.astro';
import whackSprite from '../assets/whack-a-miku/whack-a-miku.png';
import farm from '../../content/mentor-farm.json';
import typingWords from '../../content/typing-words.json';
import githubStats from '../../content/pm/github-stats.json';
import ecchi from '../../content/lust-meter.json';
import botwStats from '../../content/botw-stats.json';
import { PIXEL_PETS } from '../lib/pixelPets';
import { PETS } from '../lib/pets';
import { MILE, totalKm, star, places, cities, EARTH_MI } from '../lib/cycling';

interface Props {
  id: string;
}
const { id } = Astro.props;
const pixelPets = PETS.filter((p) => PIXEL_PETS[p.id]);
const hours = Math.round(botwStats.hours).toLocaleString('en-US');
const trip = id === 'where-was-deo' ? await travelQuiz() : null;
---

{
  id === 'balls-farm' && (
    <>
      <blockquote class="gimmick__quote">
        <p>{farm.mantra}</p>
      </blockquote>
      <IsoFarm config={farm} saveKey="balls-farm" title="The Balls farm" />
    </>
  )
}
{
  id === 'around-the-world' && (
    <div class="gimmick__ursu" data-ursu>
      <PlanetLap
        class="gimmick__planet"
        distance={totalKm / MILE}
        circumference={EARTH_MI}
        summary={`{distance} mi${star} on the bike: {percent} of the way around the world.`}
        start={places.start.name}
        markers={cities}
        unit="mi"
        playLabel="Play the ride"
        chaserLabel="Who's that running after the bike?"
      >
        <UrsuSprite slot="chaser" />
      </PlanetLap>
      {/* Pressing the creature running after the bike (#284). */}
      <EasterEggBanner
        name="ursu-sintasus"
        image={url('/ursu-sintasus.webp')}
        imageWidth={520}
        imageHeight={438}
        imageAlt="Ursu Sintasus in Spore: a cream-white creature with moose antlers, big orange eyes, a wide smile and black-striped arms and legs."
        title="Ursu Sintasus"
        floating
      >
        <p>The explorer, (mostly) friendly race I created in Spore. They went on to conquer hundreds of planets, until the save file grew past 1.3 GB and got corrupted.</p>
        <p><a href={url('/#gamer')}>More of my games on the Gamer tab</a></p>
      </EasterEggBanner>
    </div>
  )
}
{id === 'dice-tray' && <DiceTray label="Roll the dice" />}
{id === 'dino-ambush' && <DinoAmbush saveKey="dino-ambush" />}
{id === 'ice-fishing' && <IceFlasher depth={28} saveKey="ice-fishing" />}
{id === 'drum-kit' && <DrumKit label="Virtual drum kit" />}
{id === 'ecchi-meter' && <FireMeter stages={ecchi.stages} label={ecchi.label} button="Pump the bellows" />}
{id === 'kitkot' && <KitKot name="Deovandski Skibinski Junior" handle="deovandski" bio="Author, x++ dev, chasing the algorithm" hood="kitkot-hood" />}
{id === 'led-painting' && <LedMatrix label="LED matrix to paint on. Click or drag to light LEDs; arrow keys and Space work too." />}
{id === 'paper-plane' && <PaperPlane />}
{id === 'perfect-egg' && <PerfectEgg saveKey="perfect-egg" />}
{id === 'photo-shoot' && <PhotoShoot stamp="deovandski.com" label="A photo shoot through a camera: chibi pixel Deo in his yellow king&apos;s robes holds the pose you pick, in front of the background you pick." />}
{
  id === 'pixel-pets' && (
    <div class="gimmick__pets">
      {pixelPets.map((p) => (
        <PixelPet name={p.name} saveKey={p.id} color={PIXEL_PETS[p.id].color} shapes={PIXEL_PETS[p.id].shapes} />
      ))}
    </div>
  )
}
{
  id === 'saturday-night-fever' && (
    <StageDancer saveKey="saturday-night-fever" label="Chibi pixel Deo in his yellow king&apos;s robes and crown hat, dancing the Saturday Night Fever disco point under flashing stage lights." />
  )
}
{id === 'repo-pulse' && <RepoPulse data={githubStats} label="Stats for my GitHub repos: commits, issues, pull requests, languages and when I code" />}
{id === 'terminal-typer' && <TerminalTyper words={[...typingWords.husbandoutworld, ...typingWords.deovandski]} saveKey="terminal-typer" />}
{id === 'tattoo-skin' && <DrawingPad label="Practice skin. Draw a tattoo on it with the tattoo pen." />}
{
  id === 'vhs-pile' && (
    <VhsPile hours={botwStats.hours} summary="That's {tapes} VHS tapes recorded in {mode} ({perTape} hours per T-120 tape).">
      <p>
        About <strong>{hours} hours</strong> of Best of the Worst from my YouTube watch history.
      </p>
    </VhsPile>
  )
}
{
  trip && (
    <PhotoQuiz
      class="gimmick__quiz"
      questions={trip.questions}
      answers={trip.answers}
      facts={trip.facts}
      chatter={trip.chatter}
      helperLabel="Ask Deo for a freebie: he narrows it down to two (once per game)"
      saveKey="where-was-deo"
      text={{
        alt: 'Photo {n}, from one of Deo’s trips: where was it taken?',
        hello: 'Psst! Stuck? Press me once for a freebie.',
        freebie: 'Hmm… it’s either {a} or {b}. Huehue, good luck.',
        freebieUsed: 'I already gave you my freebie! Back to hammock time.',
        freebieWait: 'Save it! Ask me while a photo is up.',
        endTop: 'Perfect! You might know my travels better than I do.',
      }}
    >
      <PixelHammock slot="helper" label="Chibi pixel Deo in his yellow king's robes and crown hat, chilling in a hammock between two palm trees. Press him for a freebie." />
    </PhotoQuiz>
  )
}
{
  id === 'whack-a-miku' && (
    <WhackAMole sprite={whackSprite} name="Miku" title="Whack-a-Miku" bonusDays={['03-09', '08-31']} spriteAlt="A pixel Miku popped up" saveKey="whack-a-miku" />
  )
}

<script>
  // Ursu Sintasus: pressing the creature that runs after the bike opens its popup. The popup moves to <body> first,
  // because the FastTab panels use transforms, which would trap a fixed layer inside them.
  document.querySelectorAll<HTMLElement>('[data-ursu]').forEach((wrap) => {
    const egg = wrap.querySelector<HTMLElement>('[data-egg]');
    if (!egg) return;
    wrap.addEventListener('planet:chaser', () => {
      if (egg.parentElement !== document.body) document.body.append(egg);
      egg.hidden = false;
    });
  });
</script>

<style>
  .gimmick__pets {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
  }
  .gimmick__planet {
    --planet-text: var(--text);
    --planet-accent: var(--teal);
    max-width: 52rem;
    margin: 0 auto;
  }
  .gimmick__quiz {
    --quiz-accent: var(--teal);
    --quiz-text: var(--text);
    --quiz-muted: var(--muted);
  }
  .gimmick__quote {
    margin: 0 0 1rem;
  }
</style>
