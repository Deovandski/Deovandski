---
import type { RankedItem } from '../lib/ranking';

interface Props {
  items: RankedItem[];
  unit?: string; // shown under each number, e.g. "hours" or "episodes"
}

const { items, unit } = Astro.props;
const TOP = 10;
const top = items.slice(0, TOP);
const rest = items.slice(TOP);
const max = Math.max(1, ...items.map((g) => g.value ?? 0));
const nf = new Intl.NumberFormat('en-US');
---

<slot />

<ol class="ranking">
  {
    top.map((g) => (
      <li class:list={{ 'no-value': g.value === null }} style={`--share:${((g.value ?? 0) / max).toFixed(3)}`}>
        <span class="rank" aria-hidden="true">{g.rank}</span>
        <div class="info">
          <h3>
            <span class="sr-only">Rank {g.rank}: </span>
            {g.name}
          </h3>
          {g.value !== null && (
            <div class="bar" aria-hidden="true">
              <span />
            </div>
          )}
        </div>
        {g.value !== null ? (
          <p class="hours">
            {nf.format(g.value)}
            <span>{unit}</span>
          </p>
        ) : (
          <p class="tag">{g.tag}</p>
        )}
      </li>
    ))
  }
</ol>

{
  rest.length > 0 && (
    <details class="more-ranks">
      <summary>See #{TOP + 1} to #{items.length}</summary>
      <ol class="ranking ranking--compact" start={TOP + 1}>
        {rest.map((g) => (
      <li class:list={{ 'no-value': g.value === null }} style={`--share:${((g.value ?? 0) / max).toFixed(3)}`}>
        <span class="rank" aria-hidden="true">{g.rank}</span>
        <div class="info">
          <h3>
            <span class="sr-only">Rank {g.rank}: </span>
            {g.name}
          </h3>
          {g.value !== null && (
            <div class="bar" aria-hidden="true">
              <span />
            </div>
          )}
        </div>
        {g.value !== null ? (
          <p class="hours">
            {nf.format(g.value)}
            <span>{unit}</span>
          </p>
        ) : (
          <p class="tag">{g.tag}</p>
        )}
      </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  :global(.ranking-lede) { margin-bottom: 1.5rem; }
  .ranking { list-style: none; margin: 0; padding: 0; }
  .more-ranks { margin-top: 0.5rem; border-top: 1px solid rgba(190, 200, 209, 0.12); }
  .more-ranks summary {
    cursor: pointer;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--teal);
  }
  .ranking--compact li { padding-block: 0.55rem; }
  .ranking--compact .rank { font-size: var(--step-1); }
  .ranking--compact .hours { font-size: var(--step-0); }
  .ranking li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 6.5rem;
    align-items: center;
    gap: 1.1rem;
    padding-block: 0.9rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
  }
  .rank {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--silver);
    text-align: right;
  }
  .ranking li:first-child .rank {
    color: var(--teal);
    text-shadow: 0 0 22px rgba(57, 197, 187, 0.6);
  }
  .ranking li:nth-child(2) .rank,
  .ranking li:nth-child(3) .rank { color: #8fded7; }
  .no-value .info h3 { margin: 0; }
  .tag {
    margin: 0;
    justify-self: end;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(190, 200, 209, 0.25);
    color: var(--silver);
    font-size: var(--step--1);
  }
  .info h3 { font-size: var(--step-0); margin: 0 0 0.45rem; }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: rgba(190, 200, 209, 0.12);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: calc(var(--share) * 100%);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--teal-deep), var(--teal));
  }
  .hours {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .hours span {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .ranking li { grid-template-columns: 2.25rem minmax(0, 1fr) 4.75rem; gap: 0.7rem; }
    .rank { font-size: var(--step-1); }
    .hours { font-size: var(--step-0); }
  }
</style>
