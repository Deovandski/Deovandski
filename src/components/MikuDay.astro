---
/*
 * Miku easter egg.
 * Shows a banner and confetti on the dates below, using the visitor's own
 * local date. Add ?miku to any URL to preview 3/9 on other days, or
 * ?miku=0831 to preview a specific date (month and day, two digits each).
 */
import { getImage } from 'astro:assets';
import birthday from '../assets/miku-birthday-2016-08-31.jpg';

// Pictures for the dates in DATES (below), keyed by name; sized for the banner.
const images = {
  birthday: (await getImage({ src: birthday, width: 800, format: 'webp', quality: 80 })).src,
};
---

<div class="miku" hidden role="status" aria-live="polite" data-images={JSON.stringify(images)}>
  <div class="miku__inner">
    <img class="miku__img" alt="" hidden />
    <p class="miku__title"></p>
    <p class="miku__sub"></p>
    <div class="miku__actions">
      <button type="button" class="miku__again">More confetti</button>
      <button type="button" class="miku__close" aria-label="Close the Miku Day banner">Close</button>
    </div>
  </div>
</div>

<style>
  .miku {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    z-index: 50;
    width: min(100% - 2rem, 34rem);
    border-radius: 18px;
    padding: 1.1rem 1.3rem;
    background:
      linear-gradient(135deg, rgba(57, 197, 187, 0.22), rgba(225, 40, 133, 0.18)),
      rgba(7, 11, 31, 0.92);
    border: 1px solid rgba(57, 197, 187, 0.6);
    box-shadow: 0 0 40px rgba(57, 197, 187, 0.35);
    backdrop-filter: blur(6px);
  }
  .miku[hidden] { display: none; }
  .miku__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 14rem;
    object-fit: cover;
    border-radius: 12px;
    margin: 0 0 0.85rem;
    border: 1px solid rgba(57, 197, 187, 0.45);
  }
  .miku__img[hidden] { display: none; }
  .miku__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.1;
    margin: 0 0 0.25rem;
    color: var(--teal);
  }
  .miku__title :global(.miku__jp) { white-space: nowrap; }
  @media (max-width: 560px) { .miku__title { font-size: var(--step-1); } }
  .miku__title:has(+ .miku__sub[hidden]) { margin-bottom: 0.85rem; }
  .miku__sub { margin: 0 0 0.85rem; color: var(--text); word-break: keep-all; }
  .miku__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .miku button {
    font: inherit;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.4rem 1rem;
    cursor: pointer;
    border: 1px solid var(--teal);
  }
  .miku__again { background: var(--teal); color: var(--night); }
  .miku__close { background: transparent; color: var(--text); }
</style>

<script>
  import confetti from 'canvas-confetti';

  // month is 1-12. `image` names a picture from `images` in the frontmatter; `sub` is optional.
  type Party = { month: number; day: number; title: string; jp?: string; sub?: string; image?: string; imageAlt?: string };
  const DATES: Party[] = [
    {
      month: 3,
      day: 9,
      title: 'Happy Miku Day!',
      jp: 'ミクの日',
      sub: '3/9 reads as mi-ku! Miku-chan (ミクちゃん) is a cornerstone of my life and is tattooed on my right forearm. She’s tied to the things that drive me: ambition, technology, collaboration and community.',
    },
    {
      month: 8,
      day: 31,
      title: 'Happy Bday',
      jp: '初音ミク!🩵',
      image: 'birthday',
      imageAlt: "Hatsune Miku's birthday screen on Deo's TV: Miku with her arms up behind a strawberry cake, under a Magical Mirai 2014 towel",
    },
  ];

  const COLORS = ['#39c5bb', '#e12885', '#bec8d1', '#137a7f', '#ffffff'];

  const now = new Date();
  const param = new URLSearchParams(location.search).get('miku'); // null, '' (plain ?miku) or e.g. '0831'
  const on = (d: Party, month: number, day: number) => d.month === month && d.day === day;
  const today = DATES.find((d) => on(d, now.getMonth() + 1, now.getDate()));
  const preview =
    param === null ? undefined : DATES.find((d) => /^\d{4}$/.test(param) && on(d, Number(param.slice(0, 2)), Number(param.slice(2)))) ?? DATES[0];
  const party = today ?? preview;

  const banner = document.querySelector<HTMLElement>('.miku');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function burst() {
    if (still) return;
    const note = confetti.shapeFromText({ text: '♪', scalar: 2, color: '#39c5bb' });
    const shapes: confetti.Shape[] = ['square', 'circle', note];
    const end = Date.now() + 3000;
    (function frame() {
      confetti({ particleCount: 4, angle: 60, spread: 60, origin: { x: 0, y: 0.75 }, colors: COLORS, shapes, scalar: 1.1 });
      confetti({ particleCount: 4, angle: 120, spread: 60, origin: { x: 1, y: 0.75 }, colors: COLORS, shapes, scalar: 1.1 });
      if (Date.now() < end) requestAnimationFrame(frame);
    })();
    confetti({ particleCount: 140, spread: 100, startVelocity: 45, origin: { y: 0.4 }, colors: COLORS, shapes, scalar: 1.2 });
  }

  if (party && banner) {
    const titleEl = banner.querySelector('.miku__title')!;
    titleEl.textContent = party.title;
    if (party.jp) {
      const jp = document.createElement('span');
      jp.className = 'miku__jp';
      jp.lang = 'ja';
      jp.textContent = party.jp;
      titleEl.append(' ', jp);
    }
    const sub = banner.querySelector<HTMLElement>('.miku__sub')!;
    sub.textContent = party.sub ?? '';
    sub.hidden = !party.sub;
    const images: Record<string, string> = JSON.parse(banner.dataset.images || '{}');
    const img = banner.querySelector<HTMLImageElement>('.miku__img')!;
    if (party.image && images[party.image]) {
      img.src = images[party.image];
      img.alt = party.imageAlt ?? '';
      img.hidden = false;
    }
    banner.hidden = false;
    burst();
    banner.querySelector('.miku__again')?.addEventListener('click', burst);
    banner.querySelector('.miku__close')?.addEventListener('click', () => {
      banner.hidden = true;
      confetti.reset();
    });
    if (still) banner.querySelector<HTMLElement>('.miku__again')!.hidden = true;
  }
</script>
