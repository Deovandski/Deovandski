---
import { Content } from '../../content/mentor.md';
---

<div class="mentor">
  <Content />
  <p class="more">More of my story in the light novel afterwords at <a href="https://husbandoutworld.com">husbandoutworld.com</a>.</p>
</div>

<style>
  .mentor { max-width: 52rem; }
  .mentor :global(.slam) {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.01em;
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    line-height: 1;
    color: var(--teal);
    text-shadow: 0 0 34px rgba(57, 197, 187, 0.45);
    margin: 0 0 0.4em;
  }
  .mentor :global(.slam + p) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 1em;
  }
  .mentor :global(h2) {
    font-size: var(--step-2);
    color: var(--text);
    margin: 2.6em 0 0.6em;
    padding-top: 1.1em;
    border-top: 1px solid rgba(225, 40, 133, 0.35);
  }
  .mentor :global(strong) { color: var(--teal); }
  .mentor :global(em) { color: var(--pink); font-style: normal; font-weight: 700; }

  .mentor :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0.2rem 0 0.2rem 1.1rem;
    border-left: 5px solid var(--pink);
  }
  .mentor :global(blockquote p) {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    line-height: 1.2;
    color: var(--text);
  }

  .mentor :global(ul) { list-style: none; margin: 0 0 1rem; padding: 0; }
  .mentor :global(ul > li) {
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(190, 200, 209, 0.1);
  }
  .mentor :global(ol) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .mentor :global(ol > li) {
    counter-increment: step;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(57, 197, 187, 0.45);
    border-radius: 999px;
    font-weight: 700;
  }
  .mentor :global(ol > li)::before {
    content: counter(step) '. ';
    color: var(--teal);
  }

  .mentor :global(.harvest li),
  .mentor :global(.mantras li) {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.25;
    border-bottom: 0;
    padding: 0.3rem 0;
  }
  .mentor :global(.harvest li) { font-size: var(--step-1); color: var(--silver); }
  .mentor :global(.harvest li:nth-child(n + 4)) { color: var(--teal); }
  .mentor :global(.mantras li) {
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    padding: 0.5rem 0 0.5rem 1rem;
    margin-bottom: 0.4rem;
    border-left: 4px solid var(--teal-deep);
  }
  .mentor :global(.newest) {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.4rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--pink);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .mentor :global(.pillars) {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0 1.5rem;
  }
  .mentor :global(.pillars h3) {
    margin: 0;
    padding: 0.9rem 0;
    font-size: var(--step-1);
    color: var(--teal);
    border-top: 1px solid rgba(190, 200, 209, 0.1);
  }
  .mentor :global(.pillars p) {
    margin: 0;
    padding: 0.9rem 0;
    border-top: 1px solid rgba(190, 200, 209, 0.1);
  }

  .mentor :global(.rapid li) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .mentor :global(.verse) {
    margin: 3rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
  }
  .mentor :global(.verse p) { margin: 0 0 0.9rem; }
  .mentor :global(.verse p:first-child) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--teal);
  }
  .mentor :global(.verse figcaption) { color: var(--muted); font-size: var(--step--1); }

  .mentor :global(.sources) {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(190, 200, 209, 0.15);
    border-radius: 14px;
  }
  .mentor :global(.sources summary) {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--silver);
  }
  .mentor :global(.sources ul) { margin-top: 0.75rem; }
  .mentor :global(.sources li) { font-size: var(--step--1); color: var(--muted); }
  .mentor :global(.sources strong) { color: var(--text); }

  .more { margin-top: 2rem; margin-bottom: 0; }

  @media (max-width: 640px) {
    .mentor :global(.pillars) { grid-template-columns: 1fr; }
    .mentor :global(.pillars h3) { padding-bottom: 0.2rem; }
    .mentor :global(.pillars p) { border-top: 0; padding-top: 0.2rem; }
  }
</style>
