---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhotoGrid from './reusable/PhotoGrid.astro';
import RouteMap from './reusable/RouteMap.astro';
import { loadGallery } from '../lib/gallery';
import { url } from '../lib/url';

// Family tab: two header photos side by side, the text from content/family/_intro.md with the
// Itaituba → Fargo map after its first paragraph, then the photos in content/family/.
// In _intro.md, [text](https://…) is a link and a line like ![alt](name) shows content/family/inline/name.jpg.
const gallery = loadGallery('content/family', 'Family photo');
const [first, ...rest] = gallery.intro;

const headerModules = import.meta.glob<ImageMetadata>('/content/family/header/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
  import: 'default',
});
const header = (name: string) => Object.entries(headerModules).find(([p]) => p.includes(`/${name}.`))?.[1];

// Pictures placed between paragraphs: ![alt](name) → content/family/inline/name.*
const inlineModules = import.meta.glob<ImageMetadata>('/content/family/inline/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
  import: 'default',
});
type Block = { kind: 'p'; html: string } | { kind: 'img'; src: ImageMetadata; alt: string };
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
function block(text: string): Block {
  const pic = /^!\[([^\]]*)\]\(([^)\s]+)\)$/.exec(text);
  if (pic) {
    const src = Object.entries(inlineModules).find(([p]) => p.includes(`/inline/${pic[2]}.`))?.[1];
    if (!src) throw new Error(`content/family/_intro.md: no picture named "${pic[2]}" in content/family/inline/`);
    return { kind: 'img', src, alt: pic[1] };
  }
  // [text](https://…) links; everything else is plain text.
  const html = escape(text).replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, (_, t, u) => `<a href="${u}">${t}</a>`);
  return { kind: 'p', html };
}
const firstBlock = first ? block(first) : null;
const restBlocks = rest.map(block);
const headers = [
  { src: header('familyHeader_1'), alt: 'An old photo of a small child and two men in an open gold mine pit of red earth in the Brazilian Amazon' },
  { src: header('familyHeader_2'), alt: 'Deo and his parents smiling at a race finish, showing their medals' },
].filter((h): h is { src: ImageMetadata; alt: string } => !!h.src);
---

{
  headers.length > 0 && (
    <div class="family-header">
      {headers.map((h) => (
        <Image src={h.src} alt={h.alt} widths={[400, 800]} sizes="(max-width: 720px) 50vw, 360px" loading="eager" />
      ))}
    </div>
  )
}

{firstBlock?.kind === 'p' && <p set:html={firstBlock.html} />}

<div class="family-map">
<RouteMap
  outlines={url('/world.json')}
  points={[
    { name: 'Itaituba, Pará', lat: -4.2761, lng: -55.9836 },
    { name: 'Fargo, North Dakota', lat: 46.8772, lng: -96.7898 },
  ]}
  bounds={[[-56, -128], [62, -32]]}
  label="Map of the Americas with a line from Itaituba, Pará, Brazil, to Fargo, North Dakota, USA"
  caption="From Itaituba, Pará, to Fargo, North Dakota."
/>
</div>

{
  restBlocks.map((b) =>
    b.kind === 'p' ? (
      <p set:html={b.html} />
    ) : (
      <figure class="family-inline">
        <Image src={b.src} alt={b.alt} widths={[360, 720]} sizes="(max-width: 720px) 80vw, 360px" />
      </figure>
    ),
  )
}

<PhotoGrid photos={gallery.photos} name="family" caption="text" />

<style>
  .family-header {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .family-header :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1237 / 1008;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid rgba(190, 200, 209, 0.15);
  }
  .family-inline { max-width: 22rem; margin: 1.5rem auto 1.75rem; }
  .family-inline :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid rgba(190, 200, 209, 0.15);
  }
  /* A tall, narrow box so the two Americas fill it. */
  .family-map { max-width: 28rem; margin: 1.5rem auto 1.75rem; }
</style>
