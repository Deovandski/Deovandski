---
import { Image } from 'astro:assets';
import { imageFor, type Sections } from '../lib/sections';

interface Props {
  data: Sections;
  id: string; // prefix for heading ids, e.g. "tattoo"
  photoAlt: (sectionTitle: string) => string;
  layout?: 'rows' | 'cards';
  slots?: number; // force this many photo boxes per section (e.g. 2 for Fishing/Camping)
  empty?: string; // shown when the file has no sections yet
  avatarsDir?: string; // show a round image (or initials) left of each item, from <dir>/<item-slug>.jpg
  sortAlpha?: boolean; // sort sections and their items A-Z (ignoring a leading "The")
  titleAbove?: boolean; // put each section's title above its photos instead of below
  noDescription?: string; // shown (muted) under a section that has no text yet
}

const { data, id, photoAlt, layout = 'rows', slots, empty, avatarsDir, sortAlpha, titleAbove, noDescription } = Astro.props;
const sortName = (n: string) => n.replace(/^the\s+/i, '').toLowerCase();
const initials = (name: string) =>
  name
    .replace(/[^\p{L}\p{N} ]/gu, '')
    .split(/\s+/)
    .filter((w) => w && !/^(the|of|and|in|a)$/i.test(w))
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('');
const { intro, sections } = data;
const ordered = sortAlpha
  ? [...sections]
      .sort((a, b) => sortName(a.title).localeCompare(sortName(b.title)))
      .map((a) => ({ ...a, items: [...a.items].sort((x, y) => sortName(x.name).localeCompare(sortName(y.name))) }))
  : sections;
const areas = ordered.map((a) => ({
  ...a,
  photos: slots ? a.photos.slice(0, slots) : a.photos, // with slots, show exactly that many photos
  hasSlot: slots ? true : a.hasSlot,
  missing: slots ? Math.max(0, slots - a.photos.length) : a.photos.length ? 0 : 1,
}));
---

{intro.map((para) => <p class="intro">{para}</p>)}

{areas.length === 0 && empty && <p class="empty">{empty}</p>}

<div class:list={['areas', `areas--${layout}`, { 'areas--pair': slots === 2 }]}>
  {
    areas.map((area) => (
      <section class:list={['area', { 'area--text': !area.hasSlot, 'area--title-above': titleAbove }]} aria-labelledby={`${id}-${area.slug}`}>
        {titleAbove && (
          <hgroup class="area__head">
            {area.kicker && <p class="kicker">{area.kicker}</p>}
            <h3 id={`${id}-${area.slug}`}>{area.title}</h3>
            {area.subtitle && <p class="subtitle">{area.subtitle}</p>}
          </hgroup>
        )}
        {area.hasSlot && (
        <div class="area__photos">
          {area.photos.map((p) => (
            <a href={p.src.src} class="photo">
              <Image src={p.src} alt={photoAlt(area.title)} width={640} widths={[320, 640]} sizes="(max-width: 720px) 100vw, 320px" />
            </a>
          ))}
          {Array.from({ length: area.missing }, () => (
            <div class="slot" aria-hidden="true">
              <span>Photo coming soon</span>
            </div>
          ))}
        </div>
        )}
        <div class="area__text">
          {!titleAbove && (
            <hgroup class="area__head">
              {area.kicker && <p class="kicker">{area.kicker}</p>}
              <h3 id={`${id}-${area.slug}`}>{area.title}</h3>
              {area.subtitle && <p class="subtitle">{area.subtitle}</p>}
            </hgroup>
          )}
          {area.intro.map((para) => <p class="area-intro">{para}</p>)}
          {noDescription && area.intro.length === 0 && area.items.length === 0 && <p class="area-intro no-desc">{noDescription}</p>}
          {area.items.length > 0 && (
          <ul>
            {area.items.map((t) => (
              <li class:list={{ 'has-avatar': !!avatarsDir }}>
                {avatarsDir && (() => {
                  const img = imageFor(avatarsDir, t.name);
                  return img ? (
                    <Image class="avatar" src={img} alt="" width={96} height={96} />
                  ) : (
                    <span class="avatar avatar--initials" aria-hidden="true">{initials(t.name)}</span>
                  );
                })()}
                {t.symbol && (
                  <span class="glyph" aria-hidden="true" lang={/[぀-ヿ一-鿿]/.test(t.symbol) ? 'ja' : undefined}>
                    {t.symbol}
                  </span>
                )}
                <div>
                  {t.vraki && (
                    <p class="vraki" aria-hidden="true">
                      {t.name}
                    </p>
                  )}
                  <p class="name">
                    {t.name}
                    {t.symbol && <span class="sr-only"> ({t.symbol})</span>}
                    {t.vraki && <span class="sr-only"> (written in Vraki)</span>}
                    {t.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </p>
                  {t.meaning.map((m) => <p class="meaning">{m}</p>)}
                </div>
              </li>
            ))}
          </ul>
          )}
        </div>
      </section>
    ))
  }
</div>

<style>
  @font-face {
    font-family: 'Vraki';
    src: url('../assets/fonts/VrakiHusbandOutWorldSeries-Rg.woff2') format('woff2');
    font-display: swap;
  }

  .areas { display: grid; gap: 0; margin-top: 1.5rem; }
  .area {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
  }
  .area--text { grid-template-columns: minmax(0, 1fr); }
  .areas--cards {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
  }
  .areas--cards .area { grid-template-columns: 1fr; gap: 0.85rem; padding: 0; border-top: 0; }
  .areas:empty { display: none; }
  .areas:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .areas--pair .area__photos { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .areas--pair .slot { aspect-ratio: 1; font-size: 0.75rem; text-align: center; padding: 0.5rem; }
  .areas--pair .photo img { aspect-ratio: 1; object-fit: cover; }
  .empty { color: var(--muted); }
  .areas--cards .area h3 { font-size: var(--step-0); margin-bottom: 0.35rem; }
  .area--title-above h3 { margin-bottom: 0; }
  /* Line up titles, photos and descriptions across a row of cards, even when a title wraps. */
  .areas--cards .area--title-above { grid-row: span 3; grid-template-rows: subgrid; }
  .no-desc { color: var(--muted); font-style: italic; }
  .area__photos { display: grid; gap: 0.75rem; align-content: start; }
  .slot {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    border: 2px dashed rgba(57, 197, 187, 0.35);
    border-radius: 14px;
    color: var(--muted);
    font-size: var(--step--1);
    background: rgba(7, 11, 31, 0.4);
  }
  .photo { display: block; line-height: 0; }
  .photo img { width: 100%; border-radius: 14px; }

  .area h3 { font-size: var(--step-1); color: var(--teal); margin-bottom: 0.75rem; }
  .area__head { margin: 0; }
  .area__head:has(.subtitle) h3 { margin-bottom: 0.15rem; }
  .kicker {
    margin: 0 0 0.2rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
    opacity: 0.85;
  }
  .subtitle { margin: 0 0 0.9rem; color: var(--silver); font-style: italic; font-size: var(--step-0); }
  .area ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .area li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0.85rem; align-items: start; }
  .area li:not(:has(.glyph)):not(.has-avatar) { grid-template-columns: minmax(0, 1fr); }
  .area li.has-avatar { grid-template-columns: 2.75rem minmax(0, 1fr); align-items: center; }
  .avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(57, 197, 187, 0.5);
  }
  .avatar--initials {
    display: grid;
    place-items: center;
    background: rgba(57, 197, 187, 0.1);
    color: var(--teal);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
  }
  .glyph {
    display: grid;
    place-items: center;
    min-height: 3rem;
    padding-inline: 0.2rem;
    border-radius: 10px;
    background: rgba(57, 197, 187, 0.1);
    border: 1px solid rgba(57, 197, 187, 0.35);
    color: var(--teal);
    font-size: 1.6rem;
    line-height: 1;
    text-align: center;
    word-break: keep-all;
  }
  .glyph:lang(ja) { font-size: 0.85rem; writing-mode: vertical-rl; padding-block: 0.35rem; }
  .name { margin: 0; font-family: var(--font-display); font-weight: 800; }
  .meaning { margin: 0.15rem 0 0; color: var(--silver); }
  .tag {
    display: table;
    margin: 0.2rem 0 0;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background: rgba(225, 40, 133, 0.16);
    border: 1px solid rgba(225, 40, 133, 0.55);
    color: #f7a8cf;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .meaning + .meaning { margin-top: 0.6rem; }
  .intro { font-size: var(--step-1); line-height: 1.45; max-width: var(--measure); }
  .area-intro { color: var(--silver); max-width: var(--measure); margin-bottom: 1rem; }
  .vraki {
    margin: 0 0 0.35rem;
    font-family: 'Vraki', var(--font-display);
    font-size: 2.2rem;
    line-height: 1.1;
    color: var(--teal);
    text-shadow: 0 0 14px rgba(57, 197, 187, 0.45);
  }

  @media (max-width: 720px) {
    .area { grid-template-columns: 1fr; gap: 1rem; }
    .slot { aspect-ratio: 16 / 7; }
  }
</style>
