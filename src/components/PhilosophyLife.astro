---
import { loadPhilosophy } from '../lib/philosophy';

const { mantras, lessons, closing, closingCredit } = loadPhilosophy();
---

<p>The mantras people who know me have heard a hundred times, and a few lessons from my light novel afterwords.</p>

<ul class="mantras">
  {
    mantras.map((m) => (
      <li class:list={{ 'is-new': m.isNew }}>
        <blockquote>{m.text}</blockquote>
        {m.isNew && <p class="mantra-note">The newest one I'm integrating into my soul.</p>}
      </li>
    ))
  }
</ul>

{
  lessons.length > 0 && (
    <>
      <h3 class="sub">From the afterwords</h3>
      <ul class="lessons">
        {lessons.map((l) => (
          <li>
            <blockquote>{l.text}</blockquote>
            {l.source && <p class="source">{l.source}</p>}
          </li>
        ))}
      </ul>
    </>
  )
}

{
  closing.length > 0 && (
    <figure class="closing">
      {closing.map((stanza, i) => (
        <p lang={i === 0 ? 'non' : undefined} class:list={{ original: i === 0 }}>
          {stanza.map((line, j) => (
            <>
              {line}
              {j < stanza.length - 1 && <br />}
            </>
          ))}
        </p>
      ))}
      {closingCredit && <figcaption>{closingCredit}</figcaption>}
    </figure>
  )
}

<p class="more">
  Read the full afterwords at <a href="https://www.husbandoutworld.com/about/afterwords/">husbandoutworld.com</a>.
</p>

<style>
  blockquote { margin: 0; }

  .mantras {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    max-width: 48rem;
  }
  .mantras blockquote {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.25;
    color: var(--text);
    padding-left: 1rem;
    border-left: 4px solid var(--teal-deep);
  }
  .mantras .is-new blockquote {
    color: var(--teal);
    border-left-color: var(--pink);
  }
  .mantra-note {
    margin: 0.35rem 0 0 1.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .sub {
    font-size: var(--step-1);
    color: var(--silver);
    margin-top: 2.5rem;
  }
  .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem 2rem;
  }
  .lessons blockquote { font-size: var(--step-0); }
  .lessons blockquote::before { content: '“'; color: var(--teal); }
  .lessons blockquote::after { content: '”'; color: var(--teal); }
  .source { margin: 0.3rem 0 0; color: var(--muted); font-size: var(--step--1); }

  .closing {
    margin: 2.75rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(190, 200, 209, 0.12);
    max-width: 36rem;
  }
  .closing p { margin: 0 0 0.9rem; }
  .closing .original {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--teal);
  }
  .closing figcaption { color: var(--muted); font-size: var(--step--1); }

  .more { margin-top: 2rem; margin-bottom: 0; }
</style>
