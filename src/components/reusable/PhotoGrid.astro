---
/**
 * PhotoGrid: a grid of square photo cards, each with an optional caption above the photo:
 * a short description, or the date the photo was taken.
 *
 * Extracted from this site's Gallery.astro (Pets, Fishing, Family) so it can be reused;
 * the date captions were added for the Painting/Drawing tab.
 *
 * Usage:
 *   ---
 *   import PhotoGrid from './reusable/PhotoGrid.astro';
 *   const photos = [
 *     { src: catJpg, alt: 'Peeta in a box' },
 *     { src: paintingJpg, alt: 'Painting', date: '2013-01-15' },  // date: ISO YYYY-MM-DD, or null if unknown
 *   ];
 *   ---
 *   <PhotoGrid photos={photos} name="cat" caption="text" empty="Photos are on their way." />
 *   <PhotoGrid photos={photos} name="painting" caption="date" />
 *
 * Opening a photo bigger is left to the page: each photo is a <button> carrying
 * data-gallery (= name), data-index, data-full (a large webp), data-alt and data-caption,
 * so one lightbox script can serve every grid on the page.
 *
 * Theme it with --photo-grid-card-border, --photo-grid-card-bg, --photo-grid-tile-bg,
 * --photo-grid-caption, --photo-grid-empty and --photo-grid-min (the narrowest a card may get).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Photo {
  src: ImageMetadata;
  alt: string; // what's in the photo, for screen readers and the "text" caption
  date?: string | null; // ISO YYYY-MM-DD the photo was taken, for the "date" caption; null = unknown
}

interface Props {
  photos: Photo[];
  name: string; // groups the photos for the page's lightbox, e.g. "cat" or "painting"
  caption?: 'text' | 'date' | 'none'; // what to show above each photo (default "none")
  intro?: string[]; // paragraphs shown above the grid
  empty?: string; // shown when there are no photos (nothing is shown without it)
  unknownDate?: string; // shown for a "date" caption when the date isn't known
  class?: string;
}

const { photos, name, caption = 'none', intro = [], empty, unknownDate = '--/--/----', class: className } = Astro.props;

// MM/DD/YYYY, or the placeholder when the date isn't known.
const formatDate = (iso?: string | null) => {
  if (!iso) return unknownDate;
  const [y, m, d] = iso.split('-');
  return `${m}/${d}/${y}`;
};

const cards = await Promise.all(
  photos.map(async (p) => {
    const dateText = formatDate(p.date);
    const spokenDate = p.date ? dateText : 'date unknown';
    return {
      ...p,
      full: (await getImage({ src: p.src, width: Math.min(1800, p.src.width), format: 'webp', quality: 80 })).src,
      label: caption === 'date' ? `${p.alt}, ${spokenDate}` : p.alt,
      dateText,
      viewerCaption: caption === 'date' ? dateText : p.alt,
    };
  }),
);
---

{intro.map((para) => <p>{para}</p>)}
{
  cards.length === 0 ? (
    empty && <p class="photo-grid__empty">{empty}</p>
  ) : (
    <ul class:list={['photo-grid', className]}>
      {cards.map((p, i) => (
        <li>
          {caption === 'text' && (
            <p class="photo-grid__caption" aria-hidden="true" title={p.alt}>
              {p.alt}
            </p>
          )}
          {caption === 'date' &&
            (p.date ? (
              <time class="photo-grid__caption photo-grid__date" datetime={p.date} aria-hidden="true">
                {p.dateText}
              </time>
            ) : (
              <p class="photo-grid__caption photo-grid__date" aria-hidden="true">
                {p.dateText}
              </p>
            ))}
          <button
            type="button"
            data-gallery={name}
            data-index={i}
            data-full={p.full}
            data-alt={p.alt}
            data-caption={p.viewerCaption}
            aria-label={`Enlarge: ${p.label}`}
          >
            <Image src={p.src} alt="" width={480} widths={[240, 480]} sizes="(max-width: 560px) 50vw, 240px" />
          </button>
        </li>
      ))}
    </ul>
  )
}

<style>
  .photo-grid__empty { color: var(--photo-grid-empty, #9aa8bb); }
  .photo-grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--photo-grid-min, 11rem), 1fr));
    gap: 1rem 0.75rem;
  }
  /* Each photo and its caption share one card, so it's always clear which caption goes with which photo.
     Subgrid lines up captions and photos across a row, even when a caption wraps. */
  .photo-grid > li {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    gap: 0.45rem;
    padding: 0.55rem 0.55rem 0.6rem;
    border: 1px solid var(--photo-grid-card-border, rgba(57, 197, 187, 0.28));
    border-radius: 16px;
    background: var(--photo-grid-card-bg, rgba(7, 11, 31, 0.55));
  }
  .photo-grid > li:not(:has(.photo-grid__caption)) { grid-row: span 1; grid-template-rows: auto; }
  .photo-grid__caption {
    margin: 0;
    align-self: center;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--photo-grid-caption, #bec8d1);
  }
  .photo-grid__date { display: block; font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  .photo-grid button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 11px;
    overflow: hidden;
    background: var(--photo-grid-tile-bg, #18224a);
    cursor: zoom-in;
    line-height: 0;
  }
  .photo-grid button:focus-visible { outline: 2px solid var(--photo-grid-caption, #bec8d1); outline-offset: 3px; }
  .photo-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .photo-grid button:hover img { filter: brightness(1.1); }
  @media (max-width: 560px) {
    .photo-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
