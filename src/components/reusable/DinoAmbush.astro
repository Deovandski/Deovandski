---
/**
 * DinoAmbush: the endless-runner dino game, reversed. A pixel dino runs on its own and dodges what it
 * sees coming (jumping over things on the ground, ducking under high birds). You throw obstacles at
 * it: cactus, bird, rock or another dino charging from behind. Mana builds one point a second from
 * the moment the game is on screen, up to a limited pool per round; once it's all earned, unspent mana
 * leaks away. Time your throws (combos land while it's still in the air) and you win; run out of mana
 * and the dino wins, and lets you know it.
 * Its own pixel dino, not Chrome's.
 *
 * Reusable on purpose: no imports, no site CSS needed, safe to use several times on a page.
 * Copy this one file into any Astro project. See README.md in this folder.
 *
 *   <DinoAmbush />
 *   <DinoAmbush pool={40} win="Got it!" lose="Out of mana!" />
 *
 * Props:
 *   pool     total mana a round can earn (one per second). Default 30.
 *   maxMana  how much mana can be held at once. Default 10.
 *   win      title when the dino goes down. Default "Winner Winner Chicken Dinner".
 *   lose     title when the mana runs out. Default "You fucking loser!".
 *
 * Theming (CSS custom properties): --dino-color (the dino, default green #4f8a3c), --dino-accent
 * (#39c5bb), --dino-ink (ground and text, #535353), --dino-bg (#f7f7f7).
 *
 * Accessible: the skills are buttons with their mana cost (keys 1 to 4 too); what happens is
 * announced (throws, dodges, the result). The game pauses when it's off screen or its tab closes.
 * Reduced motion slows the game down instead of removing it.
 */
interface Props {
  pool?: number;
  maxMana?: number;
  win?: string;
  lose?: string;
  class?: string;
}
const { pool = 30, maxMana = 10, win = 'Winner Winner Chicken Dinner', lose = 'You fucking loser!', class: className } = Astro.props;
const skills = [
  { id: 'cactus', label: 'Cactus', icon: '🌵', cost: 2, key: '1' },
  { id: 'bird', label: 'Bird', icon: '🐦', cost: 3, key: '2' },
  { id: 'rock', label: 'Rock', icon: '🪨', cost: 2, key: '3' },
  { id: 'dino', label: 'Another dino', icon: '🦖', cost: 5, key: '4' },
];
---

<div class:list={['dino-ambush', className]} data-pool={pool} data-max={maxMana} data-win={win} data-lose={lose}>
  <div class="dino-ambush__stage">
    <canvas class="dino-ambush__canvas" role="img" aria-label="A pixel dinosaur running along the ground. Throw obstacles at it."></canvas>
    <div class="dino-ambush__result" hidden>
      <p class="dino-ambush__title"></p>
      <button type="button" class="dino-ambush__again">Play again</button>
    </div>
  </div>
  <div class="dino-ambush__hud">
    <div class="dino-ambush__mana">
      <span>Mana</span>
      <div class="dino-ambush__pips" aria-hidden="true">{Array.from({ length: maxMana }, () => <i />)}</div>
      <b class="dino-ambush__mana-num">0</b>
      <small class="dino-ambush__pool"></small>
    </div>
    <div class="dino-ambush__skills" role="group" aria-label="Throw at the dino">
      {
        skills.map((s) => (
          <button type="button" data-skill={s.id} data-cost={s.cost} data-key={s.key} aria-label={`Throw ${s.label}, costs ${s.cost} mana (key ${s.key})`}>
            <span class="dino-ambush__icon" aria-hidden="true">{s.icon}</span>
            <span>{s.label}</span>
            <small aria-hidden="true">{s.cost} mana · {s.key}</small>
          </button>
        ))
      }
    </div>
  </div>
  <p class="dino-ambush__live" aria-live="polite"></p>
</div>

<style>
  .dino-ambush {
    --_accent: var(--dino-accent, #39c5bb);
    margin: 0 0 1.75rem;
  }
  .dino-ambush__stage {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: var(--dino-bg, #f7f7f7);
    border: 1px solid rgba(190, 200, 209, 0.25);
  }
  .dino-ambush__canvas {
    display: block;
    width: 100%;
    height: clamp(190px, 26vw, 240px);
    image-rendering: pixelated;
  }
  .dino-ambush__result {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4rem;
    padding-top: 0.6rem;
    color: var(--dino-ink, #535353);
    text-align: center;
  }
  .dino-ambush__result[hidden] {
    display: none;
  }
  .dino-ambush__title {
    margin: 0;
    font-family: 'Courier New', monospace;
    font-weight: 900;
    font-size: clamp(1.05rem, 3.2vw, 1.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .dino-ambush__again {
    position: absolute;
    right: 10px;
    bottom: 34px;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    border: 2px solid var(--dino-ink, #535353);
    background: #fff;
    color: var(--dino-ink, #535353);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .dino-ambush__hud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-top: 0.75rem;
  }
  .dino-ambush__mana {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }
  .dino-ambush__pips {
    display: flex;
    gap: 3px;
  }
  .dino-ambush__pips i {
    width: 12px;
    height: 16px;
    border-radius: 3px;
    background: rgba(190, 200, 209, 0.18);
  }
  .dino-ambush__pips i.on {
    background: linear-gradient(#7fe3ff, #3a7bd5);
    box-shadow: 0 0 6px rgba(80, 160, 255, 0.6);
  }
  .dino-ambush__mana small {
    font-weight: 400;
    opacity: 0.7;
  }
  .dino-ambush__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .dino-ambush__skills button {
    display: grid;
    justify-items: center;
    min-width: 76px;
    padding: 0.35rem 0.6rem;
    border-radius: 12px;
    border: 1px solid rgba(190, 200, 209, 0.3);
    background: rgba(255, 255, 255, 0.04);
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    touch-action: manipulation;
  }
  .dino-ambush__skills button small {
    font-weight: 400;
    font-size: 0.7rem;
    opacity: 0.75;
  }
  .dino-ambush__icon {
    font-size: 1.3rem;
  }
  .dino-ambush__skills button:not(:disabled):hover {
    border-color: var(--_accent);
  }
  .dino-ambush__skills button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .dino-ambush__skills button:focus-visible,
  .dino-ambush__again:focus-visible {
    outline: 2px solid var(--_accent);
    outline-offset: 2px;
  }
  .dino-ambush__live {
    min-height: 1.4em;
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  @media (max-width: 560px) {
    .dino-ambush__skills {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      width: 100%;
    }
    .dino-ambush__skills button {
      min-width: 0;
    }
  }
</style>

<script>
  // Sprites as text: '#' body, 'e' eye white, 'k' black, 'x' a cross for an eye, 't' a tear. Facing right.
  const RUN_A = [
    '........######..',
    '.......##e######',
    '.......#########',
    '.......#########',
    '.......#####....',
    '.......#######..',
    '#.....#####.....',
    '#....######.....',
    '##..########....',
    '###########.#...',
    '.##########.....',
    '..########......',
    '...######.......',
    '....###.##......',
    '....##...#......',
    '....#....##.....',
  ];
  const RUN_B = [...RUN_A.slice(0, 13), '....##.##.......', '.....#..##......', '.....##.........'];
  const DEAD = RUN_A.map((r, i) => (i === 1 ? '.......##x######' : i === 3 ? '.......#####kk##' : r));
  const SAD = RUN_A.map((r, i) => (i === 1 ? '.......##x######' : i === 2 ? '.......#t#######' : i === 3 ? '.......##t##kk##' : r));
  // The dino's reply when you run out of mana: one arm up, middle finger out.
  const FLIP = [
    '.............#..',
    '.............#..',
    '............###.',
    '........#####...',
    '.......##e####..',
    '.......########.',
    '.......########.',
    '.......#####.#..',
    '.......#######..',
    '#.....#####.##..',
    '#....######.#...',
    '##..#######.....',
    '###########.....',
    '.##########.....',
    '..########......',
    '...######.......',
    '....##.##.......',
    '....##..##......',
  ];
  const CACTUS = ['..##..', '..##.#', '#.##.#', '#.####', '####..', '..##..', '..##..', '..##..', '..##..'];
  const BIRD_A = ['..#......', '.##......', '#########', '..######.', '...##....', '.........'];
  const BIRD_B = ['.........', '.........', '#########', '..######.', '..##.....', '.##......'];
  const ROCK = ['..###..', '.#####.', '#######', '#######', '.#####.'];

  type Kind = 'cactus' | 'bird' | 'rock' | 'dino';
  type Ob = { kind: Kind; x: number; y: number; w: number; h: number; vx: number; high?: boolean; seen: boolean; plan?: number; plan2?: number };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NAMES: Record<Kind, string> = { cactus: 'a cactus', bird: 'a bird', rock: 'a rock', dino: 'another dino' };

  document.querySelectorAll<HTMLElement>('.dino-ambush').forEach((root) => {
    const POOL = Number(root.dataset.pool) || 30;
    const MAX = Number(root.dataset.max) || 10;
    const canvas = root.querySelector<HTMLCanvasElement>('.dino-ambush__canvas')!;
    const ctx = canvas.getContext('2d')!;
    const live = root.querySelector<HTMLElement>('.dino-ambush__live')!;
    const pips = Array.from(root.querySelectorAll<HTMLElement>('.dino-ambush__pips i'));
    const manaNum = root.querySelector<HTMLElement>('.dino-ambush__mana-num')!;
    const poolEl = root.querySelector<HTMLElement>('.dino-ambush__pool')!;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-skill]'));
    const result = root.querySelector<HTMLElement>('.dino-ambush__result')!;
    const title = root.querySelector<HTMLElement>('.dino-ambush__title')!;
    const ink = getComputedStyle(root).getPropertyValue('--dino-ink').trim() || '#535353';
    const DINO = getComputedStyle(root).getPropertyValue('--dino-color').trim() || '#4f8a3c'; // our dino is green

    let W = 0;
    let H = 0;
    let P = 3; // size of one sprite pixel
    let ground = 0;
    let speed = 0; // ground speed, px per second
    let obs: Ob[] = [];
    let mana = 0;
    let earned = 0;
    let manaClock = 0;
    let leak = 0;
    let state: 'play' | 'won' | 'lost' = 'play';
    let t = 0;
    let last = 0;
    let running = false;
    // The dino: y is its height above the ground (0 = on the ground).
    const dino = { y: 0, vy: 0, duck: 0, x: 0 };
    let scrollX = 0;

    function size() {
      const r = canvas.getBoundingClientRect();
      if (!r.width) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.imageSmoothingEnabled = false;
      P = H >= 200 ? 3 : 2.5;
      ground = H - 26;
      dino.x = Math.max(40, W * 0.12);
      speed = Math.max(220, W * 0.32) * (reduced ? 0.7 : 1);
      return true;
    }

    function sprite(rows: string[], x: number, y: number, color = DINO, scale = 1) {
      const p = P * scale;
      rows.forEach((row, j) =>
        [...row].forEach((ch, i) => {
          if (ch === '.') return;
          ctx.fillStyle = ch === 'e' ? '#fff' : ch === 'k' || ch === 'x' ? '#222' : ch === 't' ? '#3a8fd8' : color;
          ctx.fillRect(x + i * p, y + j * p, p + 0.5, p + 0.5);
        }),
      );
    }

    // Mana: one point a second while the game is on screen, until the round's pool is spent.
    function renderMana() {
      pips.forEach((p, i) => p.classList.toggle('on', i < mana));
      manaNum.textContent = String(mana);
      poolEl.textContent = earned < POOL ? `${POOL - earned} more to earn` : 'leaking away: use it!';
      buttons.forEach((b) => (b.disabled = state !== 'play' || mana < Number(b.dataset.cost)));
    }

    function throwIt(kind: Kind) {
      if (state !== 'play') return;
      const btn = buttons.find((b) => b.dataset.skill === kind)!;
      const cost = Number(btn.dataset.cost);
      if (mana < cost) return;
      mana -= cost;
      const s = P;
      if (kind === 'cactus') obs.push({ kind, x: W + 10, y: 0, w: 6 * s, h: 9 * s, vx: -speed, seen: false });
      if (kind === 'rock') obs.push({ kind, x: W + 10, y: 0, w: 7 * s, h: 5 * s, vx: -speed * 1.7, seen: false });
      if (kind === 'bird') {
        const high = Math.random() < 0.5;
        // High birds fly at head height (duck under them); low ones skim the ground (jump them).
        obs.push({ kind, x: W + 10, y: high ? 12 * s : 2 * s, w: 9 * s, h: 6 * s, vx: -speed * 1.15, high, seen: false });
      }
      if (kind === 'dino') obs.push({ kind, x: -20 * s, y: 0, w: 16 * s, h: 16 * s, vx: speed * 0.75, seen: false });
      live.textContent = `You threw ${NAMES[kind]}.`;
      renderMana();
    }

    // The dino's brain: it times each jump so the top of the arc is over the middle of the obstacle,
    // with a little reaction noise and the odd fumble. Two ground obstacles close together: it usually
    // takes one big jump over both. It can't jump again mid-air, so well-timed combos still get it.
    const G = 1900;
    const jumpV = () => Math.sqrt(2 * G * 22 * P);
    function think() {
      if (dino.y > 0.5) return;
      const center = dino.x + 8.5 * P;
      const threats = obs
        .filter((o) => !o.seen)
        .map((o) => ({ o, t: o.vx < 0 ? (o.x + o.w / 2 - center) / -o.vx : (center - (o.x + o.w / 2)) / o.vx }))
        .filter((x) => x.t > -0.05)
        .sort((a, b) => a.t - b.t);
      const first = threats[0];
      if (!first) return;
      const o = first.o;
      if (o.plan === undefined) {
        const noise = o.kind === 'dino' ? 0.16 : o.kind === 'rock' ? 0.07 : 0.04;
        o.plan = (Math.random() - 0.5) * noise;
      }
      if (o.kind === 'bird' && o.high) {
        // Duck when it's close, long enough for it to pass overhead.
        if (first.t < 0.3 + o.plan) {
          o.seen = true;
          if (Math.random() < 0.03) return; // froze
          dino.duck = (o.w + 11 * P) / Math.abs(o.vx) + 0.3;
        }
        return;
      }
      const ground = (x: Ob) => !(x.kind === 'bird' && x.high) && x.vx < 0;
      const pair = threats.find((x) => x.o !== o && ground(o) && ground(x.o) && x.o.x > o.x && x.o.x - o.x < 36 * P);
      const big = pair && (o.plan2 ??= Math.random() < 0.8 ? 1 : 0) === 1;
      const power = big ? 1.35 : 1;
      const air = (2 * jumpV() * power) / G;
      const target = big ? (first.t + pair!.t) / 2 : first.t;
      if (target < air / 2 + o.plan) {
        o.seen = true;
        if (big) pair!.o.seen = true;
        if (Math.random() < (o.kind === 'dino' ? 0.12 : 0.03)) return; // fumbled it
        jump(power);
      }
    }
    function jump(power = 1) {
      if (dino.y > 0.5) return;
      dino.vy = jumpV() * power;
    }

    function hit(o: Ob) {
      const dx = dino.x + 3 * P;
      const dw = 11 * P;
      const dh = dino.duck > 0 ? 9 * P : 15 * P;
      const dy0 = ground - dino.y - dh;
      const oy1 = ground - o.y;
      const oy0 = oy1 - o.h;
      const pad = P;
      return dx < o.x + o.w - pad && dx + dw > o.x + pad && dy0 < oy1 - pad && dy0 + dh > oy0 + pad;
    }

    function finish(kind: 'won' | 'lost') {
      state = kind;
      title.textContent = kind === 'won' ? root.dataset.win! : root.dataset.lose!;
      result.hidden = false;
      live.textContent = kind === 'won' ? `${root.dataset.win}! You took the dino down.` : `${root.dataset.lose} The dino survived and flips you off.`;
      renderMana();
    }

    function step(dt: number) {
      t += dt;
      if (state === 'play') {
        manaClock += dt;
        while (manaClock >= 1) {
          manaClock -= 1;
          if (earned < POOL) {
            earned++;
            mana = Math.min(MAX, mana + 1);
          } else if (mana > 0 && (leak = (leak + 1) % 2) === 0) {
            // Use it or lose it: once the round's mana is all earned, what's left leaks away.
            mana--;
          }
          renderMana();
        }
        scrollX += speed * dt;
        think();
        dino.vy -= G * dt;
        dino.y = Math.max(0, dino.y + dino.vy * dt);
        if (dino.y === 0) dino.vy = Math.max(0, dino.vy);
        dino.duck = Math.max(0, dino.duck - dt);
        for (const o of obs) {
          o.x += o.vx * dt;
          if (o.kind === 'dino') o.x += 0; // charges from behind
          if (hit(o)) return finish('won');
        }
        const before = obs.length;
        obs = obs.filter((o) => o.x > -40 * P && o.x < W + 60);
        if (obs.length < before) live.textContent = 'The dino dodged it.';
        // Lost: the pool is spent, there's not enough mana for anything, and nothing is left in flight.
        const cheapest = Math.min(...buttons.map((b) => Number(b.dataset.cost)));
        if (earned >= POOL && mana < cheapest && obs.length === 0) finish('lost');
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      // Ground line with little pebbles scrolling by.
      ctx.fillStyle = ink;
      ctx.fillRect(0, ground, W, 2);
      for (let i = 0; i < W / 30 + 2; i++) {
        const x = ((i * 53 - scrollX * (state === 'play' ? 1 : 0)) % (W + 60) + W + 60) % (W + 60) - 30;
        ctx.fillRect(x, ground + 6 + (i % 3) * 4, (i % 2) + 2, 2);
      }
      for (const o of obs) {
        const top = ground - o.y - o.h;
        if (o.kind === 'cactus') sprite(CACTUS, o.x, top, '#3f7d3a');
        if (o.kind === 'rock') sprite(ROCK, o.x, top, '#8a8f98');
        if (o.kind === 'bird') sprite(Math.floor(t * 6) % 2 ? BIRD_A : BIRD_B, o.x, top, '#6b6f78');
        if (o.kind === 'dino') sprite(Math.floor(t * 10) % 2 ? RUN_A : RUN_B, o.x, top, '#a0622d');
      }
      const x = dino.x;
      if (state === 'won') {
        // Big and sad under the title, left of the Play again button.
        sprite(SAD, Math.max(8, W * 0.36 - 16 * P), ground - 32 * P, DINO, 2);
      } else if (state === 'lost') {
        sprite(FLIP, Math.max(8, W * 0.36 - 16 * P), ground - 36 * P, DINO, 2);
      } else if (dino.duck > 0 && dino.y === 0) {
        // Ducking: squash the sprite down.
        ctx.save();
        ctx.translate(0, ground);
        ctx.scale(1.15, 0.6);
        sprite(Math.floor(t * 10) % 2 ? RUN_A : RUN_B, x / 1.15, -16 * P);
        ctx.restore();
      } else {
        sprite(dino.y > 0 ? RUN_A : Math.floor(t * 10) % 2 ? RUN_A : RUN_B, x, ground - 16 * P - dino.y);
      }
    }

    function frame(now: number) {
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      // Paused while off screen or while its tab is closed.
      if (root.offsetParent && document.visibilityState === 'visible') step(dt);
      draw();
      requestAnimationFrame(frame);
    }

    function reset() {
      obs = [];
      mana = 0;
      earned = 0;
      manaClock = 0;
      leak = 0;
      state = 'play';
      dino.y = 0;
      dino.vy = 0;
      dino.duck = 0;
      result.hidden = true;
      live.textContent = 'Mana is building. Throw something at the dino!';
      renderMana();
    }

    function startLoop() {
      if (running || !size()) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    }

    for (const b of buttons) b.addEventListener('click', () => throwIt(b.dataset.skill as Kind));
    root.querySelector('.dino-ambush__again')!.addEventListener('click', () => {
      reset();
      buttons[0].focus();
    });
    document.addEventListener('keydown', (ev) => {
      if (!root.offsetParent || ev.repeat || ev.ctrlKey || ev.metaKey || ev.altKey) return;
      if ((ev.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
      const b = buttons.find((x) => x.dataset.key === ev.key);
      if (b) {
        throwIt(b.dataset.skill as Kind);
        ev.preventDefault();
      }
    });
    // Starts (and mana starts building) the first time the game is on screen.
    new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) startLoop();
    }).observe(canvas);
    new ResizeObserver(() => {
      if (running) size();
    }).observe(canvas);
    reset();
  });
</script>
