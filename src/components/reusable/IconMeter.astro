---
/**
 * IconMeter: shows a quantity as a row of icons, with the last one partly filled.
 * 650 lb of beef at 500 lb per cow is 1.3 cows: one full cow and a third of one.
 *
 * Reusable on purpose: no imports, no site CSS needed, safe to use several times on a page.
 * Copy this one file into any Astro project. See README.md in this folder.
 *
 *   <IconMeter value={650} per={500} icon="🐄" unit="cow" units="cows" label="Cow-meter" />
 *   <IconMeter value={7} per={2} icon="🍕" unit="pizza" units="pizzas" />
 *
 * Icons fill in from left to right the first time the meter scrolls into view (skipped for
 * people who prefer reduced motion).
 */
interface Props {
  /** The amount, e.g. pounds of beef. */
  value: number;
  /** How much one icon stands for, e.g. pounds of beef per cow. */
  per: number;
  /** The icon: an emoji or a single character. */
  icon: string;
  /** Singular and plural names for one icon's worth, used in the readout. */
  unit: string;
  units?: string;
  /** Small heading above the icons. */
  label?: string;
  /** Extra line under the readout (e.g. how `per` was worked out). */
  note?: string;
  /** Decimal places in the readout. */
  decimals?: number;
  /** Most icons to draw; beyond that the readout still tells the full number. */
  maxIcons?: number;
  class?: string;
}

const { value, per, icon, unit, units = `${unit}s`, label, note, decimals = 1, maxIcons = 40, class: className } = Astro.props;
const amount = per > 0 ? value / per : 0;
const shown = Math.min(amount, maxIcons);
const icons = Array.from({ length: Math.ceil(shown) || 1 }, (_, i) => Math.max(0, Math.min(1, shown - i)));
const readout = amount.toFixed(decimals).replace(/\.0+$/, '');
const name = Number(readout) === 1 ? unit : units;
---

<figure class:list={['icon-meter', className]} data-icon-meter>
  {label && <p class="icon-meter__label">{label}</p>}
  <div class="icon-meter__icons" role="img" aria-label={`${readout} ${name}`}>
    {
      icons.map((fill) => (
        <span class="icon-meter__icon" aria-hidden="true" style={`--fill: ${fill}`}>
          <span class="icon-meter__ghost">{icon}</span>
          <span class="icon-meter__full">{icon}</span>
        </span>
      ))
    }
  </div>
  <figcaption class="icon-meter__readout">
    <strong>≈ {readout}</strong> {name}
    {note && <span class="icon-meter__note">{note}</span>}
  </figcaption>
</figure>

<style>
  /* Theme from outside: .x :global(.icon-meter) { --icon-meter-size: 4rem; } */
  .icon-meter {
    --icon-meter-size: clamp(2.6rem, 8vw, 3.6rem);
    --icon-meter-ghost: 0.18;
    --icon-meter-accent: inherit;
    --icon-meter-muted: rgba(127, 127, 127, 0.95);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin: 0;
    text-align: center;
  }
  .icon-meter__label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--icon-meter-muted);
  }
  .icon-meter__icons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem; }
  .icon-meter__icon {
    position: relative;
    display: inline-block;
    font-size: var(--icon-meter-size);
    line-height: 1.1;
  }
  .icon-meter__ghost { opacity: var(--icon-meter-ghost); filter: grayscale(1); }
  .icon-meter__full {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc((1 - var(--fill)) * 100%) 0 0);
    transition: clip-path 0.9s ease-out;
  }
  .icon-meter.is-waiting .icon-meter__full { clip-path: inset(0 100% 0 0); }
  .icon-meter__readout { font-size: 1.05rem; }
  .icon-meter__readout strong { color: var(--icon-meter-accent); font-size: 1.35em; }
  .icon-meter__note { display: block; margin-top: 0.35rem; font-size: 0.8rem; color: var(--icon-meter-muted); }
  @media (prefers-reduced-motion: reduce) {
    .icon-meter__full { transition: none; }
  }
</style>

<script>
  // Fill the icons in the first time each meter is seen.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        seen.unobserve(e.target);
        requestAnimationFrame(() => e.target.classList.remove('is-waiting'));
      }
    }, { threshold: 0.5 });
    document.querySelectorAll<HTMLElement>('[data-icon-meter]').forEach((m) => {
      m.classList.add('is-waiting');
      seen.observe(m);
    });
  }
</script>
