---
/**
 * HoursPie: a pie of hours (or any amount) by category. Pressing a slice, or its row in the list
 * beside it, opens that category's items. Built for the Gamer tab (#252), next to HoursByCategory.
 *
 *   <HoursPie
 *     id="games-pie"
 *     categories={[
 *       { id: 'rpg', name: 'RPGs', color: '#3987e5', value: 4935, items: [{ name: 'Skyrim', value: 372 }] },
 *       { id: 'idle', name: 'Idle', color: '#d55181', value: 19668, excludable: true, items: [] },
 *     ]}
 *   />
 *
 * Every slice, percent and list is worked out when the site builds, both with and without the
 * `excludable` categories; the script only flips which is shown, so translated pages need nothing
 * extra. Inside an element with `data-hours-scope` (HoursByCategory's root), it follows that
 * element's `data-excluded` attribute and its `hours:excluded` event; elsewhere, `excluded` sets it.
 * Colour is never the only cue: every slice has its row, with name, hours and percent.
 *
 * Reusable on purpose: no imports, safe to use several times on a page. Theming (CSS custom
 * properties, with fallbacks): --pie-surface, --pie-border, --pie-text, --pie-muted, --pie-accent.
 */
interface Item {
  name: string;
  value: number;
  estimated?: boolean;
  chips?: string[];
}
interface Category {
  id: string;
  name: string;
  color: string;
  value: number;
  excludable?: boolean;
  items: Item[];
  parts?: { name: string; value: number; count: number }[];
}
interface Props {
  categories: Category[];
  id?: string;
  /** Start without the excludable categories (when not inside a data-hours-scope). */
  excluded?: boolean;
  unit?: string;
  /** Read by screen readers for the pie itself; {list} is "name share, …". */
  label?: string;
  hint?: string;
  backLabel?: string;
  /** {share} is the category's percent. */
  shareLabel?: string;
  /** {n} is the number of items. */
  countLabel?: string;
  countLabelOne?: string;
  /** {n} is how many items aren't listed. */
  moreLabel?: string;
  /** Items listed when a category is open. */
  shown?: number;
  estimatedMark?: string;
  estimatedLabel?: string;
  chipColors?: Record<string, string>;
  locale?: string;
  class?: string;
}
const {
  categories,
  id = 'pie',
  excluded = false,
  unit = 'h',
  label = 'Pie chart of hours by category: {list}',
  hint = 'Press a slice or a row to see its items.',
  backLabel = '← All categories',
  shareLabel = '{share} of the total',
  countLabel = '{n} items',
  countLabelOne,
  moreLabel = '+ {n} more',
  shown = 12,
  estimatedMark = '*',
  estimatedLabel = 'estimated',
  chipColors = {},
  locale = 'en-US',
  class: className,
} = Astro.props;

const nf = new Intl.NumberFormat(locale);
const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (m, k) => (k in v ? String(v[k]) : m));
const C = 210, R = 200;
const hasExcludable = categories.some((c) => c.excludable);
const pct = (part: number, whole: number) => {
  const p = whole > 0 ? Math.round((part / whole) * 100) : 0;
  return p === 0 && part > 0 ? '<1%' : `${p}%`;
};
// One state of the pie: every category, or only those that aren't excludable.
function state(list: Category[]) {
  const sum = list.reduce((s, c) => s + c.value, 0);
  let a = -Math.PI / 2;
  return list.map((c) => {
    const sweep = sum ? (c.value / sum) * Math.PI * 2 : 0;
    const mid = a + sweep / 2;
    const p = (ang: number) => [C + R * Math.cos(ang), C + R * Math.sin(ang)].map((n) => n.toFixed(2)).join(' ');
    const d =
      list.length === 1
        ? `M ${C - R} ${C} a ${R} ${R} 0 1 0 ${2 * R} 0 a ${R} ${R} 0 1 0 ${-2 * R} 0`
        : `M ${C} ${C} L ${p(a)} A ${R} ${R} 0 ${sweep > Math.PI ? 1 : 0} 1 ${p(a + sweep)} Z`;
    const share = pct(c.value, sum);
    const slice = {
      ...c,
      d,
      share,
      shareText: fill(shareLabel, { share }),
      dx: (14 * Math.cos(mid)).toFixed(1),
      dy: (14 * Math.sin(mid)).toFixed(1),
      lx: (C + R * 0.66 * Math.cos(mid)).toFixed(1),
      ly: (C + R * 0.66 * Math.sin(mid)).toFixed(1),
      showPct: sum ? c.value / sum >= 0.045 : false,
    };
    a += sweep;
    return slice;
  });
}
const states = [{ key: 'on', slices: state(categories) }];
if (hasExcludable) states.push({ key: 'off', slices: state(categories.filter((c) => !c.excludable)) });
const ariaFor = (slices: ReturnType<typeof state>) => fill(label, { list: slices.map((s) => `${s.name} ${s.share}`).join(', ') });
const details = categories.map((c) => ({
  ...c,
  hours: `${nf.format(c.value)} ${unit}`,
  count: fill(c.items.length === 1 && countLabelOne ? countLabelOne : countLabel, { n: nf.format(c.items.length) }),
  shareOn: states[0].slices.find((s) => s.id === c.id)!.shareText,
  shareOff: states[1]?.slices.find((s) => s.id === c.id)?.shareText,
  rows: c.parts
    ? c.parts.map((p) => ({ name: p.name, hours: `${nf.format(p.value)} ${unit}`, sub: fill(p.count === 1 && countLabelOne ? countLabelOne : countLabel, { n: nf.format(p.count) }), chips: [] as string[], estimated: false }))
    : c.items.slice(0, c.items.length === shown + 1 ? shown + 1 : shown).map((i) => ({ name: i.name, hours: `${nf.format(i.value)} ${unit}`, sub: '', chips: i.chips ?? [], estimated: !!i.estimated })),
  more: c.parts || c.items.length <= shown + 1 ? '' : fill(moreLabel, { n: nf.format(c.items.length - shown) }),
}));
---

<div class:list={['pie', className]} id={id} data-hours-pie data-state={excluded && hasExcludable ? 'off' : 'on'}>
  <div class="pie__chart">
    {
      states.map((st) => (
        <svg class={`pie__svg pie__${st.key}`} viewBox="0 0 420 420" role="img" aria-label={ariaFor(st.slices)}>
          {st.slices.map((s) => (
            <path class="pie__slice" d={s.d} fill={s.color} data-cat={s.id} style={`--dx: ${s.dx}px; --dy: ${s.dy}px`} />
          ))}
          {st.slices
            .filter((s) => s.showPct)
            .map((s) => (
              <text class="pie__pct" x={s.lx} y={s.ly} data-cat={s.id} aria-hidden="true">
                {s.share}
              </text>
            ))}
        </svg>
      ))
    }
  </div>
  <div class="pie__side">
    <div class="pie__list" data-pie-list>
      <p class="pie__hint">{hint}</p>
      {
        states.map((st) => (
          <ul class={`pie__rows pie__${st.key}`}>
            {st.slices.map((s) => (
              <li>
                <button type="button" class="pie__row" data-cat={s.id} aria-controls={`${id}-${s.id}`}>
                  <span class="pie__swatch" style={`background: ${s.color}`} />
                  <span class="pie__name">{s.name}</span>
                  <span class="pie__hours">{`${nf.format(s.value)} ${unit}`}</span>
                  <span class="pie__share">{s.share}</span>
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    {
      details.map((c) => (
        <section class="pie__detail" id={`${id}-${c.id}`} data-detail={c.id} aria-label={c.name} hidden>
          <button type="button" class="pie__back" data-pie-back>
            {backLabel}
          </button>
          <h4 class="pie__title">
            <span class="pie__swatch pie__swatch--big" style={`background: ${c.color}`} />
            <span>{c.name}</span>
          </h4>
          <p class="pie__meta">
            <span>{c.hours}</span> · <span class="pie__on">{c.shareOn}</span>
            {c.shareOff && <span class="pie__off">{c.shareOff}</span>} · <span>{c.count}</span>
          </p>
          <ol class="pie__items">
            {c.rows.map((r) => (
              <li>
                <span class="pie__item-name">
                  <span>{r.name}</span>
                  {r.chips.map((chip) => (
                    <span class="pie__chip" style={chipColors[chip] ? `--_chip: ${chipColors[chip]}` : undefined}>
                      {chip}
                    </span>
                  ))}
                  {r.sub && <span class="pie__sub">{r.sub}</span>}
                </span>
                <span class="pie__item-hours">
                  <span>{r.hours}</span>
                  {r.estimated && (
                    <>
                      <span aria-hidden="true">{estimatedMark}</span>
                      <span class="pie__sr">{estimatedLabel}</span>
                    </>
                  )}
                </span>
              </li>
            ))}
          </ol>
          {c.more && <p class="pie__more">{c.more}</p>}
        </section>
      ))
    }
  </div>
</div>

<script>
  function initHoursPie() {
    document.querySelectorAll<HTMLElement>('[data-hours-pie]').forEach((root) => {
      if (root.dataset.pieReady) return;
      root.dataset.pieReady = '1';
      const list = root.querySelector<HTMLElement>('[data-pie-list]')!;
      const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
      const marks = () => root.querySelectorAll<SVGElement>('.pie__slice, .pie__pct, .pie__row');
      let open: string | null = null;
      const show = (cat: string | null, focus = false) => {
        open = cat;
        list.hidden = !!cat;
        details.forEach((d) => (d.hidden = d.dataset.detail !== cat));
        root.classList.toggle('is-open', !!cat);
        marks().forEach((m) => m.classList.toggle('is-picked', m.getAttribute('data-cat') === cat));
        if (focus) (cat ? root.querySelector<HTMLElement>(`[data-detail="${cat}"] [data-pie-back]`) : root.querySelector<HTMLElement>('.pie__row'))?.focus();
      };
      const hover = (cat: string | null) => {
        root.classList.toggle('is-hovering', !!cat);
        marks().forEach((m) => m.classList.toggle('is-hover', m.getAttribute('data-cat') === cat));
      };
      root.querySelectorAll<SVGPathElement>('.pie__slice').forEach((s) => {
        s.addEventListener('click', () => show(open === s.dataset.cat ? null : s.dataset.cat!));
        s.addEventListener('pointerenter', () => hover(s.dataset.cat!));
        s.addEventListener('pointerleave', () => hover(null));
      });
      root.querySelectorAll<HTMLButtonElement>('.pie__row').forEach((b) => {
        b.addEventListener('click', () => show(b.dataset.cat!, true));
        b.addEventListener('pointerenter', () => hover(b.dataset.cat!));
        b.addEventListener('pointerleave', () => hover(null));
        b.addEventListener('focus', () => hover(b.dataset.cat!));
        b.addEventListener('blur', () => hover(null));
      });
      root.querySelectorAll<HTMLButtonElement>('[data-pie-back]').forEach((b) => b.addEventListener('click', () => show(null, true)));
      // Follow an enclosing switch (HoursByCategory) that takes excludable categories out.
      const scope = root.closest<HTMLElement>('[data-hours-scope]');
      if (scope) {
        const sync = () => {
          root.dataset.state = scope.hasAttribute('data-excluded') && root.querySelector('.pie__off') ? 'off' : 'on';
          if (open && !root.querySelector(`.pie__${root.dataset.state} [data-cat="${open}"]`)) show(null);
        };
        sync();
        scope.addEventListener('hours:excluded', sync);
      }
    });
  }
  initHoursPie();
  document.addEventListener('astro:page-load', initHoursPie);
</script>

<style>
  .pie {
    --_surface: var(--pie-surface, #0e1636);
    --_border: var(--pie-border, #18224a);
    --_text: var(--pie-text, #e6edf3);
    --_muted: var(--pie-muted, #9aa8bb);
    --_accent: var(--pie-accent, #39c5bb);
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    color: var(--_text);
  }
  @media (max-width: 720px) {
    .pie {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pie[data-state='on'] .pie__off,
  .pie[data-state='off'] .pie__on {
    display: none;
  }
  .pie__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pie__slice {
    stroke: var(--_surface);
    stroke-width: 2;
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .pie.is-hovering .pie__slice:not(.is-hover),
  .pie.is-open .pie__slice:not(.is-picked) {
    opacity: 0.35;
  }
  .pie__slice.is-picked,
  .pie__pct.is-picked {
    transform: translate(var(--dx, 0), var(--dy, 0));
  }
  .pie__pct {
    fill: #070b1f;
    font-size: 15px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
  }
  .pie__hint,
  .pie__meta,
  .pie__more {
    margin: 0 0 0.5rem;
    color: var(--_muted);
    font-size: 0.875rem;
  }
  .pie__rows,
  .pie__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pie__row {
    width: 100%;
    min-height: 44px;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto 3.2rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .pie__row.is-hover,
  .pie__row:focus-visible {
    background: var(--_surface);
    border-color: var(--_border);
  }
  .pie__row:focus-visible,
  .pie__back:focus-visible {
    outline: 2px solid var(--_accent);
    outline-offset: 2px;
  }
  .pie__swatch {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .pie__swatch--big {
    width: 16px;
    height: 16px;
  }
  .pie__name {
    font-weight: 600;
  }
  .pie__hours,
  .pie__item-hours {
    color: var(--_muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pie__share {
    color: var(--_muted);
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  .pie__back {
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 22px;
    border: 1px solid var(--_border);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .pie__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.75rem 0 0.25rem;
    font-size: 1.35rem;
  }
  .pie__items li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--_border);
  }
  .pie__item-name {
    font-weight: 600;
  }
  .pie__sub {
    display: block;
    color: var(--_muted);
    font-weight: 400;
    font-size: 0.8rem;
  }
  .pie__chip {
    --_c: var(--_chip, var(--_accent));
    display: inline-block;
    margin-inline-start: 0.4rem;
    padding: 0 0.45rem;
    border-radius: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--_c) 60%, transparent);
    background: color-mix(in srgb, var(--_c) 16%, transparent);
    color: var(--_c);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.5;
    vertical-align: 0.1em;
  }
  .pie__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .pie__slice {
      transition: none;
    }
  }
</style>
