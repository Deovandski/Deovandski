---
/**
 * LinksMenu: a drop-down box of link buttons, opened by one "Links" button, like a tab's ▶ Play box.
 * The box is built from `items`: groups of buttons, and separators (a line, optionally with a centred
 * heading) between them. Built for the Gamer tab (#252); the standard for every tab's links (#260).
 *
 *   <LinksMenu
 *     id="gamer-links"
 *     items={[
 *       { links: [{ href: 'https://steamcommunity.com/id/me', label: 'My profile on Steam' }] },
 *       { separator: 'Third party trackers' },
 *       { style: 'secondary', links: [{ href: 'https://truesteamachievements.com/gamer/me', label: 'TrueSteamAchievements' }] },
 *     ]}
 *   />
 *
 * items, in order:
 *   { links: [{ href, label }], style?: 'primary' | 'secondary' }   a row of buttons (primary: filled,
 *                                                                    the default; secondary: outlined)
 *   { separator: 'Heading' } or { separator: true }                  a line, with or without a heading
 *
 * Two ways to open it:
 *   toggle="own" (default)  the component draws its own Links button. The button and the box sit in the
 *                           parent's flex row (the root is `display: contents`); the box takes a line of
 *                           its own under the row.
 *   toggle="external"       no button: the page has its own (on this site, the Links button in the tab's
 *                           title row, right of ▶ Play). Any button with `data-links-toggle="<id>-panel"`
 *                           opens and closes the box; the box announces `links:state` {id, open} on
 *                           document so that button can follow it. `links:close` (detail {} closes all,
 *                           {id} one) closes it.
 * Esc closes it from inside. Without JavaScript the box simply shows, open.
 *
 * Reusable on purpose: no imports, safe to use several times on a page. Theming: --links-accent,
 * --links-surface, --links-text, --links-muted, --links-line.
 */
interface Link {
  href: string;
  label: string;
}
type Item = { links: Link[]; style?: 'primary' | 'secondary' } | { separator: string | true };
interface Props {
  id?: string;
  label?: string;
  items: Item[];
  toggle?: 'own' | 'external';
  class?: string;
}
const { id = 'links', label = 'Links', items, toggle = 'own', class: className } = Astro.props;
const panelId = `${id}-panel`;
---

<div class:list={['links', { 'links--external': toggle === 'external' }, className]} data-links-menu data-toggle={toggle}>
  {
    toggle === 'own' && (
      <button type="button" class="links__toggle" aria-expanded="false" aria-controls={panelId} data-links-toggle={panelId} hidden>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M6.5 9.5l3-3M7 4.5l1-1a2.8 2.8 0 0 1 4 4l-1 1M9 11.5l-1 1a2.8 2.8 0 0 1-4-4l1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span>{label}</span>
        <svg class="links__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    )
  }
  <div class="links__panel" id={panelId} role="group" aria-label={label} data-links-panel>
    {
      items.map((item) =>
        'separator' in item ? (
          item.separator === true ? (
            <hr class="links__line" />
          ) : (
            <div class="links__divider" role="heading" aria-level="4">
              <span>{item.separator}</span>
            </div>
          )
        ) : (
          <div class:list={['links__group', `links__group--${item.style ?? 'primary'}`]}>
            {item.links.map((l) => (
              <a class="links__link" href={l.href}>
                {l.label}
              </a>
            ))}
          </div>
        ),
      )
    }
  </div>
</div>

<script>
  function initLinksMenu() {
    document.querySelectorAll<HTMLElement>('[data-links-menu]').forEach((root) => {
      if (root.dataset.linksReady) return;
      root.dataset.linksReady = '1';
      const panel = root.querySelector<HTMLElement>('[data-links-panel]')!;
      const own = root.querySelector<HTMLButtonElement>('.links__toggle');
      if (own) own.hidden = false;
      panel.hidden = true;
      const buttons = () => document.querySelectorAll<HTMLButtonElement>(`[data-links-toggle="${panel.id}"]`);
      const set = (open: boolean, returnFocus = false) => {
        panel.hidden = !open;
        buttons().forEach((b) => b.setAttribute('aria-expanded', String(open)));
        document.dispatchEvent(new CustomEvent('links:state', { detail: { id: panel.id, open, returnFocus } }));
      };
      // Every toggle on the page that names this box (its own button, or the page's).
      document.addEventListener('click', (e) => {
        const b = (e.target as Element).closest?.<HTMLButtonElement>('[data-links-toggle]');
        if (b && b.dataset.linksToggle === panel.id) set(panel.hidden);
      });
      document.addEventListener('links:close', (e) => {
        const want = (e as CustomEvent).detail?.id;
        if (!panel.hidden && (!want || want === panel.id)) set(false);
      });
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          set(false, true);
          buttons()[0]?.focus();
        }
      });
    });
  }
  initLinksMenu();
  document.addEventListener('astro:page-load', initLinksMenu);
</script>

<style>
  .links {
    --_accent: var(--links-accent, #39c5bb);
    --_surface: var(--links-surface, rgba(11, 17, 48, 0.85));
    --_text: var(--links-text, #e6edf3);
    --_muted: var(--links-muted, #9aa8bb);
    --_line: var(--links-line, rgba(57, 197, 187, 0.35));
    display: contents;
  }
  .links--external {
    display: block;
  }
  .links__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem 0 0.9rem;
    border-radius: 999px;
    border: 2px solid var(--_accent);
    background: transparent;
    color: var(--_accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .links__toggle[hidden],
  .links__panel[hidden] {
    display: none;
  }
  .links__toggle:hover {
    background: color-mix(in srgb, var(--_accent) 14%, transparent);
  }
  .links__toggle[aria-expanded='true'] {
    background: var(--_accent);
    color: #070b1f;
  }
  .links__toggle:focus-visible,
  .links__link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .links__chevron {
    transition: transform 0.2s;
  }
  .links__toggle[aria-expanded='true'] .links__chevron {
    transform: rotate(180deg);
  }
  .links__panel {
    flex: 1 1 100%;
    order: 10;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--_accent) 45%, transparent);
    border-radius: 14px;
    background: var(--_surface);
    color: var(--_text);
  }
  .links--external .links__panel {
    margin: 0 0 1.75rem;
  }
  .links__group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0.35rem 1.1rem;
    line-height: 1.25;
    text-align: center;
    border-radius: 22px;
    font-weight: 700;
    text-decoration: none;
  }
  .links__group--primary .links__link {
    background: var(--_accent);
    color: #070b1f;
  }
  .links__group--primary .links__link:hover {
    filter: brightness(1.1);
  }
  .links__group--secondary .links__link {
    border: 1px solid color-mix(in srgb, var(--_accent) 55%, transparent);
    color: var(--_accent);
  }
  .links__group--secondary .links__link:hover {
    background: color-mix(in srgb, var(--_accent) 14%, transparent);
  }
  .links__divider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: none;
    margin: 0;
    color: var(--_muted);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
  }
  .links__divider::before,
  .links__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--_line);
  }
  .links__line {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--_line);
  }
  @media (prefers-reduced-motion: reduce) {
    .links__chevron {
      transition: none;
    }
  }
</style>
