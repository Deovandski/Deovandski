---
/**
 * DayGallery: photos grouped by the day they were taken, each day under its own banner (weekday, date and how many
 * photos), with that day's photos in a PhotoGrid below it. Made for the Cooking tab (#320): one meal per day, its
 * steps together.
 *
 * Usage:
 *   ---
 *   import DayGallery from './reusable/DayGallery.astro';
 *   const photos = [
 *     { src: beansJpg, alt: 'Beans on the stove', date: '2017-09-16' },
 *     { src: plateJpg, alt: 'Steak and black beans', date: '2017-09-16' },
 *     { src: jerkyJpg, alt: 'Jerky', date: '2018-01-14' },
 *   ];
 *   ---
 *   <DayGallery photos={photos} name="cooking" empty="Photos are on their way." />
 *
 * Props:
 *   photos     { src, alt, date } with date as YYYY-MM-DD; photos with no date are left out. Kept in the order given
 *              inside a day; days run oldest first (order="newest" flips them).
 *   name       a prefix for the photo viewer's galleries: each day is its own gallery (`<name>-<date>`), so ‹ › step
 *              through that day's photos.
 *   order      "oldest" (default) or "newest" first.
 *   empty      shown when there are no photos.
 *   one / many the photo count: "1 photo" and "{n} photos" by default.
 *   class      extra class.
 *
 * The date is MM/DD/YYYY, like PhotoGrid's date captions, and marked translate="no"; the weekday and the count are
 * their own elements, so a translated page translates them once each, not once per day.
 * Theming (CSS custom properties): --day-gallery-accent (default #39c5bb), --day-gallery-banner-bg, --day-gallery-ink,
 * plus PhotoGrid's own.
 *
 * Accessible: each day is a section named by its banner (a heading), so screen readers can jump day to day.
 */
import type { ImageMetadata } from 'astro';
import PhotoGrid from './PhotoGrid.astro';

interface Photo {
  src: ImageMetadata;
  alt: string;
  date?: string | null;
}
interface Props {
  photos: Photo[];
  name: string;
  order?: 'oldest' | 'newest';
  empty?: string;
  one?: string;
  many?: string;
  class?: string;
}
const { photos, name, order = 'oldest', empty, one = '1 photo', many = '{n} photos', class: className } = Astro.props;

const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const byDay = new Map<string, Photo[]>();
for (const p of photos) {
  if (!p.date || !/^\d{4}-\d{2}-\d{2}$/.test(p.date)) continue;
  byDay.set(p.date, [...(byDay.get(p.date) ?? []), p]);
}
const days = [...byDay.entries()]
  .sort(([a], [b]) => (order === 'newest' ? b.localeCompare(a) : a.localeCompare(b)))
  .map(([date, list]) => {
    const [y, m, d] = date.split('-');
    return {
      date,
      list,
      weekday: WEEKDAYS[new Date(Date.UTC(+y, +m - 1, +d)).getUTCDay()],
      shown: `${m}/${d}/${y}`,
      count: list.length === 1 ? one : many.replace('{n}', String(list.length)),
    };
  });
const uid = `day-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

{
  days.length === 0 ? (
    empty && <p class="day-gallery__empty">{empty}</p>
  ) : (
    <div class:list={['day-gallery', className]}>
      {days.map((day, i) => (
        <section class="day-gallery__day" aria-labelledby={`${uid}-${i}`}>
          <h3 class="day-gallery__banner" id={`${uid}-${i}`}>
            <span class="day-gallery__weekday">{day.weekday}</span>
            <time class="day-gallery__date" datetime={day.date} translate="no">
              {day.shown}
            </time>
            <span class="day-gallery__count">{day.count}</span>
          </h3>
          <PhotoGrid photos={day.list} name={`${name}-${day.date}`} caption="text" class="day-gallery__grid" />
        </section>
      ))}
    </div>
  )
}

<style>
  .day-gallery {
    --_accent: var(--day-gallery-accent, #39c5bb);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }
  .day-gallery__empty {
    color: var(--photo-grid-empty, #9aa8bb);
  }
  /* The banner: a ribbon across the day, its ends cut in like a pennant. */
  .day-gallery__banner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0.55rem 1.4rem;
    background: var(--day-gallery-banner-bg, linear-gradient(90deg, rgb(57 197 187 / 0.22), rgb(57 197 187 / 0.08)));
    border-top: 2px solid var(--_accent);
    border-bottom: 2px solid var(--_accent);
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.8rem) 50%, 100% 100%, 0 100%, 0.8rem 50%);
    color: var(--day-gallery-ink, inherit);
    font-size: 1rem;
    line-height: 1.3;
  }
  .day-gallery__weekday {
    font-weight: 800;
    color: var(--_accent);
  }
  .day-gallery__date {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .day-gallery__count {
    margin-inline-start: auto;
    font-size: 0.85em;
    font-weight: 600;
    opacity: 0.8;
  }
  .day-gallery__day :global(.day-gallery__grid) {
    margin-top: 0.85rem;
  }
</style>
