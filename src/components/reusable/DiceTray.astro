---
/**
 * DiceTray: a row of dice, each sitting in its own sunken "pit" (a shadow box). Click, tap or press
 * Enter/Space on a die and it tumbles in place, then lands on a result. A natural max (a 20 on a d20)
 * and a 1 get a small flourish.
 *
 * Reusable on purpose: no imports, no site CSS needed, safe to use several times on a page.
 * Copy this one file into any Astro project. See README.md in this folder.
 *
 *   <DiceTray />                                   d4, d6, d8, d10, d12, d20
 *   <DiceTray dice={[6, 6, 20]} label="Attack" />
 *
 * Props:
 *   dice     sides of each die, in order. Default [4, 6, 8, 10, 12, 20].
 *   label    name of the group, for screen readers. Default "Dice".
 *   rollAll  show a "Roll all" button and the total. Default true.
 *
 * Theming (CSS custom properties): --dice-face (default Miku teal #39c5bb), --dice-edge (#1f8f87),
 * --dice-ink (#0b2b2a), --dice-crit (Miku pink #e12885), --dice-pit (#22262e), --dice-text.
 *
 * Accessible: each die is a button ("Roll d20"), results are announced, and people who prefer
 * reduced motion see the result at once, with no tumble.
 */
interface Props {
  dice?: number[];
  label?: string;
  rollAll?: boolean;
  class?: string;
}
const { dice = [4, 6, 8, 10, 12, 20], label = 'Dice', rollAll = true, class: className } = Astro.props;

// The usual flat icon for each die: d4 triangle, d6 square, d8 diamond, d10 kite, d12 pentagon, d20 hexagon.
const shapes: Record<number, string> = {
  4: '50,6 95,88 5,88',
  6: '12,12 88,12 88,88 12,88',
  8: '50,4 94,50 50,96 6,50',
  10: '50,4 94,42 50,96 6,42',
  12: '50,5 95,38 78,93 22,93 5,38',
  20: '50,3 91,26 91,74 50,97 9,74 9,26',
};
const shape = (s: number) => shapes[s] ?? '50,3 91,26 91,74 50,97 9,74 9,26';
---

<div class:list={['dice-tray', className]} role="group" aria-label={label}>
  <div class="dice-tray__row">
    {
      dice.map((s) => (
        <div class="dice-tray__pit">
          <button type="button" class="dice-tray__die" data-sides={s} aria-label={`Roll d${s}`}>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <polygon points={shape(s)} />
            </svg>
            <span class="dice-tray__face" aria-hidden="true">{s}</span>
          </button>
          <span class="dice-tray__name">d{s}</span>
        </div>
      ))
    }
  </div>
  {
    rollAll && (
      <div class="dice-tray__all">
        <button type="button" class="dice-tray__roll-all">Roll all</button>
        <span class="dice-tray__total" aria-hidden="true" />
      </div>
    )
  }
  <p class="dice-tray__live" aria-live="polite"></p>
</div>

<style>
  .dice-tray {
    --_face: var(--dice-face, #39c5bb);
    --_edge: var(--dice-edge, #1f8f87);
    --_ink: var(--dice-ink, #0b2b2a);
    --_crit: var(--dice-crit, #e12885);
    --_pit: var(--dice-pit, #22262e);
    color: var(--dice-text, inherit);
    margin: 0 0 1.5rem;
  }
  .dice-tray__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .dice-tray__pit {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.7rem 0.7rem 0.45rem;
    border-radius: 14px;
    background: var(--_pit);
    /* A sunken box: dark inner shadow on top, a faint highlight along the bottom edge. */
    box-shadow:
      inset 0 6px 14px rgba(0, 0, 0, 0.65),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .dice-tray__die {
    position: relative;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--_ink);
  }
  .dice-tray__die svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 3px 2px rgba(0, 0, 0, 0.55));
  }
  .dice-tray__die polygon {
    fill: var(--_face);
    stroke: var(--_edge);
    stroke-width: 5;
    stroke-linejoin: round;
  }
  .dice-tray__face {
    position: relative;
    font-weight: 800;
    font-size: 1.3rem;
    font-variant-numeric: tabular-nums;
  }
  .dice-tray__die[data-sides='4'] .dice-tray__face {
    top: 9px;
  }
  .dice-tray__die:focus-visible {
    outline: 2px solid var(--_face);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .dice-tray__die.is-rolling {
    animation: dice-tray-tumble 0.9s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .dice-tray__die.is-crit polygon {
    fill: var(--_crit);
    stroke: #8f0f50;
  }
  .dice-tray__die.is-crit,
  .dice-tray__die.is-fumble {
    animation: dice-tray-pop 0.5s ease-out;
  }
  .dice-tray__die.is-fumble polygon {
    fill: #6b7280;
    stroke: #374151;
  }
  .dice-tray__name {
    font-size: 0.85rem;
    color: var(--_face);
    font-weight: 700;
  }
  @keyframes dice-tray-tumble {
    0% { transform: rotate(0) scale(1); }
    25% { transform: rotate(calc(var(--spin, 1) * 160deg)) scale(0.82) translateY(-4px); }
    55% { transform: rotate(calc(var(--spin, 1) * 300deg)) scale(1.06); }
    80% { transform: rotate(calc(var(--spin, 1) * 350deg)) scale(0.97); }
    100% { transform: rotate(calc(var(--spin, 1) * 360deg)) scale(1); }
  }
  @keyframes dice-tray-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  .dice-tray__all {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .dice-tray__roll-all {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--_face);
    background: transparent;
    color: var(--_face);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .dice-tray__roll-all:hover,
  .dice-tray__roll-all:focus-visible {
    background: color-mix(in srgb, var(--_face) 18%, transparent);
  }
  .dice-tray__total {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .dice-tray__live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .dice-tray__die.is-rolling,
    .dice-tray__die.is-crit,
    .dice-tray__die.is-fumble {
      animation: none;
    }
  }
</style>

<script>
  // Each tray runs on its own; any number can be on a page.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const roll = (sides: number) => {
    const buf = new Uint32Array(1);
    crypto.getRandomValues(buf);
    return (buf[0] % sides) + 1;
  };

  document.querySelectorAll<HTMLElement>('.dice-tray').forEach((tray) => {
    const live = tray.querySelector<HTMLElement>('.dice-tray__live')!;
    const total = tray.querySelector<HTMLElement>('.dice-tray__total');
    const dice = Array.from(tray.querySelectorAll<HTMLButtonElement>('.dice-tray__die'));

    // Rolls one die; resolves with its result once it has landed.
    const throwDie = (die: HTMLButtonElement) =>
      new Promise<number>((done) => {
        const sides = Number(die.dataset.sides);
        const face = die.querySelector<HTMLElement>('.dice-tray__face')!;
        const result = roll(sides);
        die.classList.remove('is-crit', 'is-fumble', 'is-rolling');
        const land = () => {
          face.textContent = String(result);
          die.classList.remove('is-rolling');
          void die.offsetWidth;
          if (sides >= 20 && result === sides) die.classList.add('is-crit');
          if (sides >= 20 && result === 1) die.classList.add('is-fumble');
          die.setAttribute('aria-label', `Roll d${sides} (last roll ${result})`);
          done(result);
        };
        if (reduced) return land();
        die.style.setProperty('--spin', Math.random() < 0.5 ? '-1' : '1');
        void die.offsetWidth;
        die.classList.add('is-rolling');
        // The number flickers while it tumbles, then settles.
        const flicker = window.setInterval(() => (face.textContent = String(roll(sides))), 70);
        window.setTimeout(() => {
          window.clearInterval(flicker);
          land();
        }, 900);
      });

    const say = (sides: number, r: number) =>
      `d${sides}: ${r}${sides >= 20 && r === sides ? ', natural ' + sides + '!' : sides >= 20 && r === 1 ? ', natural 1!' : ''}`;

    for (const die of dice) {
      die.addEventListener('click', async () => {
        if (die.classList.contains('is-rolling')) return;
        const sides = Number(die.dataset.sides);
        const r = await throwDie(die);
        live.textContent = say(sides, r);
        if (total) total.textContent = '';
      });
    }

    tray.querySelector<HTMLButtonElement>('.dice-tray__roll-all')?.addEventListener('click', async () => {
      const results = await Promise.all(dice.map(throwDie));
      const sum = results.reduce((a, b) => a + b, 0);
      if (total) total.textContent = `Total: ${sum}`;
      live.textContent = `${results.map((r, i) => say(Number(dice[i].dataset.sides), r)).join(', ')}. Total ${sum}.`;
    });
  });
</script>
