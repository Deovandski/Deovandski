---
/**
 * ExplodedSphere: a sphere split into chunks, one per category, each as big as its share of the
 * hours, pulled apart and slowly turning. Drag to turn it. Pressing a chunk (or its row) turns it
 * toward you and splits it into layers, one per item, each layer's volume its share of the chunk.
 * Built for the Gamer tab (#252), from Deo's idea.
 *
 *   <ExplodedSphere
 *     id="games-sphere"
 *     categories={[
 *       { id: 'rpg', name: 'RPGs', color: '#3987e5', value: 4935, items: [{ name: 'Skyrim', value: 372 }] },
 *       { id: 'other', name: 'Other', color: '#7d8597', value: 1934, items: [],
 *         parts: [{ name: 'Roguelites', value: 570, count: 5 }] },
 *     ]}
 *   />
 *
 * A category with `parts` opens into those parts instead of its items. The 3D is a small renderer of
 * its own (SVG paths, drawn back to front): no library. Every word is in the page (the lists beside
 * it and the strings below), so translated pages need nothing extra, and the lists are the
 * accessible version: keyboard and screen readers use them, the sphere is a picture of them. It
 * stops turning for people who prefer reduced motion, and while it's off screen. Inside an element
 * with `data-hours-scope` (HoursByCategory's root) it follows `data-excluded` and `hours:excluded`.
 *
 * Reusable on purpose: no imports, safe to use several times on a page. Theming: --sphere-text,
 * --sphere-muted, --sphere-border, --sphere-surface, --sphere-accent, --sphere-glow.
 */
interface Item {
  name: string;
  value: number;
  estimated?: boolean;
  chips?: string[];
}
interface Category {
  id: string;
  name: string;
  color: string;
  value: number;
  excludable?: boolean;
  items: Item[];
  parts?: { name: string; value: number; count: number }[];
}
interface Props {
  categories: Category[];
  id?: string;
  excluded?: boolean;
  unit?: string;
  /** Layers per chunk before the rest join one "more" layer. */
  layers?: number;
  hint?: string;
  openHint?: string;
  backLabel?: string;
  /** {n} is how many items the last layer holds. */
  moreLabel?: string;
  /** {name}, {hours} and {share}. */
  chunkCaption?: string;
  /** {name} and {hours}. */
  layerCaption?: string;
  /** {share} is the category's percent. */
  shareLabel?: string;
  countLabel?: string;
  countLabelOne?: string;
  estimatedLabel?: string;
  /** Read by screen readers for the sphere; {list}. */
  label?: string;
  locale?: string;
  class?: string;
}
const {
  categories,
  id = 'sphere',
  excluded = false,
  unit = 'h',
  layers: layerCount = 7,
  hint = 'Each chunk is a category, as big as its hours. Drag to turn it; press a chunk to open it.',
  openHint = 'Each layer is an item; its volume is its hours. Drag to turn it.',
  backLabel = '← Close the chunk',
  moreLabel = '+ {n} more',
  chunkCaption = '{name}: {hours} · {share}',
  layerCaption = '{name}: {hours}',
  shareLabel = '{share} of the total',
  countLabel = '{n} items',
  countLabelOne,
  estimatedLabel = 'estimated',
  label = 'An exploded sphere of hours by category: {list}',
  locale = 'en-US',
  class: className,
} = Astro.props;

const nf = new Intl.NumberFormat(locale);
const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (m, k) => (k in v ? String(v[k]) : m));
const hasExcludable = categories.some((c) => c.excludable);
const pct = (part: number, whole: number) => {
  const p = whole > 0 ? Math.round((part / whole) * 100) : 0;
  return p === 0 && part > 0 ? '<1%' : `${p}%`;
};
const tint = (hex: string, t: number) =>
  '#' + [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).map((c) => Math.round(c + (255 - c) * t).toString(16).padStart(2, '0')).join('');
const TINTS = [0, 0.3, 0.12, 0.42, 0.2, 0.5, 0.06, 0.36];
const count = (n: number) => fill(n === 1 && countLabelOne ? countLabelOne : countLabel, { n: nf.format(n) });
// The layers a chunk opens into: its parts, or its biggest items and one layer for the rest.
const layered = categories.map((c) => {
  // One leftover item gets its own layer rather than a "+ 1 more" layer.
  const take = c.items.length === layerCount + 1 ? layerCount + 1 : layerCount;
  const src = c.parts
    ? c.parts.map((p) => ({ name: p.name, value: p.value, sub: count(p.count), estimated: false }))
    : c.items.slice(0, take).map((i) => ({ name: i.name, value: i.value, sub: (i.chips ?? []).join(' + '), estimated: !!i.estimated }));
  const rest = c.parts ? [] : c.items.slice(take);
  if (rest.length) src.push({ name: fill(moreLabel, { n: nf.format(rest.length) }), value: rest.reduce((s, i) => s + i.value, 0), sub: '', estimated: false });
  return { ...c, layers: src.map((l, i) => ({ ...l, color: tint(c.color, TINTS[i % TINTS.length]), hours: `${nf.format(l.value)} ${unit}` })) };
});
const stateList = (key: string) => {
  const list = categories.filter((c) => key === 'on' || !c.excludable);
  const sum = list.reduce((s, c) => s + c.value, 0);
  return list.map((c) => ({ ...c, share: pct(c.value, sum), hours: `${nf.format(c.value)} ${unit}` }));
};
const keys = hasExcludable ? ['on', 'off'] : ['on'];
const data = layered.map((c) => ({ id: c.id, color: c.color, v: c.value, ex: !!c.excludable, layers: c.layers.map((l) => [l.value, l.color]) }));
---

<div class:list={['sphere', className]} id={id} data-exploded-sphere data-state={excluded && hasExcludable ? 'off' : 'on'} data-sphere={JSON.stringify(data)}>
  <div class="sphere__stage">
    {
      keys.map((k) => (
        <span class={`sphere__sr sphere__${k}`} id={`${id}-label-${k}`}>
          {fill(label, { list: stateList(k).map((c) => `${c.name} ${c.share}`).join(', ') })}
        </span>
      ))
    }
    <svg class="sphere__svg" viewBox="60 25 580 545" role="img" aria-labelledby={`${id}-label-${excluded && hasExcludable ? 'off' : 'on'}`} data-svg></svg>
    <p class="sphere__caption" aria-live="polite" data-caption>{hint}</p>
  </div>
  <div class="sphere__side">
    <div data-sphere-list>
      {
        keys.map((k) => (
          <ul class={`sphere__rows sphere__${k}`}>
            {stateList(k).map((c) => (
              <li>
                <button type="button" class="sphere__row" data-cat={c.id}>
                  <span class="sphere__swatch" style={`background: ${c.color}`} />
                  <span class="sphere__name">{c.name}</span>
                  <span class="sphere__num">
                    <span data-h>{c.hours}</span> · <span data-s>{c.share}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
    {
      layered.map((c) => (
        <section class="sphere__detail" data-detail={c.id} aria-label={c.name} hidden>
          <button type="button" class="sphere__back" data-back>
            {backLabel}
          </button>
          <h4 class="sphere__title">
            <span class="sphere__swatch sphere__swatch--big" style={`background: ${c.color}`} />
            <span>{c.name}</span>
          </h4>
          <p class="sphere__meta">
            <span>{`${nf.format(c.value)} ${unit}`}</span> · <span>{count(c.items.length)}</span>
          </p>
          <ol class="sphere__layers">
            {c.layers.map((l, i) => (
              <li data-layer={i}>
                <span class="sphere__swatch" style={`background: ${l.color}`} />
                <span class="sphere__name">
                  <span data-layer-name>{l.name}</span>
                  {(l.sub || l.estimated) && (
                    <span class="sphere__sub">
                      {l.sub}
                      {l.sub && l.estimated && ' · '}
                      {l.estimated && estimatedLabel}
                    </span>
                  )}
                </span>
                <span class="sphere__num" data-h>{l.hours}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  <div hidden data-llms-skip>
    <span data-k="hint">{hint}</span>
    <span data-k="open">{openHint}</span>
    <span data-k="chunk">{chunkCaption}</span>
    <span data-k="layer">{layerCaption}</span>
  </div>
</div>

<script>
  // A tiny 3D renderer: every face becomes an SVG path, drawn back to front.
  type Cat = { id: string; color: string; v: number; ex: boolean; layers: [number, string][] };
  const CX = 350, CY = 300, R = 175, FOCAL = 1100, EXPLODE = 30, GAP = 16;
  const LIGHT = (() => {
    const v = [-0.45, 0.65, -0.62];
    const l = Math.hypot(...v);
    return v.map((x) => x / l);
  })();
  type V = number[];
  const sub = (a: V, b: V) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
  const cross = (a: V, b: V) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const dot = (a: V, b: V) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const unit = (v: V) => {
    const l = Math.hypot(...v) || 1;
    return v.map((x) => x / l);
  };
  const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const shade = (h: string, k: number) => `rgb(${rgb(h).map((c) => Math.round(Math.min(255, c * k))).join(',')})`;
  // Volume of a sphere wedge below height y, as a share of the wedge; and its inverse.
  const volBelow = (y: number) => (R * R * (y + R) - (y ** 3 + R ** 3) / 3) / ((4 * R ** 3) / 3);
  function heightAt(share: number) {
    let lo = -R, hi = R;
    for (let i = 0; i < 40; i++) {
      const m = (lo + hi) / 2;
      if (volBelow(m) < share) lo = m;
      else hi = m;
    }
    return (lo + hi) / 2;
  }
  const onSphere = (y: number, phi: number): V => {
    const r = Math.sqrt(Math.max(0, R * R - y * y));
    return [r * Math.cos(phi), y, r * Math.sin(phi)];
  };
  // The wedge phi0..phi1 between heights y0..y1, as polygons.
  function chunk(phi0: number, phi1: number, y0: number, y1: number, latN: number) {
    const polys: V[][] = [];
    const n = Math.max(1, Math.ceil((phi1 - phi0) / (Math.PI / 14)));
    const t0 = Math.asin(y0 / R), t1 = Math.asin(y1 / R);
    const ys = Array.from({ length: latN + 1 }, (_, i) => R * Math.sin(t0 + ((t1 - t0) * i) / latN));
    const phis = Array.from({ length: n + 1 }, (_, j) => phi0 + ((phi1 - phi0) * j) / n);
    for (let i = 0; i < latN; i++)
      for (let j = 0; j < n; j++) polys.push([onSphere(ys[i], phis[j]), onSphere(ys[i], phis[j + 1]), onSphere(ys[i + 1], phis[j + 1]), onSphere(ys[i + 1], phis[j])]);
    for (const phi of [phi0, phi1])
      for (let i = 0; i < latN; i++) polys.push([[0, ys[i], 0], onSphere(ys[i], phi), onSphere(ys[i + 1], phi), [0, ys[i + 1], 0]]);
    for (const y of [y0, y1]) if (Math.abs(Math.abs(y) - R) > 0.5) polys.push([[0, y, 0], ...phis.map((p) => onSphere(y, p))]);
    return polys;
  }
  function view(p: V, yaw: number, pitch: number): V {
    const x1 = p[0] * Math.cos(yaw) - p[2] * Math.sin(yaw);
    const z1 = p[0] * Math.sin(yaw) + p[2] * Math.cos(yaw);
    return [x1, p[1] * Math.cos(pitch) - z1 * Math.sin(pitch), p[1] * Math.sin(pitch) + z1 * Math.cos(pitch)];
  }
  const screen = (v: V) => {
    const s = FOCAL / (FOCAL + v[2]);
    return [CX + v[0] * s, CY - v[1] * s];
  };
  type Solid = { polys: V[][]; off: V; center: V; color: string; key: string };
  function paint(solids: Solid[], yaw: number, pitch: number, dimKey: string | null) {
    const faces: { z: number; html: string }[] = [];
    for (const s of solids) {
      const c = view(s.center, yaw, pitch);
      for (const poly of s.polys) {
        const v = poly.map((p) => view([p[0] + s.off[0], p[1] + s.off[1], p[2] + s.off[2]], yaw, pitch));
        let raw = cross(sub(v[1], v[0]), sub(v[v.length - 1], v[0]));
        if (Math.hypot(...raw) < 1e-6) raw = cross(sub(v[2], v[1]), sub(v[v.length - 1], v[1]));
        let n = unit(raw);
        const mid = v.reduce((a, p) => [a[0] + p[0] / v.length, a[1] + p[1] / v.length, a[2] + p[2] / v.length], [0, 0, 0]);
        if (dot(n, sub(mid, c)) < 0) n = n.map((x) => -x);
        if (dot(n, sub([0, 0, -FOCAL], mid)) <= 0) continue; // faces away
        const fillC = shade(s.color, 0.42 + 0.62 * Math.max(0, dot(n, LIGHT)));
        const d = 'M' + v.map(screen).map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join('L') + 'Z';
        const op = dimKey && dimKey !== s.key ? ' opacity="0.3"' : '';
        faces.push({ z: mid[2], html: `<path d="${d}" fill="${fillC}" stroke="${fillC}" stroke-width="0.6" stroke-linejoin="round" data-key="${s.key}"${op}/>` });
      }
    }
    return faces.sort((a, b) => b.z - a.z).map((f) => f.html).join('');
  }

  function initExplodedSphere() {
    document.querySelectorAll<HTMLElement>('[data-exploded-sphere]').forEach((root) => {
      if (root.dataset.sphereReady) return;
      root.dataset.sphereReady = '1';
      const cats: Cat[] = JSON.parse(root.dataset.sphere || '[]');
      const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
      const cap = root.querySelector<HTMLElement>('[data-caption]')!;
      const msg = (k: string, v: Record<string, string> = {}) =>
        (root.querySelector(`[data-k="${k}"]`)?.textContent ?? '').replace(/\{(\w+)\}/g, (m, key) => (key in v ? v[key] : m));
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const st = { yaw: 0.6, pitch: -0.42, open: 0, pick: null as string | null, hover: null as string | null, target: null as number | null };
      let visible = false;
      let dragging = false, moved = false, lx = 0, ly = 0;
      const shown = () => cats.filter((c) => !(root.dataset.state === 'off' && c.ex));
      const angles = () => {
        const list = shown();
        const sum = list.reduce((s, c) => s + c.v, 0) || 1;
        let a = 0;
        return list.map((c) => {
          const phi0 = a;
          a += (c.v / sum) * Math.PI * 2;
          return { ...c, phi0, phi1: a, mid: (phi0 + a) / 2 };
        });
      };
      const rowFor = (cid: string) => root.querySelector<HTMLElement>(`.sphere__${root.dataset.state} [data-cat="${cid}"]`);
      const labelsFor = (list: ReturnType<typeof angles>) =>
        list
          .filter((c) => c.phi1 - c.phi0 >= Math.PI * 2 * 0.05)
          .map((c) => {
            const v = view([(R + EXPLODE + 34) * Math.cos(c.mid), 0, (R + EXPLODE + 34) * Math.sin(c.mid)], st.yaw, st.pitch);
            const [x, y] = screen(v);
            const row = rowFor(c.id);
            const name = row?.querySelector('.sphere__name')?.textContent?.trim() ?? '';
            const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
            const short = name.length > 14 ? name.split(/[ ,&]/)[0] : name;
            return `<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" class="sphere__label" opacity="${v[2] > 60 ? 0.35 : 1}">${esc(short)}<tspan x="${x.toFixed(1)}" dy="17" class="sphere__label-sub">${esc(row?.querySelector('[data-s]')?.textContent?.trim() ?? '')}</tspan></text>`;
          })
          .join('');
      const draw = () => {
        const list = angles();
        const pick = list.find((c) => c.id === st.pick);
        const solids: Solid[] = [];
        if (!pick) {
          for (const c of list) {
            const off = [EXPLODE * Math.cos(c.mid), 0, EXPLODE * Math.sin(c.mid)];
            solids.push({ polys: chunk(c.phi0, c.phi1, -R, R, 10), off, center: [off[0] + R * 0.5 * Math.cos(c.mid), 0, off[2] + R * 0.5 * Math.sin(c.mid)], color: c.color, key: c.id });
          }
          svg.innerHTML = paint(solids, st.yaw, st.pitch, st.hover) + labelsFor(list);
          return;
        }
        // The open chunk, widened so its inside reads, split into its layers by volume.
        const half = Math.max(pick.phi1 - pick.phi0, (Math.PI * 100) / 180) / 2;
        const total = pick.layers.reduce((s, l) => s + l[0], 0) || 1;
        let acc = 0;
        const n = pick.layers.length;
        pick.layers.forEach(([v, color], i) => {
          const yTop = heightAt(1 - acc / total);
          acc += v;
          const yBot = heightAt(1 - acc / total);
          const dy = st.open * GAP * ((n - 1) / 2 - i);
          solids.push({
            polys: chunk(pick.mid - half, pick.mid + half, yBot, yTop, Math.max(1, Math.round((yTop - yBot) / 18))),
            off: [0, dy, 0],
            center: [R * 0.45 * Math.cos(pick.mid), (yTop + yBot) / 2 + dy, R * 0.45 * Math.sin(pick.mid)],
            color,
            key: 'L' + i,
          });
        });
        svg.innerHTML = paint(solids, st.yaw, st.pitch, st.hover);
      };
      const caption = () => {
        const list = angles();
        if (st.pick) {
          const li = st.hover?.startsWith('L') ? root.querySelector<HTMLElement>(`[data-detail="${st.pick}"] [data-layer="${st.hover.slice(1)}"]`) : null;
          cap.textContent = li ? msg('layer', { name: li.querySelector('[data-layer-name]')?.textContent?.trim() ?? '', hours: li.querySelector('[data-h]')?.textContent?.trim() ?? '' }) : msg('open');
        } else {
          const row = st.hover && list.some((c) => c.id === st.hover) ? rowFor(st.hover) : null;
          cap.textContent = row ? msg('chunk', { name: row.querySelector('.sphere__name')?.textContent?.trim() ?? '', hours: row.querySelector('[data-h]')?.textContent?.trim() ?? '', share: row.querySelector('[data-s]')?.textContent?.trim() ?? '' }) : msg('hint');
        }
        root.querySelectorAll('[data-cat]').forEach((b) => b.classList.toggle('is-hover', b.getAttribute('data-cat') === st.hover));
        root.querySelectorAll('[data-layer]').forEach((b) => b.classList.toggle('is-hover', 'L' + b.getAttribute('data-layer') === st.hover));
      };
      const open = (cid: string | null, focus = false) => {
        st.pick = cid;
        st.hover = null;
        root.querySelector<HTMLElement>('[data-sphere-list]')!.hidden = !!cid;
        root.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => (d.hidden = d.dataset.detail !== cid));
        if (cid) {
          // Turn the chunk so its cut side faces the viewer and its layers show.
          const c = angles().find((x) => x.id === cid)!;
          let t = -Math.PI / 2 - c.mid + 1.15;
          while (t - st.yaw > Math.PI) t -= Math.PI * 2;
          while (t - st.yaw < -Math.PI) t += Math.PI * 2;
          st.target = t;
          st.pitch = -0.32;
          if (focus) root.querySelector<HTMLElement>(`[data-detail="${cid}"] [data-back]`)?.focus();
        } else {
          st.target = null;
          if (focus) root.querySelector<HTMLElement>(`.sphere__${root.dataset.state} .sphere__row`)?.focus();
        }
        if (reduce.matches) {
          st.open = cid ? 1 : 0;
          if (st.target !== null) st.yaw = st.target;
        }
        caption();
        draw();
      };
      // Animation: only while on screen.
      let last = 0, raf = 0;
      const tick = (now: number) => {
        const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
        last = now;
        let changed = false;
        if (!st.pick && !dragging && !reduce.matches) {
          st.yaw += dt * 0.18;
          changed = true;
        }
        if (st.target !== null && Math.abs(st.target - st.yaw) > 0.002) {
          st.yaw += (st.target - st.yaw) * Math.min(1, dt * 5);
          changed = true;
        }
        const goal = st.pick ? 1 : 0;
        if (Math.abs(goal - st.open) > 0.001) {
          st.open += (goal - st.open) * Math.min(1, dt * 4);
          changed = true;
        }
        if (changed) draw();
        raf = visible ? requestAnimationFrame(tick) : 0;
      };
      const start = () => {
        if (!raf && visible) {
          last = 0;
          raf = requestAnimationFrame(tick);
        }
      };
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) {
          draw();
          start();
        }
      }).observe(svg);
      svg.addEventListener('pointerdown', (e) => {
        dragging = true;
        moved = false;
        lx = e.clientX;
        ly = e.clientY;
      });
      svg.addEventListener('pointermove', (e) => {
        if (!dragging) {
          const k = (e.target as Element).getAttribute?.('data-key');
          if (k !== st.hover) {
            st.hover = k;
            caption();
            draw();
          }
          return;
        }
        const dx = e.clientX - lx, dy = e.clientY - ly;
        if (!moved && Math.abs(dx) + Math.abs(dy) > 4) {
          moved = true;
          svg.setPointerCapture(e.pointerId);
        }
        if (!moved) return;
        lx = e.clientX;
        ly = e.clientY;
        st.target = null;
        st.yaw += dx * 0.01;
        st.pitch = Math.max(-1.2, Math.min(1.2, st.pitch - dy * 0.008));
        draw();
      });
      const end = () => {
        dragging = false;
        start();
      };
      svg.addEventListener('pointerup', end);
      svg.addEventListener('pointercancel', end);
      svg.addEventListener('pointerleave', () => {
        if (!dragging && st.hover) {
          st.hover = null;
          caption();
          draw();
        }
      });
      svg.addEventListener('click', (e) => {
        if (moved) return;
        const k = (e.target as Element).getAttribute?.('data-key');
        if (!st.pick && k) open(k);
      });
      root.querySelectorAll<HTMLButtonElement>('.sphere__row').forEach((b) => {
        b.addEventListener('click', () => {
          open(b.dataset.cat!, true);
          start();
        });
        const on = () => {
          st.hover = b.dataset.cat!;
          caption();
          draw();
        };
        const off = () => {
          st.hover = null;
          caption();
          draw();
        };
        b.addEventListener('pointerenter', on);
        b.addEventListener('focus', on);
        b.addEventListener('pointerleave', off);
        b.addEventListener('blur', off);
      });
      root.querySelectorAll<HTMLElement>('[data-layer]').forEach((li) => {
        li.addEventListener('pointerenter', () => {
          st.hover = 'L' + li.dataset.layer;
          caption();
          draw();
        });
        li.addEventListener('pointerleave', () => {
          st.hover = null;
          caption();
          draw();
        });
      });
      root.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((b) =>
        b.addEventListener('click', () => {
          open(null, true);
          start();
        }),
      );
      const scope = root.closest<HTMLElement>('[data-hours-scope]');
      const sync = () => {
        if (scope) root.dataset.state = scope.hasAttribute('data-excluded') && cats.some((c) => c.ex) ? 'off' : 'on';
        svg.setAttribute('aria-labelledby', `${root.id}-label-${root.dataset.state}`);
        open(null);
      };
      scope?.addEventListener('hours:excluded', sync);
      sync();
    });
  }
  initExplodedSphere();
  document.addEventListener('astro:page-load', initExplodedSphere);
</script>

