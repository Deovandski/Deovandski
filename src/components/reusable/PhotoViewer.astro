---
/**
 * PhotoViewer: one photo viewer (lightbox) for the whole page, so every picture can be opened bigger.
 * Put it once in the layout; it serves every picture on the page with no extra markup:
 *
 *   - Gallery buttons: a <button data-gallery="name" data-full="big.webp" data-alt="…"> (what
 *     PhotoGrid makes). ‹ › step through the buttons with the same data-gallery.
 *   - Any other content picture: an <img> with alt text opens by itself (click, or Tab then Enter).
 *     ‹ › step through the other pictures you can see on the page (or in the nearest [data-zoom-group]),
 *     so a tabbed page only steps through the open tab.
 *   - A link straight to an image file (<a href="photo.jpg">) opens in the viewer instead of leaving
 *     the page.
 *
 * Skipped: decorative pictures (alt=""), pictures inside a link or button, the header and nav, maps
 * (.leaflet-container), games (.gimmick-play), other dialogs, pictures under 64px, and anything inside
 * [data-no-zoom]. Add data-zoom to an <img> to force it on.
 *
 * The caption is the description, then the date when there is one: data-date="YYYY-MM-DD" (or
 * data-date-label="Circa 2013") on the picture or button, or a YYYY-MM-DD at the start of the file name.
 * The picture shown is data-full when given, else the largest size in its srcset, else its src.
 *
 * Reusable on purpose: no imports, no site CSS needed. Copy this one file into any Astro project and put
 * <PhotoViewer /> at the end of the layout's <body>.
 *
 * Props:
 *   label  the dialog's name for screen readers. Default "Photo".
 *
 * Theming (CSS custom properties, all with fallbacks): --photo-viewer-accent (border and buttons),
 * --photo-viewer-bg, --photo-viewer-text, --photo-viewer-muted (caption), --photo-viewer-backdrop.
 *
 * Accessible: pictures that open get tabindex, role="button" and "Enlarge: …"; Enter or Space opens;
 * Esc or Close closes and returns focus to the picture; ← → and ‹ › move between pictures.
 */
interface Props {
  label?: string;
}
const { label = 'Photo' } = Astro.props;
---

<dialog class="photo-viewer" aria-label={label}>
  <span class="photo-viewer__strings" hidden data-llms-skip data-k="enlarge">Enlarge: {'{alt}'}</span>
  <figure class="photo-viewer__figure">
    <img class="photo-viewer__img" alt="" />
    <figcaption class="photo-viewer__caption">
      <span class="photo-viewer__text"></span>
      <time class="photo-viewer__date" hidden></time>
    </figcaption>
  </figure>
  <div class="photo-viewer__bar">
    <button type="button" class="photo-viewer__prev" aria-label="Previous photo">‹</button>
    <button type="button" class="photo-viewer__close">Close</button>
    <button type="button" class="photo-viewer__next" aria-label="Next photo">›</button>
  </div>
</dialog>

<style>
  .photo-viewer {
    width: min(100% - 2rem, 56rem);
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    padding: 1rem;
    color: var(--photo-viewer-text, #e6edf3);
    background: var(--photo-viewer-bg, #0b1130);
    border: 1px solid var(--photo-viewer-accent, rgba(57, 197, 187, 0.6));
    border-radius: 20px;
  }
  .photo-viewer::backdrop {
    background: var(--photo-viewer-backdrop, rgba(3, 5, 15, 0.85));
  }
  .photo-viewer__figure {
    margin: 0;
    text-align: center;
  }
  .photo-viewer__img {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    border-radius: 12px;
  }
  .photo-viewer__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.6rem;
    color: var(--photo-viewer-muted, #b8c2cf);
  }
  .photo-viewer__date {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .photo-viewer__date[hidden],
  .photo-viewer__bar button[hidden] {
    display: none;
  }
  .photo-viewer__bar {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .photo-viewer__bar button {
    font: inherit;
    font-weight: 700;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.35rem 1rem;
    color: inherit;
    background: transparent;
    border: 1px solid var(--photo-viewer-accent, #39c5bb);
    border-radius: 999px;
    cursor: pointer;
  }
  .photo-viewer__bar button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  /* Pictures that open: a zoom cursor and a visible keyboard focus ring. */
  :global([data-photo-viewer]) {
    cursor: zoom-in;
  }
  :global(img[data-photo-viewer]:focus-visible) {
    outline: 3px solid var(--photo-viewer-accent, #39c5bb);
    outline-offset: 3px;
  }
</style>

<script>
  type Item = { full: string; alt: string; date?: string; dateLabel?: string; caption?: string; el: HTMLElement };

  const SKIP = 'a, button, header, nav, dialog, .leaflet-container, .gimmick-play, [data-no-zoom]';
  const IMAGE_LINK = /\.(jpe?g|png|webp|avif|gif)(\?.*)?$/i;

  const dialog = document.querySelector<HTMLDialogElement>('dialog.photo-viewer');
  if (dialog && !dialog.dataset.ready) {
    dialog.dataset.ready = '1';
    const big = dialog.querySelector<HTMLImageElement>('.photo-viewer__img')!;
    const text = dialog.querySelector<HTMLElement>('.photo-viewer__text')!;
    const time = dialog.querySelector<HTMLTimeElement>('.photo-viewer__date')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.photo-viewer__prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.photo-viewer__next')!;
    let items: Item[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    // Which elements open the viewer.
    const zoomableImg = (img: HTMLImageElement) => {
      if (img.hasAttribute('data-zoom')) return true;
      if (!img.getAttribute('alt')) return false; // decorative
      if (img.closest(SKIP)) return false;
      const w = Number(img.getAttribute('width')) || img.naturalWidth || img.width;
      return !w || w >= 64;
    };
    const imageLink = (a: HTMLAnchorElement) => IMAGE_LINK.test(a.getAttribute('href') ?? '') && !a.closest('[data-no-zoom]');

    const largest = (img: HTMLImageElement) => {
      let best = { url: img.currentSrc || img.src, w: 0 };
      for (const part of (img.getAttribute('srcset') ?? '').split(',')) {
        const [url, size] = part.trim().split(/\s+/);
        const w = parseInt(size ?? '', 10);
        if (url && w > best.w) best = { url, w };
      }
      return best.url;
    };
    const fileDate = (url: string) => /(?:^|\/)(\d{4}-\d{2}-\d{2})[^/]*$/.exec(url.split('?')[0])?.[1];
    const itemOf = (el: HTMLElement): Item => {
      if (el.matches('[data-gallery]')) {
        const d = el.dataset;
        return { el, full: d.full!, alt: d.alt ?? '', date: d.date, dateLabel: d.dateLabel, caption: d.caption };
      }
      if (el instanceof HTMLAnchorElement) {
        const img = el.querySelector('img');
        const full = el.href;
        return { el, full, alt: img?.alt || el.getAttribute('aria-label') || el.textContent?.trim() || '', date: el.dataset.date ?? img?.dataset.date ?? fileDate(full), dateLabel: el.dataset.dateLabel };
      }
      const img = el as HTMLImageElement;
      const full = img.dataset.full ?? largest(img);
      return { el, full, alt: img.alt, date: img.dataset.date ?? fileDate(full) ?? fileDate(img.src), dateLabel: img.dataset.dateLabel };
    };
    // The pictures ‹ › step through: the same gallery, or the other visible pictures in the group.
    const groupOf = (el: HTMLElement): HTMLElement[] => {
      if (el.matches('[data-gallery]')) return Array.from(document.querySelectorAll<HTMLElement>(`[data-gallery="${CSS.escape(el.dataset.gallery!)}"]`));
      const scope = el.closest<HTMLElement>('[data-zoom-group]') ?? el.closest('main') ?? document.body;
      return Array.from(scope.querySelectorAll<HTMLElement>('img, a[href]')).filter(
        (x) => (x instanceof HTMLImageElement ? zoomableImg(x) : imageLink(x as HTMLAnchorElement)) && (x === el || x.getClientRects().length > 0),
      );
    };

    const usDate = (iso: string) => {
      const [y, m, d] = iso.split('-');
      return `${m}/${d}/${y}`;
    };
    function show(i: number) {
      index = (i + items.length) % items.length;
      const it = items[index];
      big.src = it.full;
      big.alt = it.alt;
      const dateText = it.dateLabel ?? (it.date ? usDate(it.date) : '');
      // A gallery that only gave a caption (an older data-caption) shows it as is.
      text.textContent = it.alt || it.caption || '';
      text.hidden = !text.textContent;
      time.hidden = !dateText || dateText === text.textContent;
      time.textContent = dateText;
      if (it.date) time.dateTime = it.date;
      else time.removeAttribute('dateTime');
    }
    function open(el: HTMLElement) {
      items = groupOf(el).map(itemOf);
      if (!items.length) items = [itemOf(el)];
      const i = Math.max(0, items.findIndex((x) => x.el === el));
      prev.hidden = next.hidden = items.length < 2;
      opener = el;
      show(i);
      dialog!.showModal();
    }

    // Clicks anywhere: gallery buttons, image links, content pictures.
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('dialog.photo-viewer')) return;
      const gallery = t.closest<HTMLElement>('[data-gallery]');
      if (gallery) return open(gallery);
      const link = t.closest<HTMLAnchorElement>('a[href]');
      if (link) {
        if (imageLink(link) && !e.metaKey && !e.ctrlKey && !e.shiftKey) {
          e.preventDefault();
          open(link);
        }
        return;
      }
      if (t instanceof HTMLImageElement && zoomableImg(t)) open(t);
    });

    // Keyboard: content pictures become focusable buttons named "Enlarge: …".
    function mark(root: ParentNode) {
      root.querySelectorAll<HTMLImageElement>('img:not([data-photo-viewer])').forEach((img) => {
        if (!zoomableImg(img)) return;
        img.dataset.photoViewer = '';
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', (dialog?.querySelector('[data-k="enlarge"]')?.textContent ?? 'Enlarge: {alt}').replace('{alt}', img.alt));
      });
      root.querySelectorAll<HTMLAnchorElement>('a[href]:not([data-photo-viewer])').forEach((a) => {
        if (imageLink(a)) a.dataset.photoViewer = '';
      });
    }
    mark(document);
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if ((e.key === 'Enter' || e.key === ' ') && t instanceof HTMLImageElement && t.hasAttribute('data-photo-viewer')) {
        e.preventDefault();
        open(t);
      }
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.photo-viewer__close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (items.length < 2) return;
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      opener?.focus?.({ preventScroll: true });
      opener = null;
    });
  }
</script>
