---
/**
 * PhotoShoot: a photo shoot seen through a camera (#318). On the left is the viewfinder (the camera's point of view):
 * chibi pixel Deo (pixel-deo/sprite.ts, the same character as StageDancer) stands still and holds the pose you tell
 * him, in front of the background you pick. On the right is the camera body: ISO, shutter speed and aperture (they
 * set the exposure, shown on the meter in the viewfinder), the lens, white balance, a filter, the background, the
 * pose, arrows to aim the camera, and the shutter. Each shot goes into a roll of 24 under the viewfinder; ↓ on a
 * photo saves it as a PNG. Under the body, the film door latch (a knurled knob, like an old film camera's) slid all the
 * way downloads the whole roll as a .zip and loads a fresh one.
 *
 * What the settings do:
 *   ISO        brighter and grainier as it goes up.
 *   Shutter    slower is brighter; below 1/60 your hands shake (a double image).
 *   Aperture   a lower f-number is brighter and blurs the background behind Deo more.
 *   Lens       fisheye (round frame, bulging middle), 16mm wide to 200mm tele; aim with the arrows when zoomed in.
 *   White bal. Auto/Daylight neutral, Cloudy and Shade warmer, Tungsten bluer, Fluorescent a little magenta.
 *   Filter     None, B&W, Retro, Vivid, Neon, Fog.
 * Everything is drawn in code (no image files), at 240 x 160 pixels; saved photos are 1200 x 800, with an optional
 * stamp line in the corner.
 *
 * Reusable on purpose: no site imports, no site CSS needed, safe to use several times on a page. Copy this file and
 * pixel-deo/sprite.ts into any Astro project. See README.md in this folder.
 *
 *   <PhotoShoot />
 *   <PhotoShoot stamp="deovandski.com" label="Photo shoot with pixel Deo" />
 *
 * Props:
 *   stamp   text written in the corner of saved photos, before the settings (none if empty). Default ''.
 *   label   what the whole thing is, for screen readers.
 *   roll    shots on a roll. Default 24.
 *
 * Theming (CSS custom properties): --photo-shoot-accent (default #e2b33c), --photo-shoot-view-max (the viewfinder's
 * tallest height, default 62vh).
 *
 * Accessible: every control is a real button (options say which one is on with aria-pressed; the settings are tabs);
 * the viewfinder can take focus, where the arrow keys aim the camera and Space or Enter takes the photo; its
 * description and a status line say what's in the frame and what just happened. Reduced motion skips the white
 * flash. It saves and sends nothing: photos stay in the page until you download them.
 */
import { DEFAULT_COLORS } from './pixel-deo/sprite';

interface Props {
  stamp?: string;
  label?: string;
  roll?: number;
  class?: string;
}
const {
  stamp = '',
  label = 'A photo shoot: a camera points at chibi pixel Deo, who holds the pose you pick.',
  roll = 24,
  class: className,
} = Astro.props;

// The option lists. The script reads each option's numbers from its button, so these are the only copy.
const lenses = [
  { label: 'Fisheye', z: 0.72, fish: true, cy: 146 },
  { label: '16mm', z: 0.7, cy: 150 },
  { label: '35mm', z: 1, cy: 146 },
  { label: '50mm', z: 1.4, cy: 138 },
  { label: '85mm', z: 1.9, cy: 130 },
  { label: '200mm', z: 2.8, cy: 122 },
];
const whites = [
  { label: 'Auto', short: 'AWB', rgb: [1, 1, 1] },
  { label: 'Daylight', short: 'WB ☀', rgb: [1, 1, 1] },
  { label: 'Cloudy', short: 'WB ☁', rgb: [1.08, 1, 0.9] },
  { label: 'Shade', short: 'WB ⌂', rgb: [1.15, 1, 0.82] },
  { label: 'Tungsten', short: 'WB 💡', rgb: [0.8, 0.94, 1.25] },
  { label: 'Fluorescent', short: 'WB ⎓', rgb: [1.04, 0.9, 1.1] },
];
const filters = ['None', 'B&W', 'Retro', 'Vivid', 'Neon', 'Fog'];
const scenes = ['Studio', 'Beach', 'Neon city', 'Concert fog', 'Snowy woods', 'Chicago lakefront', 'FITM 2025 stage', 'Hue throne room', 'The squad'];
const poses = ['Dab', 'T-pose', 'Roll Safe', 'Shrug', 'Gigachad', 'Success Kid', 'Distracted Boyfriend', 'Hide the Pain Harold', 'Jojo pose'];
const tabs = [
  { id: 'lens', label: 'Lens' },
  { id: 'wb', label: 'White balance', short: 'WB' },
  { id: 'filter', label: 'Filter' },
  { id: 'scene', label: 'Background', short: 'BG' },
  { id: 'pose', label: 'Pose' },
];
const START = { lens: 2, wb: 0, filter: 0, scene: 3, pose: 4 };
const uid = `ps${Math.random().toString(36).slice(2, 8)}`;
// What the script writes. It lives in the page so the site's translations reach it.
const strings: Record<string, string> = {
  view: 'Viewfinder: Deo, pose “{pose}”, background “{scene}”. {lens}, ISO {iso}, {shutter} second, f/{f}.',
  shot: 'Photo {n} of {roll} is on the roll.',
  full: 'Roll full. Slide the film door latch to download it and load a fresh roll.',
  empty: 'Nothing on this roll yet. Take a photo first.',
  packing: 'Packing {n} photos…',
  zipped: 'Downloaded {n} photos as a zip. Fresh roll loaded.',
  left: '{n} left',
  save: 'Save photo {n} as a PNG',
  photo: 'Photo {n}: {pose}, {scene}',
  slide: 'Slide the latch all the way to open the film door.',
  over: 'Too bright',
  under: 'Too dark',
};
---

<div class:list={['photo-shoot', className]} data-photo-shoot data-stamp={stamp} data-roll={roll} data-colors={JSON.stringify(DEFAULT_COLORS)} role="group" aria-label={label}>
  <div class="photo-shoot__strings" hidden data-llms-skip>
    {Object.entries(strings).map(([k, v]) => <span data-k={k}>{v}</span>)}
  </div>
  <div class="photo-shoot__wrap">
    <div class="photo-shoot__left">
      <div class="photo-shoot__view" tabindex="0" role="img" aria-label={label} data-view data-no-zoom>
        <canvas width="240" height="160" data-canvas></canvas>
        <div class="photo-shoot__grid" aria-hidden="true"></div>
        <div class="photo-shoot__af" aria-hidden="true"></div>
        <div class="photo-shoot__hud photo-shoot__hud--top" aria-hidden="true" translate="no"><span data-hud></span><span data-left></span></div>
        <div class="photo-shoot__hud photo-shoot__hud--bottom" aria-hidden="true">
          <span>● <span data-hud-pose></span></span>
          <span class="photo-shoot__meter" translate="no">
            <span class="photo-shoot__ticks">−2 · · · 0 · · · +2</span>
            <span class="photo-shoot__caret" data-caret>▲</span>
          </span>
        </div>
        <div class="photo-shoot__flash" data-flash aria-hidden="true"></div>
        <p class="photo-shoot__note" data-note hidden></p>
      </div>
      <div class="photo-shoot__rollbar">
        <ol class="photo-shoot__roll" data-roll-list aria-label="Roll"></ol>
      </div>
    </div>

    <div class="photo-shoot__right">
    <div class="photo-shoot__body">
      <div class="photo-shoot__brand"><span translate="no">DEO-A350</span><span data-left-body dir="auto"></span></div>
      <div class="photo-shoot__dials">
        {
          [
            ['iso', 'ISO'],
            ['shutter', 'Shutter'],
            ['aperture', 'Aperture'],
          ].map(([k, name]) => (
            <div class="photo-shoot__dial" role="group" aria-label={name}>
              <span class="photo-shoot__dial-name">{name}</span>
              <output data-out={k} translate="no" aria-live="polite"></output>
              <span class="photo-shoot__dial-row">
                <button type="button" data-step={k} data-d="-1" aria-label={`${name} −`}>−</button>
                <button type="button" data-step={k} data-d="1" aria-label={`${name} +`}>+</button>
              </span>
            </div>
          ))
        }
      </div>
      <div class="photo-shoot__tabs" role="tablist" aria-label="Camera settings">
        {
          tabs.map((t, i) => (
            <button type="button" role="tab" id={`${uid}-t-${t.id}`} aria-controls={`${uid}-p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id} aria-label={t.short ? t.label : undefined}>
              {t.short ?? t.label}
            </button>
          ))
        }
      </div>
      <div class="photo-shoot__panels">
        <div class="photo-shoot__opts" role="tabpanel" id={`${uid}-p-lens`} aria-labelledby={`${uid}-t-lens`} data-panel="lens">
          {lenses.map((o, i) => <button type="button" data-opt="lens" data-i={i} data-z={o.z} data-cy={o.cy} data-fish={o.fish ? '1' : undefined} aria-pressed={i === START.lens ? 'true' : 'false'}>{o.label}</button>)}
        </div>
        <div class="photo-shoot__opts" role="tabpanel" id={`${uid}-p-wb`} aria-labelledby={`${uid}-t-wb`} data-panel="wb" hidden>
          {whites.map((o, i) => <button type="button" data-opt="wb" data-i={i} data-rgb={o.rgb.join(',')} data-short={o.short} aria-pressed={i === START.wb ? 'true' : 'false'}>{o.label}</button>)}
        </div>
        <div class="photo-shoot__opts" role="tabpanel" id={`${uid}-p-filter`} aria-labelledby={`${uid}-t-filter`} data-panel="filter" hidden>
          {filters.map((o, i) => <button type="button" data-opt="filter" data-i={i} aria-pressed={i === START.filter ? 'true' : 'false'}>{o}</button>)}
        </div>
        <div class="photo-shoot__opts" role="tabpanel" id={`${uid}-p-scene`} aria-labelledby={`${uid}-t-scene`} data-panel="scene" hidden>
          {scenes.map((o, i) => <button type="button" data-opt="scene" data-i={i} aria-pressed={i === START.scene ? 'true' : 'false'}>{o}</button>)}
        </div>
        <div class="photo-shoot__opts" role="tabpanel" id={`${uid}-p-pose`} aria-labelledby={`${uid}-t-pose`} data-panel="pose" hidden>
          {poses.map((o, i) => <button type="button" data-opt="pose" data-i={i} aria-pressed={i === START.pose ? 'true' : 'false'}>{o}</button>)}
        </div>
      </div>
      <div class="photo-shoot__foot">
        <div class="photo-shoot__pad" role="group" aria-label="Aim the camera">
          <button type="button" class="photo-shoot__up" data-pan="0,-1" aria-label="Aim up">▲</button>
          <button type="button" class="photo-shoot__lt" data-pan="-1,0" aria-label="Aim left">◀</button>
          <button type="button" class="photo-shoot__ok" data-pan="0,0" aria-label="Aim at Deo again">⊙</button>
          <button type="button" class="photo-shoot__rt" data-pan="1,0" aria-label="Aim right">▶</button>
          <button type="button" class="photo-shoot__dn" data-pan="0,1" aria-label="Aim down">▼</button>
        </div>
        <button type="button" class="photo-shoot__shutter" data-shoot aria-label="Take the photo"></button>
      </div>
      <p class="photo-shoot__sr" aria-live="polite" data-status></p>
    </div>
    <!-- The film door latch, like an old film camera's: slide the knob all the way to open the back and swap the roll. -->
    <div class="photo-shoot__door">
      <span class="photo-shoot__door-name">Film door</span>
      <div class="photo-shoot__latch" data-latch>
        <span class="photo-shoot__groove" aria-hidden="true"><span>Replace roll</span> <span>▶</span></span>
        <span class="photo-shoot__knob" role="slider" tabindex="0" aria-label="Film door latch: slide it all the way to replace the roll" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-knob></span>
      </div>
    </div>
    </div>
  </div>
</div>

<style>
  .photo-shoot {
    --_accent: var(--photo-shoot-accent, #e2b33c);
    --_vmax: var(--photo-shoot-view-max, 62vh);
    container-type: inline-size;
    color: #e9e6df;
    font-family: inherit;
  }
  .photo-shoot__wrap {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @container (min-width: 640px) {
    .photo-shoot__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(250px, 300px);
      align-items: start;
    }
  }
  .photo-shoot__left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    align-items: center;
  }
  .photo-shoot__view {
    position: relative;
    width: min(100%, calc(var(--_vmax) * 1.5));
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    border: 2px solid #2a2b2f;
    box-sizing: border-box;
    direction: ltr;
    container-type: inline-size; /* the HUD's text follows the viewfinder's size */
  }
  .photo-shoot__view:focus-visible {
    outline: 3px solid var(--_accent);
    outline-offset: 2px;
  }
  .photo-shoot__view canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .photo-shoot__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(33.33% - 1px), rgb(255 255 255 / 0.28) 0 calc(33.33% + 1px), transparent 0 calc(66.66% - 1px), rgb(255 255 255 / 0.28) 0 calc(66.66% + 1px), transparent 0),
      linear-gradient(transparent calc(33.33% - 1px), rgb(255 255 255 / 0.28) 0 calc(33.33% + 1px), transparent 0 calc(66.66% - 1px), rgb(255 255 255 / 0.28) 0 calc(66.66% + 1px), transparent 0);
  }
  .photo-shoot__af {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22%;
    height: 34%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    --c: #7cf29a;
    background:
      linear-gradient(var(--c), var(--c)) top left / 14px 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px 14px,
      linear-gradient(var(--c), var(--c)) top right / 14px 2px,
      linear-gradient(var(--c), var(--c)) top right / 2px 14px,
      linear-gradient(var(--c), var(--c)) bottom left / 14px 2px,
      linear-gradient(var(--c), var(--c)) bottom left / 2px 14px,
      linear-gradient(var(--c), var(--c)) bottom right / 14px 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px 14px;
    background-repeat: no-repeat;
  }
  .photo-shoot__hud {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 0.5rem;
    font: 700 clamp(10px, 1.9cqi, 14px) / 1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: #fff;
    text-shadow: 0 1px 2px #000, 0 0 3px #000;
    pointer-events: none;
  }
  .photo-shoot__hud--top {
    top: 0.45rem;
  }
  .photo-shoot__hud--bottom {
    bottom: 0.45rem;
  }
  .photo-shoot__meter {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
  }
  .photo-shoot__caret {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7em;
    color: var(--_accent);
  }
  .photo-shoot__caret.is-off {
    color: #ff6b5e;
  }
  .photo-shoot__hud--bottom {
    bottom: 0.9rem;
  }
  .photo-shoot__flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .photo-shoot__flash.is-on {
    animation: photo-shoot-flash 220ms ease-out;
  }
  @keyframes photo-shoot-flash {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
    }
  }
  .photo-shoot__note {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: 80%;
    margin: 0;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.78);
    color: #fff;
    font-size: 0.9rem;
    text-align: center;
  }
  .photo-shoot__note[hidden] {
    display: none;
  }
  .photo-shoot__rollbar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: min(100%, calc(var(--_vmax) * 1.5));
  }
  /* The roll's photos are added by the script, so their rules use :global() to reach them. */
  .photo-shoot__roll {
    display: flex;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
    min-height: 44px;
    margin: 0;
    padding: 0.15rem 0;
    list-style: none;
    overflow-x: auto;
  }
  .photo-shoot__roll :global(li) {
    flex: none;
  }
  .photo-shoot__roll :global(button) {
    position: relative;
    display: block;
    width: 66px;
    height: 44px;
    padding: 0;
    border: 2px solid #34353a;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    cursor: pointer;
  }
  .photo-shoot__roll :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    display: block;
  }
  .photo-shoot__roll :global(button span) {
    position: absolute;
    right: 2px;
    bottom: 2px;
    padding: 0 4px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.7);
    color: #fff;
    font-size: 12px;
    line-height: 16px;
  }
  .photo-shoot__right {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }
  /* The film door latch: a brushed-metal plate with a groove and a knurled knob. */
  .photo-shoot__door {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.7rem;
    border-radius: 12px;
    background: linear-gradient(#3a3b40, #26272b);
    border: 2px solid #34353a;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .photo-shoot__door-name {
    font: 700 0.68rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #a8a49a;
    white-space: nowrap;
  }
  .photo-shoot__latch {
    --p: 0;
    --_k: 52px;
    position: relative;
    flex: 1;
    height: 44px;
    direction: ltr;
    touch-action: none;
    user-select: none;
  }
  .photo-shoot__groove {
    position: absolute;
    inset: 10px 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: 0 0.6rem 0 calc(var(--_k) + 0.4rem);
    border-radius: 12px;
    background: #0b0c0d;
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.8), 0 1px 0 rgb(255 255 255 / 0.06);
    color: #6f6c66;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
  }
  .photo-shoot__knob {
    position: absolute;
    top: 2px;
    left: calc(var(--p) * (100% - var(--_k)));
    width: var(--_k);
    height: 40px;
    border-radius: 8px;
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.35) 0 2px, transparent 2px 5px),
      linear-gradient(#e8e6e1, #9c9a95 55%, #d4d2cd);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.6), inset 0 1px 0 #fff;
    cursor: grab;
    transition: left 0.35s cubic-bezier(0.3, 1.4, 0.6, 1);
  }
  .photo-shoot__knob:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .photo-shoot__latch.is-dragging .photo-shoot__knob {
    cursor: grabbing;
    transition: none;
  }
  .photo-shoot__latch.is-open .photo-shoot__groove {
    color: var(--_accent);
  }
  .photo-shoot__latch.is-nudge .photo-shoot__knob {
    animation: photo-shoot-nudge 0.5s ease-out;
  }
  @keyframes photo-shoot-nudge {
    40% {
      left: 18px;
    }
  }
  .photo-shoot__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    border-radius: 16px;
    background: linear-gradient(#26272b, #1b1c1f);
    border: 2px solid #34353a;
    min-width: 0;
  }
  .photo-shoot__brand {
    display: flex;
    justify-content: space-between;
    font: 700 0.85rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.08em;
    color: #c9c5bb;
  }
  .photo-shoot__dials {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 10px;
    background: #0b0c0d;
  }
  .photo-shoot__dial {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    min-width: 0;
  }
  .photo-shoot__dial-name {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a8a49a;
  }
  .photo-shoot__dial-row {
    display: flex;
    gap: 0.2rem;
    width: 100%;
  }
  .photo-shoot__dial output {
    text-align: center;
    font: 700 0.8rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--_accent);
  }
  .photo-shoot__dial button {
    flex: 1;
    height: 32px;
    padding: 0;
    border: 1px solid #4a4b50;
    border-radius: 8px;
    background: #1d1e21;
    color: #e9e6df;
    font: inherit;
    font-size: 1.05rem;
    cursor: pointer;
  }
  .photo-shoot__tabs {
    display: flex;
    gap: 0.25rem;
  }
  .photo-shoot__tabs button {
    flex: 1;
    min-height: 36px;
    padding: 0 0.2rem;
    border: 0;
    border-radius: 8px;
    background: #141517;
    color: #b3afa5;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .photo-shoot__tabs button[aria-selected='true'] {
    background: #3a3220;
    color: var(--_accent);
  }
  .photo-shoot__panels {
    min-height: 6.6rem;
  }
  .photo-shoot__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .photo-shoot__opts[hidden] {
    display: none;
  }
  .photo-shoot__opts button {
    min-height: 32px;
    padding: 0 0.55rem;
    border: 2px solid #3d3e43;
    border-radius: 16px;
    background: #141517;
    color: #e9e6df;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }
  .photo-shoot__opts button[aria-pressed='true'] {
    border-color: var(--_accent);
    background: #3a3220;
  }
  .photo-shoot__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .photo-shoot__pad {
    display: grid;
    grid-template-columns: repeat(3, 34px);
    grid-template-rows: repeat(3, 30px);
    gap: 2px;
    direction: ltr;
  }
  .photo-shoot__pad button {
    padding: 0;
    border: 1px solid #4a4b50;
    background: #141517;
    color: #e9e6df;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .photo-shoot__up {
    grid-area: 1 / 2;
    border-radius: 8px 8px 2px 2px;
  }
  .photo-shoot__lt {
    grid-area: 2 / 1;
    border-radius: 8px 2px 2px 8px;
  }
  .photo-shoot__ok {
    grid-area: 2 / 2;
    border-radius: 50%;
  }
  .photo-shoot__rt {
    grid-area: 2 / 3;
    border-radius: 2px 8px 8px 2px;
  }
  .photo-shoot__dn {
    grid-area: 3 / 2;
    border-radius: 2px 2px 8px 8px;
  }
  .photo-shoot__shutter {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 5px solid #4a4b50;
    background: radial-gradient(circle at 40% 35%, #f0605a, #b3241f);
    box-shadow: 0 0 0 3px #111;
    cursor: pointer;
  }
  .photo-shoot__shutter:active {
    transform: scale(0.95);
  }
  .photo-shoot__shutter:disabled {
    filter: grayscale(0.8) brightness(0.7);
    cursor: not-allowed;
  }
  .photo-shoot button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .photo-shoot__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }
  /* A short screen (a phone turned sideways): drop the brand line, tighten everything. */
  @media (max-height: 520px) {
    .photo-shoot__brand {
      display: none;
    }
    .photo-shoot__body {
      gap: 0.4rem;
      padding: 0.5rem 0.6rem;
    }
    .photo-shoot__panels {
      min-height: 0;
    }
    .photo-shoot__pad {
      grid-template-rows: repeat(3, 26px);
    }
    .photo-shoot__shutter {
      width: 60px;
      height: 60px;
    }
    .photo-shoot__opts button {
      min-height: 28px;
      font-size: 0.72rem;
    }
    /* Wide enough for two columns: the arrows and the shutter get a column of their own beside the settings. */
    @container (min-width: 640px) {
      .photo-shoot__wrap {
        grid-template-columns: minmax(0, 1fr) minmax(330px, 400px);
      }
      .photo-shoot__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas: 'dials foot' 'tabs foot' 'panels foot';
        align-content: start;
        grid-area: body; /* beside both the viewfinder and the roll row */
      }
      .photo-shoot__dials {
        grid-area: dials;
      }
      .photo-shoot__tabs {
        grid-area: tabs;
      }
      .photo-shoot__panels {
        grid-area: panels;
      }
      .photo-shoot__foot {
        grid-area: foot;
        flex-direction: column-reverse;
        justify-content: start;
      }
      .photo-shoot__pad {
        grid-template-columns: repeat(3, 28px);
      }
      /* The film door moves up beside the roll, under the viewfinder, so the camera body keeps its height. */
      .photo-shoot__left,
      .photo-shoot__right {
        display: contents;
      }
      .photo-shoot__wrap {
        grid-template-columns: minmax(0, 1fr) auto minmax(330px, 380px);
        grid-template-areas: 'view view body' 'roll door body';
        row-gap: 0.4rem;
      }
      .photo-shoot__view {
        grid-area: view;
        justify-self: center;
      }
      .photo-shoot__rollbar {
        grid-area: roll;
        width: auto;
        min-width: 0;
      }
      .photo-shoot__roll {
        min-height: 38px;
        padding: 0;
      }
      .photo-shoot__roll :global(button) {
        width: 57px;
        height: 38px;
      }
      .photo-shoot__door {
        grid-area: door;
        padding: 0 0.4rem;
      }
      .photo-shoot__door-name {
        display: none;
      }
      .photo-shoot__latch {
        flex: none;
        width: 200px;
        height: 38px;
      }
      .photo-shoot__groove {
        inset: 8px 0;
      }
      .photo-shoot__knob {
        height: 34px;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-shoot__flash.is-on {
      animation: none;
    }
    .photo-shoot__knob {
      transition: none;
    }
    .photo-shoot__latch.is-nudge .photo-shoot__knob {
      animation: none;
    }
  }
</style>

<script>
  import { render, GW, GH, type Pose, type Colors } from './pixel-deo/sprite';

  const VW = 240; // the viewfinder, in pixels
  const VH = 160;
  const WW = 400; // the world the camera looks at
  const WH = 260;
  const FEET = 200; // where Deo stands
  const ISO = [100, 200, 400, 800, 1600, 3200, 6400];
  const SHUTTER = [1000, 500, 250, 125, 60, 30, 15, 8, 4, 2]; // 1/n of a second
  const APERTURE = [1.4, 2, 2.8, 4, 5.6, 8, 11, 16];

  // The poses, in the same order as the Pose buttons.
  const POSES: Pose[] = [
    { r: { elbow: [-8, -5], hand: [-14, -11], front: true }, l: { hand: [-12, -12] }, hip: -1, lean: -3, legs: 3 }, // dab
    { r: { hand: [13, 0] }, l: { hand: [-13, 0] }, hip: 0, lean: 0, legs: 2 }, // T-pose
    { r: { elbow: [6, -2], hand: [1, -13], point: true }, l: { hand: [-5, 10] }, hip: 1, lean: 0, legs: 2, look: 1 }, // Roll Safe
    { r: { elbow: [6, 5], hand: [11, -3] }, l: { elbow: [-6, 5], hand: [-11, -3] }, hip: 0, lean: 0, legs: 2, bob: -1 }, // shrug
    { r: { elbow: [9, -1], hand: [7, -10] }, l: { elbow: [-9, -1], hand: [-7, -10] }, hip: 0, lean: 0, legs: 3 }, // Gigachad
    { r: { elbow: [8, 2], hand: [6, -8] }, l: { hand: [-4, 10] }, hip: 2, lean: 1, legs: 2 }, // Success Kid
    { r: { hand: [3, 10] }, l: { hand: [-12, 3] }, hip: -1, lean: 2, legs: 2, look: 1 }, // Distracted Boyfriend
    { r: { elbow: [5, 6], hand: [8, -1], thumb: true }, l: { hand: [-4, 10] }, hip: 0, lean: 0, legs: 2, grin: true }, // Harold
    { r: { elbow: [3, -8], hand: [-4, -12], front: true }, l: { elbow: [-7, 2], hand: [-2, 9] }, hip: 3, lean: -2, legs: 3 }, // Jojo
  ];

  type RNG = () => number;
  const rng = (seed: number): RNG => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  const canvas = (w: number, h: number) => {
    const c = document.createElement('canvas');
    c.width = w;
    c.height = h;
    return c;
  };
  const ctx2d = (c: HTMLCanvasElement) => c.getContext('2d', { willReadFrequently: true })!;

  // ---- The backgrounds: each draws the world (WW x WH) in flat pixel colours; the ground starts near FEET. ----
  type Layers = { back: (g: CanvasRenderingContext2D) => void; front?: (g: CanvasRenderingContext2D) => void; squad?: boolean };
  const box = (g: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, c: string) => {
    g.fillStyle = c;
    g.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
  };
  const bands = (g: CanvasRenderingContext2D, y0: number, y1: number, cols: string[]) => {
    const h = (y1 - y0) / cols.length;
    cols.forEach((c, i) => box(g, 0, y0 + i * h, WW, h + 1, c));
  };
  const tri = (g: CanvasRenderingContext2D, pts: number[], c: string) => {
    g.fillStyle = c;
    g.beginPath();
    g.moveTo(pts[0], pts[1]);
    for (let i = 2; i < pts.length; i += 2) g.lineTo(pts[i], pts[i + 1]);
    g.closePath();
    g.fill();
  };
  const pine = (g: CanvasRenderingContext2D, x: number, base: number, h: number, c: string, snow?: string) => {
    box(g, x - 2, base - 8, 4, 8, '#3b2a1c');
    for (let k = 0; k < 3; k++) {
      const top = base - h + (k * h) / 3.4;
      const w = (h / 3) * (0.7 + k * 0.35);
      tri(g, [x, top, x - w, top + h / 2.6, x + w, top + h / 2.6], c);
      if (snow) tri(g, [x, top, x - w * 0.35, top + h / 7, x + w * 0.35, top + h / 7], snow);
    }
  };
  const crowd = (g: CanvasRenderingContext2D, seed: number) => {
    const r = rng(seed);
    for (let x = -10; x < WW + 10; x += 14 + r() * 8) {
      const y = 228 + r() * 10;
      box(g, x - 9, y + 6, 18, 40, '#06040b');
      box(g, x - 6, y - 4, 12, 12, '#06040b');
      if (r() < 0.3) box(g, x + 6, y - 22, 3, 24, '#06040b'); // a raised hand
    }
  };
  const SCENES: Layers[] = [
    // Studio: a grey paper backdrop and two softboxes.
    {
      back(g) {
        bands(g, 0, 190, ['#3a444d', '#404b55', '#46525d', '#4d5a66', '#55636f', '#5d6b78']);
        bands(g, 190, WH, ['#66747f', '#6e7c87', '#76848f']);
        for (const x of [36, 364]) {
          box(g, x - 1, 70, 2, 140, '#1a1d21');
          box(g, x - 18, 52, 36, 26, '#f4f6f8');
          box(g, x - 18, 74, 36, 4, '#9aa3ad');
          tri(g, [x - 14, 212, x, 196, x + 14, 212], '#1a1d21');
        }
      },
    },
    // Beach: sky, sun, sea, sand and a palm tree.
    {
      back(g) {
        bands(g, 0, 124, ['#5fb8ec', '#6ec1ef', '#7dcaf2', '#8dd2f4', '#9ddbf6']);
        g.fillStyle = '#fff3b0';
        g.beginPath();
        g.arc(330, 38, 16, 0, Math.PI * 2);
        g.fill();
        bands(g, 124, 176, ['#2a86c4', '#2f8fcb', '#3598d1', '#3ba1d6']);
        const r = rng(7);
        for (let i = 0; i < 40; i++) box(g, r() * WW, 128 + r() * 44, 6 + r() * 6, 1, '#bfe6f7');
        box(g, 0, 176, WW, 10, '#d9bf86');
        box(g, 0, 186, WW, WH - 186, '#f0d79d');
        for (let i = 0; i < 120; i++) box(g, r() * WW, 188 + r() * 70, 1, 1, '#d8bb7c');
        for (let i = 0; i < 12; i++) box(g, 52 + i * 1.5, 196 - i * 9, 6, 9, i % 2 ? '#8a5a2b' : '#7a4c22');
        const top = [70, 88];
        for (const [dx, dy] of [[-30, 10], [-22, -6], [26, 8], [20, -8], [0, -14]])
          tri(g, [top[0], top[1], top[0] + dx, top[1] + dy, top[0] + dx * 0.8, top[1] + dy + 6], '#2e8b3e');
      },
    },
    // Neon city: night towers with lit windows and a pink-lit wet street.
    {
      back(g) {
        bands(g, 0, 180, ['#120826', '#170a30', '#1d0c3a', '#250f46', '#2f1253', '#3b1660']);
        const r = rng(3);
        for (let i = 0; i < 40; i++) box(g, r() * WW, r() * 90, 1, 1, '#c9b8ff');
        for (let x = -10; x < WW; ) {
          const w = 22 + r() * 30;
          const h = 60 + r() * 100;
          box(g, x, 196 - h, w, h, r() < 0.5 ? '#1a1030' : '#22143b');
          for (let wy = 196 - h + 6; wy < 190; wy += 8)
            for (let wx = x + 4; wx < x + w - 4; wx += 7) if (r() < 0.45) box(g, wx, wy, 3, 4, ['#ffd166', '#5ef2ff', '#ff6fb5'][Math.floor(r() * 3)]);
          if (r() < 0.3) box(g, x + 4, 196 - h - 10, w - 8, 6, r() < 0.5 ? '#ff4fa3' : '#38f2e6');
          x += w + 2;
        }
        box(g, 0, 196, WW, 3, '#ff4fa3');
        box(g, 0, 199, WW, WH - 199, '#120a1f');
        for (let i = 0; i < 30; i++) box(g, r() * WW, 205 + r() * 50, 10 + r() * 20, 1, ['#ff4fa3', '#38f2e6', '#ffd166'][i % 3]);
      },
    },
    // Concert fog: spotlights through smoke, Deo on stage, the crowd in front.
    {
      back(g) {
        box(g, 0, 0, WW, WH, '#0d0718');
        box(g, 0, 14, WW, 6, '#2b2b33');
        for (const [x, c] of [[90, 'rgb(170 120 255 / 0.28)'], [200, 'rgb(255 236 170 / 0.3)'], [310, 'rgb(80 230 220 / 0.26)']] as [number, string][]) {
          tri(g, [x - 6, 20, x + 6, 20, x + 70, 205, x - 70, 205], c);
          box(g, x - 6, 18, 12, 6, '#f6f1d0');
        }
        for (const x of [14, 352]) {
          box(g, x, 120, 34, 80, '#15121c');
          for (let y = 128; y < 196; y += 18) box(g, x + 9, y, 16, 14, '#2c2836');
        }
        box(g, 0, 200, WW, 30, '#2a2030');
        g.globalAlpha = 0.14;
        for (let y = 150; y < 215; y += 9) box(g, 0, y, WW, 6, '#ddd6f0');
        g.globalAlpha = 1;
      },
      front(g) {
        crowd(g, 11);
      },
    },
    // Snowy woods: pines with snow on their branches.
    {
      back(g) {
        bands(g, 0, 196, ['#b6cfe2', '#c0d6e7', '#cadeec', '#d4e5f0', '#deebf4']);
        for (let x = 10; x < WW; x += 34) pine(g, x, 190, 70, '#8fa9b8', '#e8f0f6');
        for (const x of [24, 86, 330, 382]) pine(g, x, 204, 130, '#2f5a46', '#f4f8fb');
        box(g, 0, 196, WW, WH - 196, '#f4f8fb');
        const r = rng(5);
        for (let i = 0; i < 50; i++) box(g, r() * WW, 200 + r() * 60, 8 + r() * 14, 1, '#d6e3ee');
        for (let i = 0; i < 90; i++) box(g, r() * WW, r() * WH, 1, 1, '#ffffff');
      },
    },
    // Chicago lakefront: the skyline over Lake Michigan from the lakefront path.
    {
      back(g) {
        bands(g, 0, 140, ['#86c5ef', '#93cbf1', '#a0d2f3', '#aed9f5', '#bde0f6']);
        const r = rng(9);
        for (let x = 60; x < 360; ) {
          const w = 10 + r() * 16;
          const h = 30 + r() * 60;
          box(g, x, 140 - h, w, h, r() < 0.5 ? '#6f7f93' : '#5f6f84');
          x += w + 1;
        }
        box(g, 248, 22, 26, 118, '#2d3440'); // a tall black tower with two antennas
        box(g, 252, 4, 2, 18, '#2d3440');
        box(g, 268, 4, 2, 18, '#2d3440');
        tri(g, [142, 140, 146, 44, 166, 44, 170, 140], '#343b47'); // a tapered tower
        box(g, 149, 26, 2, 18, '#343b47');
        box(g, 161, 26, 2, 18, '#343b47');
        bands(g, 140, 186, ['#2c7fb8', '#2f86bf', '#338dc5', '#3794cb']);
        for (let i = 0; i < 40; i++) box(g, r() * WW, 144 + r() * 40, 5 + r() * 6, 1, '#9fd0ee');
        box(g, 0, 186, WW, 8, '#b8b2a3');
        box(g, 0, 194, WW, WH - 194, '#d8d2c4');
        for (let x = 0; x < WW; x += 20) box(g, x, 194, 1, WH - 194, '#c6bfae');
      },
    },
    // FITM 2025 stage: mountains, pines and string lights at night.
    {
      back(g) {
        bands(g, 0, 160, ['#070d1b', '#0a1222', '#0d172a', '#111d33']);
        const r = rng(13);
        for (let i = 0; i < 70; i++) box(g, r() * WW, r() * 110, 1, 1, '#dfe7ff');
        tri(g, [0, 170, 90, 70, 190, 170], '#1b2638');
        tri(g, [130, 170, 260, 50, 400, 170], '#24324a');
        tri(g, [236, 64, 260, 50, 284, 66], '#c9d4e6');
        for (let x = 0; x < WW; x += 22) pine(g, x + r() * 8, 196, 60 + r() * 40, '#0b1712');
        box(g, 70, 120, 6, 80, '#5a3a22');
        box(g, 324, 120, 6, 80, '#5a3a22');
        box(g, 70, 116, 260, 6, '#5a3a22');
        for (let x = 80; x < 324; x += 10) box(g, x, 126 + Math.sin(x / 26) * 4, 3, 3, '#ffc35a');
        box(g, 0, 196, WW, WH - 196, '#3b2a1c');
        for (let x = 0; x < WW; x += 16) box(g, x, 196, 1, WH - 196, '#2e2016');
        g.globalAlpha = 0.25;
        for (const [x, rr] of [[200, 110], [200, 70]] as [number, number][]) {
          g.fillStyle = '#ff9b3d';
          g.beginPath();
          g.ellipse(x, 160, rr, rr * 0.6, 0, 0, Math.PI * 2);
          g.fill();
        }
        g.globalAlpha = 1;
      },
    },
    // Hue throne room: the palace hall from the King of Hues photo on the Traveler tab.
    { back: throneRoom },
    // The squad: the same hall, with five friends in blue áo dài behind Deo.
    { back: throneRoom, squad: true },
  ];
  function throneRoom(g: CanvasRenderingContext2D) {
    box(g, 0, 0, WW, 200, '#f3ead2');
    for (const x of [60, 150, 250, 340]) {
      box(g, x - 22, 10, 44, 180, '#e2b33c');
      box(g, x - 18, 14, 36, 172, '#f6eedb');
      for (let y = 24; y < 180; y += 22) {
        box(g, x - 2, y, 4, 14, '#a3332b');
        box(g, x - 8, y + 4, 16, 3, '#a3332b');
      }
    }
    box(g, 170, 40, 60, 150, '#aab3dd'); // the lilac doorway behind the throne
    for (const x of [24, 376]) {
      box(g, x - 10, 0, 20, 200, '#9e2a22');
      for (let y = 10; y < 200; y += 26) box(g, x - 6, y, 12, 6, '#c2453a');
    }
    box(g, 172, 96, 56, 70, '#c9a227'); // a gold throne
    box(g, 178, 102, 44, 58, '#e3c04a');
    box(g, 186, 84, 28, 14, '#c9a227');
    box(g, 0, 196, WW, WH - 196, '#b8312a');
    box(g, 0, 196, WW, 3, '#8f231d');
    for (let x = 0; x < WW; x += 30) box(g, x, 200, 1, WH - 200, '#a72b25');
  }

  // ---- Five friends in the blue áo dài, white trousers and feathered hats from the King of Hues photo. ----
  const LW = 40;
  const LH = 62;
  function renderFriend(skin: string): (string | null)[][] {
    const g: (string | null)[][] = Array.from({ length: LH }, () => Array(LW).fill(null));
    const set = (x: number, y: number, c: string) => {
      x = Math.round(x);
      y = Math.round(y);
      if (x >= 0 && y >= 0 && x < LW && y < LH) g[y][x] = c;
    };
    const rect = (x: number, y: number, w: number, h: number, c: string) => {
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) set(x + i, y + j, c);
    };
    const ell = (cx: number, cy: number, rx: number, ry: number, c: string, from = -99, to = 99) => {
      for (let y = Math.floor(cy - ry); y <= cy + ry; y++)
        for (let x = Math.floor(cx - rx); x <= cx + rx; x++)
          if (y >= from && y <= to && ((x - cx) / (rx + 0.4)) ** 2 + ((y - cy) / (ry + 0.4)) ** 2 <= 1) set(x, y, c);
    };
    const line = (x0: number, y0: number, x1: number, y1: number, w: number, c: string) => {
      const n = Math.ceil(Math.hypot(x1 - x0, y1 - y0) * 2);
      for (let i = 0; i <= n; i++) rect(x0 + ((x1 - x0) * i) / n - w / 2, y0 + ((y1 - y0) * i) / n - w / 2, w, w, c);
    };
    const cx = 20;
    // The white feather fan behind the hat, with a red medallion.
    ell(cx, 15, 13, 13, '#f4f1ea', -99, 18);
    for (let a = 0.15; a < Math.PI; a += 0.3) set(cx + Math.cos(a) * 11, 15 - Math.sin(a) * 11, '#d9d3c4');
    ell(cx, 9, 3, 4, '#c8232c');
    set(cx, 9, '#f2c230');
    // Trousers and black shoes.
    rect(cx - 4, 50, 3, 7, '#ffffff');
    rect(cx + 1, 50, 3, 7, '#ffffff');
    rect(cx - 5, 57, 4, 2, '#141012');
    rect(cx + 1, 57, 4, 2, '#141012');
    // The áo dài: a fitted blue tunic to below the knee, with a lighter pattern.
    for (let y = 30; y <= 52; y++) {
      const half = y < 38 ? 5 : 5 + (y - 38) * 0.15;
      for (let x = Math.round(cx - half); x <= Math.round(cx + half); x++) set(x, y, (x * 5 + y * 3) % 9 === 0 ? '#7fa8dc' : '#4a7fc0');
    }
    // Sleeves to clasped hands at the waist, flared at the end.
    for (const s of [-1, 1]) {
      line(cx + s * 5, 31, cx + s * 7, 37, 3, '#4a7fc0');
      line(cx + s * 7, 37, cx + s * 2, 40, 3, '#4a7fc0');
    }
    rect(cx - 2, 39, 4, 3, skin);
    // Neck, head and black hair.
    rect(cx - 1, 27, 3, 3, skin);
    rect(cx - 2, 29, 5, 1, '#4a7fc0'); // the high collar
    ell(cx, 21, 7, 7, '#141012');
    ell(cx, 22, 6, 6, skin, 18, 99);
    rect(cx - 3, 22, 2, 2, '#0b0b0b');
    rect(cx + 2, 22, 2, 2, '#0b0b0b');
    set(cx - 3, 22, '#ffffff');
    set(cx + 2, 22, '#ffffff');
    rect(cx - 1, 26, 3, 1, '#7d2a2a');
    // The round yellow hat.
    rect(cx - 8, 13, 17, 4, '#f2c230');
    rect(cx - 8, 16, 17, 1, '#c99a1c');
    rect(cx - 6, 11, 13, 2, '#f2c230');
    const out = g.map((row) => row.slice());
    for (let y = 0; y < LH; y++)
      for (let x = 0; x < LW; x++) if (!g[y][x] && (g[y - 1]?.[x] || g[y + 1]?.[x] || g[y][x - 1] || g[y][x + 1])) out[y][x] = '#0d0b10';
    return out;
  }

  const paint = (g: CanvasRenderingContext2D, grid: (string | null)[][], ox: number, oy: number, p: number) => {
    grid.forEach((row, y) =>
      row.forEach((c, x) => {
        if (c) box(g, ox + x * p, oy + y * p, p, p, c);
      }),
    );
  };

  // A box blur in place (radius r pixels, three passes look close to a soft lens blur).
  function blur(c: HTMLCanvasElement, r: number) {
    if (r <= 0) return;
    const g = ctx2d(c);
    const img = g.getImageData(0, 0, c.width, c.height);
    const d = img.data;
    const w = c.width;
    const h = c.height;
    const tmp = new Uint8ClampedArray(d.length);
    for (let pass = 0; pass < 2; pass++) {
      for (let y = 0; y < h; y++)
        for (let x = 0; x < w; x++) {
          let rr = 0, gg = 0, bb = 0, aa = 0, n = 0;
          for (let k = -r; k <= r; k++) {
            const xx = Math.min(w - 1, Math.max(0, x + k));
            const i = (y * w + xx) * 4;
            rr += d[i]; gg += d[i + 1]; bb += d[i + 2]; aa += d[i + 3]; n++;
          }
          const o = (y * w + x) * 4;
          tmp[o] = rr / n; tmp[o + 1] = gg / n; tmp[o + 2] = bb / n; tmp[o + 3] = aa / n;
        }
      for (let y = 0; y < h; y++)
        for (let x = 0; x < w; x++) {
          let rr = 0, gg = 0, bb = 0, aa = 0, n = 0;
          for (let k = -r; k <= r; k++) {
            const yy = Math.min(h - 1, Math.max(0, y + k));
            const i = (yy * w + x) * 4;
            rr += tmp[i]; gg += tmp[i + 1]; bb += tmp[i + 2]; aa += tmp[i + 3]; n++;
          }
          const o = (y * w + x) * 4;
          d[o] = rr / n; d[o + 1] = gg / n; d[o + 2] = bb / n; d[o + 3] = aa / n;
        }
    }
    g.putImageData(img, 0, 0);
  }

  // ---- A .zip file in plain code (stored, no compression: PNGs are compressed already). ----
  const CRC = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
      t[n] = c >>> 0;
    }
    return t;
  })();
  const crc32 = (b: Uint8Array) => {
    let c = 0xffffffff;
    for (let i = 0; i < b.length; i++) c = CRC[(c ^ b[i]) & 0xff] ^ (c >>> 8);
    return (c ^ 0xffffffff) >>> 0;
  };
  function zip(files: { name: string; data: Uint8Array }[]): Blob {
    const now = new Date();
    const time = (now.getHours() << 11) | (now.getMinutes() << 5) | (now.getSeconds() >> 1);
    const date = ((now.getFullYear() - 1980) << 9) | ((now.getMonth() + 1) << 5) | now.getDate();
    const parts: BlobPart[] = [];
    const central: Uint8Array[] = [];
    let offset = 0;
    for (const f of files) {
      const name = new TextEncoder().encode(f.name);
      const crc = crc32(f.data);
      const local = new DataView(new ArrayBuffer(30));
      local.setUint32(0, 0x04034b50, true);
      local.setUint16(4, 20, true);
      local.setUint16(10, time, true);
      local.setUint16(12, date, true);
      local.setUint32(14, crc, true);
      local.setUint32(18, f.data.length, true);
      local.setUint32(22, f.data.length, true);
      local.setUint16(26, name.length, true);
      parts.push(local.buffer, name, f.data as BlobPart);
      const cen = new DataView(new ArrayBuffer(46));
      cen.setUint32(0, 0x02014b50, true);
      cen.setUint16(4, 20, true);
      cen.setUint16(6, 20, true);
      cen.setUint16(12, time, true);
      cen.setUint16(14, date, true);
      cen.setUint32(16, crc, true);
      cen.setUint32(20, f.data.length, true);
      cen.setUint32(24, f.data.length, true);
      cen.setUint16(28, name.length, true);
      cen.setUint32(42, offset, true);
      const entry = new Uint8Array(46 + name.length);
      entry.set(new Uint8Array(cen.buffer), 0);
      entry.set(name, 46);
      central.push(entry);
      offset += 30 + name.length + f.data.length;
    }
    const size = central.reduce((s, c) => s + c.length, 0);
    const end = new DataView(new ArrayBuffer(22));
    end.setUint32(0, 0x06054b50, true);
    end.setUint16(8, files.length, true);
    end.setUint16(10, files.length, true);
    end.setUint32(12, size, true);
    end.setUint32(16, offset, true);
    return new Blob([...parts, ...(central as BlobPart[]), end.buffer], { type: 'application/zip' });
  }
  const download = (blob: Blob, name: string) => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  };

  // ---- Colour: the filters as 3x3 matrices, applied after exposure and white balance. ----
  const sat = (s: number) => {
    const r = 0.2126 * (1 - s), gg = 0.7152 * (1 - s), b = 0.0722 * (1 - s);
    return [r + s, gg, b, r, gg + s, b, r, gg, b + s];
  };
  const hue = (deg: number) => {
    const a = (deg * Math.PI) / 180, c = Math.cos(a), s = Math.sin(a);
    return [
      0.213 + c * 0.787 - s * 0.213, 0.715 - c * 0.715 - s * 0.715, 0.072 - c * 0.072 + s * 0.928,
      0.213 - c * 0.213 + s * 0.143, 0.715 + c * 0.285 + s * 0.14, 0.072 - c * 0.072 - s * 0.283,
      0.213 - c * 0.213 - s * 0.787, 0.715 - c * 0.715 + s * 0.715, 0.072 + c * 0.928 + s * 0.072,
    ];
  };
  const mul = (a: number[], b: number[]) => {
    const o: number[] = [];
    for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) o.push(a[i * 3] * b[j] + a[i * 3 + 1] * b[3 + j] + a[i * 3 + 2] * b[6 + j]);
    return o;
  };
  const SEPIA = [0.393, 0.769, 0.189, 0.349, 0.686, 0.168, 0.272, 0.534, 0.131];
  // [matrix, contrast, lift (faded blacks), fog]
  const FILTERS: [number[] | null, number, number, number][] = [
    [null, 1, 0, 0],
    [sat(0), 1.15, 0, 0],
    [mul(SEPIA, sat(0.85)).map((v, i) => v * 0.6 + (i % 4 === 0 ? 0.4 : 0)), 0.92, 18, 0],
    [sat(1.6), 1.15, 0, 0],
    [mul(hue(250), sat(1.8)), 1.05, 0, 0],
    [null, 0.8, 0, 0.38],
  ];

  for (const root of document.querySelectorAll<HTMLElement>('[data-photo-shoot]')) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const words: Record<string, string> = {};
    for (const s of $$('[data-k]')) words[s.dataset.k!] = s.textContent ?? '';
    const msg = (k: string, vars: Record<string, string | number> = {}) => (words[k] ?? k).replace(/\{(\w+)\}/g, (_, v) => String(vars[v] ?? ''));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const colors: Colors = JSON.parse(root.dataset.colors!);
    const ROLL = Number(root.dataset.roll) || 24;
    const stamp = root.dataset.stamp ?? '';
    const view = $<HTMLCanvasElement>('[data-canvas]');
    const vg = ctx2d(view);
    vg.imageSmoothingEnabled = false;
    const opts = (k: string) => $$<HTMLButtonElement>(`[data-opt="${k}"]`);

    const st = { iso: 2, shutter: 2, aperture: 2, lens: 0, wb: 0, filter: 0, scene: 0, pose: 0, px: 0, py: 0 };
    for (const k of ['lens', 'wb', 'filter', 'scene', 'pose'] as const) st[k] = Math.max(0, opts(k).findIndex((b) => b.getAttribute('aria-pressed') === 'true'));
    const label = (k: string, i: number) => opts(k)[i]?.textContent?.trim() ?? '';

    // The layers, kept until the background or pose changes.
    let backCache = { key: '', back: canvas(WW, WH), mid: canvas(WW, WH), front: canvas(WW, WH) };
    const world = canvas(WW, WH);
    const wg = ctx2d(world);
    const friends = ['#6b4226', '#4a2c1b', '#8a5a3b', '#3a2416', '#7a4a2e'].map(renderFriend);
    function layers() {
      const r = Math.max(0, [3, 3, 2, 1, 1, 0, 0, 0][st.aperture]);
      const key = `${st.scene}:${r}`;
      if (backCache.key === key) return backCache;
      const sc = SCENES[st.scene];
      const back = canvas(WW, WH);
      const bg = ctx2d(back);
      bg.imageSmoothingEnabled = false;
      sc.back(bg);
      blur(back, r);
      const mid = canvas(WW, WH);
      if (sc.squad) {
        const mg = ctx2d(mid);
        // Four in a row behind Deo; the fifth stands on the throne's step right behind him, her face just over his crown.
        [-132, -72, 72, 132, 0].forEach((dx, i) => paint(mg, friends[i], WW / 2 + dx - LW, FEET - 10 - LH * 2 + (i === 4 ? -22 : 0), 2));
        blur(mid, Math.max(0, r - 1));
      }
      const front = canvas(WW, WH);
      if (sc.front) {
        const fg = ctx2d(front);
        sc.front(fg);
        blur(front, r + 1);
      }
      backCache = { key, back, mid, front };
      return backCache;
    }
    function drawWorld() {
      const L = layers();
      wg.clearRect(0, 0, WW, WH);
      wg.drawImage(L.back, 0, 0);
      wg.drawImage(L.mid, 0, 0);
      paint(wg, render(POSES[st.pose], colors), WW / 2 - GW, FEET - GH * 2 + 4, 2);
      wg.drawImage(L.front, 0, 0);
    }

    const lens = () => {
      const b = opts('lens')[st.lens];
      return { z: Number(b.dataset.z), cy: Number(b.dataset.cy), fish: b.dataset.fish === '1' };
    };
    // Where the camera points: the lens's own aim at Deo, plus the arrows, kept inside the world.
    function frame() {
      const L = lens();
      const sw = VW / L.z;
      const sh = VH / L.z;
      const cx = Math.min(WW - sw / 2, Math.max(sw / 2, WW / 2 + st.px));
      const cy = Math.min(WH - sh / 2, Math.max(sh / 2, L.cy + st.py));
      st.px = cx - WW / 2;
      st.py = cy - L.cy;
      return { sx: cx - sw / 2, sy: cy - sh / 2, sw, sh, fish: L.fish };
    }
    const ev = () => Math.log2(ISO[st.iso] / 400) + Math.log2(250 / SHUTTER[st.shutter]) + 2 * Math.log2(2.8 / APERTURE[st.aperture]);

    function draw() {
      drawWorld();
      const f = frame();
      vg.clearRect(0, 0, VW, VH);
      // A slow shutter held by hand: a faint second copy, a little to the side.
      const shake = SHUTTER[st.shutter] <= 30 ? Math.min(4, Math.round(60 / SHUTTER[st.shutter])) : 0;
      if (f.fish) fisheye(f);
      else {
        vg.drawImage(world, f.sx, f.sy, f.sw, f.sh, 0, 0, VW, VH);
        if (shake) {
          vg.globalAlpha = 0.45;
          vg.drawImage(world, f.sx + shake / 2, f.sy - shake / 3, f.sw, f.sh, 0, 0, VW, VH);
          vg.globalAlpha = 1;
        }
      }
      develop(f.fish);
      hud();
    }
    function fisheye(f: { sx: number; sy: number; sw: number; sh: number }) {
      const src = wg.getImageData(0, 0, WW, WH).data;
      const out = vg.createImageData(VW, VH);
      const R = VH / 2;
      const cx = f.sx + f.sw / 2;
      const cy = f.sy + f.sh / 2;
      for (let y = 0; y < VH; y++)
        for (let x = 0; x < VW; x++) {
          const u = (x - VW / 2) / R;
          const v = (y - VH / 2) / R;
          const r = Math.hypot(u, v);
          const o = (y * VW + x) * 4;
          out.data[o + 3] = 255;
          if (r > 1) continue;
          const k = 0.55 + 0.6 * r * r; // the middle bulges, the edges squeeze in more of the room
          const sx = Math.round(cx + u * k * (f.sh / 2));
          const sy = Math.round(cy + v * k * (f.sh / 2));
          if (sx < 0 || sy < 0 || sx >= WW || sy >= WH) continue;
          const i = (sy * WW + sx) * 4;
          out.data[o] = src[i];
          out.data[o + 1] = src[i + 1];
          out.data[o + 2] = src[i + 2];
        }
      vg.putImageData(out, 0, 0);
    }
    // Bright parts roll off towards white instead of clipping flat (like film).
    const shoulder = (v: number) => (v <= 190 ? v : 190 + 65 * (1 - Math.exp(-(v - 190) / 65)));
    // Exposure, white balance, the filter, grain and (for Retro and the fisheye) a vignette.
    function develop(fish: boolean) {
      const img = vg.getImageData(0, 0, VW, VH);
      const d = img.data;
      const gain = Math.pow(2, ev() * 0.45); // gentler than real stops, so a few stops off still shows a picture
      const wb = opts('wb')[st.wb].dataset.rgb!.split(',').map(Number);
      const [m, contrast, lift, fog] = FILTERS[st.filter];
      const grain = [0, 3, 6, 10, 18, 28, 42][st.iso];
      const vignette = st.filter === 2 || fish;
      const noise = rng(1 + Math.floor(Math.random() * 1e6));
      for (let y = 0; y < VH; y++)
        for (let x = 0; x < VW; x++) {
          const i = (y * VW + x) * 4;
          if (fish && Math.hypot(x - VW / 2, y - VH / 2) > VH / 2) continue;
          let r = d[i] * gain * wb[0];
          let g = d[i + 1] * gain * wb[1];
          let b = d[i + 2] * gain * wb[2];
          if (m) [r, g, b] = [m[0] * r + m[1] * g + m[2] * b, m[3] * r + m[4] * g + m[5] * b, m[6] * r + m[7] * g + m[8] * b];
          r = (r - 128) * contrast + 128 + lift;
          g = (g - 128) * contrast + 128 + lift;
          b = (b - 128) * contrast + 128 + lift;
          if (fog) {
            const k = fog * (1 - (y / VH) * 0.5);
            r += (214 - r) * k;
            g += (218 - g) * k;
            b += (224 - b) * k;
          }
          if (grain) {
            const n = (noise() - 0.5) * grain;
            r += n;
            g += n;
            b += n;
          }
          if (vignette) {
            const k = 1 - Math.max(0, Math.hypot((x - VW / 2) / (VW / 2), (y - VH / 2) / (VH / 2)) - 0.55) * 0.9;
            r *= k;
            g *= k;
            b *= k;
          }
          d[i] = shoulder(r);
          d[i + 1] = shoulder(g);
          d[i + 2] = shoulder(b);
        }
      vg.putImageData(img, 0, 0);
    }

    const shutterText = () => `1/${SHUTTER[st.shutter]}`;
    const fText = () => String(APERTURE[st.aperture]);
    // Each shot is taken at once; its PNG finishes in the background (ready), so fast tapping never drops a shot.
    const shots: { ready: Promise<Blob>; blob?: Blob; url?: string; pose: string; scene: string }[] = [];
    function hud() {
      const L = label('lens', st.lens);
      const wbShort = opts('wb')[st.wb].dataset.short ?? '';
      $('[data-hud]').textContent = `ISO ${ISO[st.iso]} · ${shutterText()} · f/${fText()} · ${L} · ${wbShort}`;
      const left = msg('left', { n: ROLL - shots.length });
      $('[data-left]').textContent = `▮▮▮▯ ${left}`;
      $('[data-left-body]').textContent = left;
      $('[data-hud-pose]').textContent = label('pose', st.pose);
      const e = Math.max(-2.4, Math.min(2.4, ev()));
      const caret = $('[data-caret]');
      caret.style.left = `${50 + (e / 2.4) * 46}%`;
      caret.classList.toggle('is-off', Math.abs(ev()) > 1.5);
      $('[data-out="iso"]').textContent = String(ISO[st.iso]);
      $('[data-out="shutter"]').textContent = shutterText();
      $('[data-out="aperture"]').textContent = `f/${fText()}`;
      const desc = msg('view', { pose: label('pose', st.pose), scene: label('scene', st.scene), lens: L, iso: ISO[st.iso], shutter: shutterText(), f: fText() });
      const exp = ev() > 1.5 ? ` ${msg('over')}.` : ev() < -1.5 ? ` ${msg('under')}.` : '';
      $('[data-view]').setAttribute('aria-label', desc + exp);
      $<HTMLButtonElement>('[data-shoot]').disabled = shots.length >= ROLL;
    }

    let noteTimer = 0;
    const say = (text: string, show = false) => {
      $('[data-status]').textContent = text;
      const note = $('[data-note]');
      clearTimeout(noteTimer);
      note.hidden = !show;
      note.textContent = text;
      if (show) noteTimer = window.setTimeout(() => (note.hidden = true), 3200);
    };

    // The shutter's click: a short burst of filtered noise.
    let audio: AudioContext | null = null;
    function click() {
      try {
        audio ??= new AudioContext();
        const t = audio.currentTime;
        const buf = audio.createBuffer(1, audio.sampleRate * 0.08, audio.sampleRate);
        const ch = buf.getChannelData(0);
        for (let i = 0; i < ch.length; i++) ch[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ch.length / 6)) * (i < ch.length / 2 || i > ch.length * 0.6 ? 1 : 0.2);
        const src = audio.createBufferSource();
        src.buffer = buf;
        const bp = audio.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = 2400;
        const gn = audio.createGain();
        gn.gain.setValueAtTime(0.5, t);
        src.connect(bp).connect(gn).connect(audio.destination);
        src.start(t);
      } catch {
        /* no sound, no problem */
      }
    }

    // A saved photo: the viewfinder at 5x, with the stamp and the settings in the corner.
    function photo(): HTMLCanvasElement {
      const out = canvas(VW * 5, VH * 5);
      const g = ctx2d(out);
      g.imageSmoothingEnabled = false;
      g.drawImage(view, 0, 0, out.width, out.height);
      const line = [stamp, `ISO ${ISO[st.iso]}`, shutterText(), `f/${fText()}`, label('lens', st.lens)].filter(Boolean).join(' · ');
      g.font = 'bold 22px ui-monospace, Menlo, Consolas, monospace';
      const w = g.measureText(line).width;
      g.fillStyle = 'rgb(0 0 0 / 0.55)';
      g.fillRect(out.width - w - 28, out.height - 44, w + 20, 34);
      g.fillStyle = '#fff';
      g.textBaseline = 'middle';
      g.fillText(line, out.width - w - 18, out.height - 27);
      return out;
    }
    const png = (c: HTMLCanvasElement) => new Promise<Blob>((ok) => c.toBlob((b) => ok(b!), 'image/png'));
    const pad = (n: number) => String(n).padStart(2, '0');
    const today = () => {
      const d = new Date();
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    };
    function drawRoll() {
      const list = $('[data-roll-list]');
      list.replaceChildren(
        ...shots.map((s, i) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.setAttribute('aria-label', msg('save', { n: i + 1 }));
          const tag = document.createElement('span');
          tag.textContent = '↓';
          tag.setAttribute('aria-hidden', 'true');
          if (s.url) {
            // Until its PNG is ready, a photo is a dark frame.
            const img = document.createElement('img');
            img.src = s.url;
            img.alt = msg('photo', { n: i + 1, pose: s.pose, scene: s.scene });
            img.dataset.noZoom = '';
            b.append(img);
          }
          b.append(tag);
          b.addEventListener('click', async () => download(await s.ready, `deo-photo-${pad(i + 1)}.png`));
          li.append(b);
          return li;
        }),
      );
      list.scrollLeft = list.scrollWidth;
    }
    function shoot() {
      if (shots.length >= ROLL) return say(msg('full'), true);
      click();
      if (!reduced) {
        const fl = $('[data-flash]');
        fl.classList.remove('is-on');
        void fl.offsetWidth;
        fl.classList.add('is-on');
      }
      draw(); // fresh grain for every frame
      const shot: (typeof shots)[number] = { ready: png(photo()), pose: label('pose', st.pose), scene: label('scene', st.scene) };
      shots.push(shot);
      shot.ready.then((blob) => {
        if (!shots.includes(shot)) return; // the roll was replaced meanwhile
        shot.blob = blob;
        shot.url = URL.createObjectURL(blob);
        drawRoll();
      });
      hud();
      say(shots.length >= ROLL ? msg('full') : msg('shot', { n: shots.length, roll: ROLL }), shots.length >= ROLL);
    }
    async function replaceRoll() {
      if (!shots.length) say(msg('empty'), true);
      else {
        const n = shots.length;
        say(msg('packing', { n }));
        const files = await Promise.all(shots.map(async (s, i) => ({ name: `deo-photo-${pad(i + 1)}.png`, data: new Uint8Array(await (await s.ready).arrayBuffer()) })));
        download(zip(files), `deo-photo-roll-${today()}.zip`);
        for (const s of shots) if (s.url) URL.revokeObjectURL(s.url);
        shots.length = 0;
        drawRoll();
        hud();
        say(msg('zipped', { n }), true);
      }
    }

    // The film door: the latch's clunk, then the motor rewinding the film.
    function doorSound() {
      try {
        audio ??= new AudioContext();
        const t = audio.currentTime;
        const buf = audio.createBuffer(1, audio.sampleRate * 0.06, audio.sampleRate);
        const ch = buf.getChannelData(0);
        for (let i = 0; i < ch.length; i++) ch[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ch.length / 5));
        const clunk = audio.createBufferSource();
        clunk.buffer = buf;
        const lp = audio.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 700;
        const g1 = audio.createGain();
        g1.gain.value = 0.9;
        clunk.connect(lp).connect(g1).connect(audio.destination);
        clunk.start(t);
        const motor = audio.createOscillator();
        motor.type = 'sawtooth';
        motor.frequency.setValueAtTime(140, t + 0.08);
        motor.frequency.linearRampToValueAtTime(520, t + 0.75);
        const mlp = audio.createBiquadFilter();
        mlp.type = 'lowpass';
        mlp.frequency.value = 1400;
        const g2 = audio.createGain();
        g2.gain.setValueAtTime(0, t + 0.08);
        g2.gain.linearRampToValueAtTime(0.12, t + 0.15);
        g2.gain.setValueAtTime(0.12, t + 0.7);
        g2.gain.linearRampToValueAtTime(0, t + 0.85);
        motor.connect(mlp).connect(g2).connect(audio.destination);
        motor.start(t + 0.08);
        motor.stop(t + 0.9);
      } catch {
        /* no sound, no problem */
      }
    }
    const latch = $('[data-latch]');
    const knob = $('[data-knob]');
    let pos = 0;
    let opening = false;
    const setPos = (p: number) => {
      pos = Math.max(0, Math.min(1, p));
      latch.style.setProperty('--p', String(pos));
      knob.setAttribute('aria-valuenow', String(Math.round(pos * 100)));
    };
    async function open() {
      opening = true;
      setPos(1);
      latch.classList.add('is-open');
      doorSound();
      await replaceRoll();
      setTimeout(() => {
        latch.classList.remove('is-open');
        setPos(0); // the spring pulls the latch back
        opening = false;
      }, 1000);
    }
    const release = () => {
      latch.classList.remove('is-dragging');
      if (pos >= 0.92) open();
      else setPos(0);
    };
    const nudge = () => {
      say(msg('slide'), true);
      latch.classList.remove('is-nudge');
      void latch.offsetWidth;
      latch.classList.add('is-nudge');
    };
    let drag: { x: number; p: number; moved: boolean } | null = null;
    latch.addEventListener('pointerdown', (e) => {
      if (opening) return;
      latch.setPointerCapture(e.pointerId);
      latch.classList.add('is-dragging');
      drag = { x: e.clientX, p: pos, moved: false };
    });
    latch.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const range = latch.clientWidth - knob.offsetWidth;
      if (Math.abs(e.clientX - drag.x) > 4) drag.moved = true;
      setPos(drag.p + (e.clientX - drag.x) / range);
    });
    const up = () => {
      if (!drag) return;
      const moved = drag.moved;
      drag = null;
      if (!moved) {
        latch.classList.remove('is-dragging');
        setPos(0);
        nudge(); // a tap doesn't open it: show how
      } else release();
    };
    latch.addEventListener('pointerup', up);
    latch.addEventListener('pointercancel', up);
    knob.addEventListener('keydown', (e) => {
      if (opening) return;
      const k = e.key;
      if (k === 'ArrowRight' || k === 'ArrowUp') setPos(pos + 0.25);
      else if (k === 'ArrowLeft' || k === 'ArrowDown' || k === 'Home') setPos(k === 'Home' ? 0 : pos - 0.25);
      else if (k === 'End' || k === 'Enter' || k === ' ') setPos(1);
      else return;
      e.preventDefault();
      if (pos >= 1) open();
    });
    knob.addEventListener('blur', () => {
      if (!opening && !drag) setPos(0);
    });

    // Controls.
    for (const b of $$<HTMLButtonElement>('[data-step]'))
      b.addEventListener('click', () => {
        const k = b.dataset.step as 'iso' | 'shutter' | 'aperture';
        const max = { iso: ISO, shutter: SHUTTER, aperture: APERTURE }[k].length - 1;
        st[k] = Math.max(0, Math.min(max, st[k] + Number(b.dataset.d)));
        draw();
      });
    for (const b of $$<HTMLButtonElement>('[data-opt]'))
      b.addEventListener('click', () => {
        const k = b.dataset.opt as 'lens' | 'wb' | 'filter' | 'scene' | 'pose';
        st[k] = Number(b.dataset.i);
        for (const o of opts(k)) o.setAttribute('aria-pressed', String(o === b));
        if (k === 'lens') st.px = st.py = 0; // a new lens starts aimed at Deo
        draw();
      });
    const tabs = $$<HTMLButtonElement>('[role="tab"]');
    const pick = (t: HTMLButtonElement) => {
      for (const o of tabs) {
        const on = o === t;
        o.setAttribute('aria-selected', String(on));
        o.tabIndex = on ? 0 : -1;
        $(`[data-panel="${o.dataset.tab}"]`).hidden = !on;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const rtl = getComputedStyle(root).direction === 'rtl' ? -1 : 1;
        const n = tabs[(i + d * rtl + tabs.length) % tabs.length];
        pick(n);
        n.focus();
      });
    });
    const pan = (dx: number, dy: number) => {
      if (!dx && !dy) st.px = st.py = 0;
      const L = lens();
      st.px += (dx * VW) / L.z / 8;
      st.py += (dy * VH) / L.z / 8;
      draw();
    };
    for (const b of $$<HTMLButtonElement>('[data-pan]'))
      b.addEventListener('click', () => {
        const [dx, dy] = b.dataset.pan!.split(',').map(Number);
        pan(dx, dy);
      });
    $('[data-view]').addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      const d: Record<string, [number, number]> = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0] };
      if (d[k]) {
        e.preventDefault();
        pan(...d[k]);
      } else if (k === ' ' || k === 'Enter') {
        e.preventDefault();
        shoot();
      }
    });
    $('[data-shoot]').addEventListener('click', () => shoot());
    draw();
  }
</script>
