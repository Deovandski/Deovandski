---
/**
 * StageDancer: a chibi pixel character dancing disco routines on a stage, under sweeping coloured
 * spotlights, a mirror ball and a light-up floor. Four routines to pick from (#1 to #4):
 *   #1 The point: the Saturday Night Fever "point" (arm up to the sky, then down across the body), hip
 *      rolls and a turn.
 *   #2 The line dance: the "Night Fever" line dance as the 1978-79 disco books wrote it up: back three
 *      and clap, forward three and clap, a turn each way, a snap kick, the skate, the point with merengue
 *      hips, a hand roll, the funky chicken and a pivot.
 *   #3 The hustle: a four-count street hustle with hip bumps and rope arms.
 *   #4 Toe stand & point: up on the toes, one finger pointing straight up, a lean and a kick.
 * A fever meter on the right fills while it dances, faster when you tap the stage on the beat, and at the
 * top hits FEVER! (the whole floor lights up). An optional 8-bit disco loop (original music, synthesized
 * with Web Audio, no files) plays in time with the dance. The character is drawn in code (no image files),
 * and its colours are props, so it can be dressed differently.
 *
 * Reusable on purpose: no imports, no site CSS needed, safe to use several times on a page.
 * Copy this one file into any Astro project. See README.md in this folder.
 *
 *   <StageDancer label="Chibi Deo dancing" />
 *   <StageDancer outfit={{ robe: '#d33', pattern: '#fff' }} bpm={120} />
 *
 * Props:
 *   outfit  colours: { hat, hatTrim, skin, beard, robe, pattern, hem, boots }. Defaults: the yellow
 *           king's robes with blue patterns and a black-and-gold crown hat.
 *   bpm     dance tempo in beats per minute. Default 110 (one pose per beat).
 *   label   what's on screen, for screen readers.
 *
 * Theming (CSS custom properties): --dancer-accent (default #39c5bb).
 *
 * Accessible: a text label describes the scene; buttons pick the routine, pause the dance, change the
 * light colours and turn the music on or off; the fever meter is a role="meter" with its value, and Space or
 * Enter on the stage taps the beat. Lights change on the beat (under 3 changes a second, within WCAG's flash
 * limit), and FEVER! only brightens the floor, it doesn't strobe. Reduced motion shows a still point pose
 * with steady lights. The music is off until the visitor turns it on, and stops when the dance pauses or
 * the stage is hidden.
 */
interface Props {
  outfit?: Partial<Record<'hat' | 'hatTrim' | 'skin' | 'beard' | 'robe' | 'pattern' | 'hem' | 'boots', string>>;
  bpm?: number;
  label?: string;
  class?: string;
}
const {
  outfit = {},
  bpm = 110,
  label = 'A chibi pixel character in yellow king’s robes and a crown hat, dancing the Saturday Night Fever disco point under stage lights.',
  class: className,
} = Astro.props;
const colors = {
  hat: '#1c1a1d',
  hatTrim: '#e2b33c',
  skin: '#f0c8a8',
  beard: '#3b2a20',
  robe: '#f5c518',
  pattern: '#2f5fbf',
  hem: '#ffffff',
  boots: '#f2b705',
  ...outfit,
};
// What the script writes (and draws on the stage). It lives in the page so the site's translations reach it.
const strings: Record<string, string> = {
  routine0: 'The point',
  routine1: 'The line dance',
  routine2: 'The hustle',
  routine3: 'Toe stand & point',
  routine: 'Routine #{n}: {routine}.',
  onBeat: 'On beat!',
  offBeat: 'Off beat',
  fever: 'FEVER!',
  feverLive: 'FEVER! The whole floor lights up.',
  musicOn: 'Music: on',
  musicOff: 'Music: off',
  dance: 'Dance',
  pause: 'Pause',
};
---

<div class:list={['stage-dancer', className]} data-colors={JSON.stringify(colors)} data-bpm={bpm}>
  <div class="stage-dancer__strings" hidden data-llms-skip>{Object.entries(strings).map(([k, v]) => <span data-k={k}>{v}</span>)}</div>
  <div class="stage-dancer__routines" role="group" aria-label="Pick a routine">
    <button type="button" data-routine="0" aria-pressed="true">#1 The point</button>
    <button type="button" data-routine="1" aria-pressed="false">#2 Line dance</button>
    <button type="button" data-routine="2" aria-pressed="false">#3 Hustle</button>
    <button type="button" data-routine="3" aria-pressed="false">#4 Toe stand</button>
  </div>
  <div class="stage-dancer__stage">
    <canvas class="stage-dancer__canvas" role="img" aria-label={label} tabindex="0"></canvas>
    <div class="stage-dancer__fever" role="meter" aria-label="Fever" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="stage-dancer__fever-fill"></span>
      <span class="stage-dancer__fever-label" aria-hidden="true">Fever</span>
    </div>
    <p class="stage-dancer__hint" aria-hidden="true">Tap the stage on the beat</p>
  </div>
  <p class="stage-dancer__status" aria-live="polite"></p>
  <div class="stage-dancer__controls">
    <button type="button" data-act="pause" aria-pressed="false">Pause</button>
    <button type="button" data-act="lights">Change the lights</button>
    <button type="button" data-act="music" aria-pressed="false">Music: off</button>
  </div>
</div>

<style>
  .stage-dancer {
    --_accent: var(--dancer-accent, #39c5bb);
    margin: 0.5rem 0 1.5rem;
  }
  .stage-dancer__routines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .stage-dancer__stage {
    position: relative;
  }
  .stage-dancer__fever {
    position: absolute;
    top: 12%;
    right: 12px;
    bottom: 12%;
    width: 22px;
    border-radius: 11px;
    border: 2px solid rgba(255, 255, 255, 0.55);
    background: rgba(0, 0, 0, 0.45);
    overflow: hidden;
    pointer-events: none;
  }
  .stage-dancer__fever-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--fever, 0%);
    background: linear-gradient(to top, #39c5bb, #ffd23f 55%, #ff2d95);
    transition: height 0.25s ease-out;
  }
  .stage-dancer__fever-label {
    position: absolute;
    left: 50%;
    bottom: 6px;
    transform: translateX(-50%) rotate(-90deg);
    transform-origin: center;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #fff;
    text-shadow: 0 1px 2px #000;
    white-space: nowrap;
  }
  .stage-dancer.is-fever .stage-dancer__fever {
    border-color: #ffd23f;
    box-shadow: 0 0 14px #ff2d95;
  }
  .stage-dancer__hint {
    position: absolute;
    left: 12px;
    bottom: 8px;
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    pointer-events: none;
  }
  .stage-dancer__status {
    min-height: 1.3em;
    margin: 0.35rem 0 0;
    font-weight: 700;
    color: var(--_accent);
  }
  .stage-dancer__canvas:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .stage-dancer__canvas {
    display: block;
    width: 100%;
    cursor: pointer;
    height: clamp(260px, 38vw, 360px);
    border-radius: 16px;
    background: #07040d;
    image-rendering: pixelated;
  }
  .stage-dancer__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .stage-dancer__routines button,
  .stage-dancer__controls button {
    min-height: 2.5rem;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--_accent);
    background: transparent;
    color: var(--_accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .stage-dancer__routines button[aria-pressed='true'],
  .stage-dancer__controls button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--_accent) 18%, transparent);
  }
  .stage-dancer__routines button:focus-visible,
  .stage-dancer__controls button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>

<script>
  type Colors = Record<'hat' | 'hatTrim' | 'skin' | 'beard' | 'robe' | 'pattern' | 'hem' | 'boots', string>;
  // A pose: arm end points relative to the shoulders (elbow optional), hip shift, head lean, leg spread,
  // whether the right hand points, and whether we see the back (the turn).
  type Arm = { hand: [number, number]; elbow?: [number, number]; point?: boolean };
  // kick: which leg (1 right, -1 left) swings out and up; toe: up on the toes (the body rises).
  type Pose = { r: Arm; l: Arm; hip: number; lean: number; legs: number; back?: boolean; bob?: number; kick?: 1 | -1; toe?: boolean };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GW = 40;
  const GH = 54;

  // The routine, one pose per beat: the famous point up and down (twice), hip rolls, a turn, a big finish.
  const HIP_L: Arm = { elbow: [-5, 5], hand: [-1, 9] };
  const POINT_UP: Pose = { r: { hand: [9, -11], point: true }, l: HIP_L, hip: 2, lean: -1, legs: 3 };
  const POINT_DOWN: Pose = { r: { elbow: [2, 6], hand: [-8, 11], point: true }, l: HIP_L, hip: -2, lean: 1, legs: 2, bob: 1 };
  const ROLL_L: Pose = { r: { elbow: [5, 4], hand: [1, -1] }, l: { elbow: [-5, 4], hand: [-1, -1] }, hip: -3, lean: -1, legs: 2 };
  const ROLL_R: Pose = { ...ROLL_L, hip: 3, lean: 1, bob: 1 };
  const TURN: Pose = { r: { hand: [9, 3] }, l: { hand: [-9, 3] }, hip: 0, lean: 0, legs: 1, back: true };
  const FINISH: Pose = { r: { hand: [8, -13], point: true }, l: { hand: [-9, 6] }, hip: 3, lean: -1, legs: 4 };
  const ROUTINE: Pose[] = [POINT_UP, POINT_DOWN, POINT_UP, POINT_DOWN, ROLL_L, ROLL_R, ROLL_L, ROLL_R, POINT_UP, POINT_DOWN, TURN, FINISH];

  // #2 The line dance, from the disco books' write-up: walk back 3 and clap, walk forward 3 and clap,
  // a turn each way, snap kick, the skate, the point with merengue hips, a hand roll, the funky chicken,
  // and the pivot (toe points, then a turn with the knee up).
  const SWING_L: Arm = { hand: [-3, 9] };
  const SWING_R: Arm = { hand: [3, 9] };
  const WALK_A: Pose = { r: { hand: [4, 7] }, l: { hand: [-2, 9] }, hip: 1, lean: 0, legs: 2, bob: 1 };
  const WALK_B: Pose = { r: { hand: [2, 9] }, l: { hand: [-4, 7] }, hip: -1, lean: 0, legs: 2 };
  const CLAP: Pose = { r: { elbow: [3, 6], hand: [-5, 5] }, l: { elbow: [-3, 6], hand: [5, 5] }, hip: 0, lean: 0, legs: 2 };
  const SPIN_SIDE: Pose = { r: { hand: [8, 1] }, l: { hand: [-6, 6] }, hip: 2, lean: 1, legs: 1 };
  const KICK: Pose = { r: { hand: [6, 6] }, l: { hand: [-6, 6] }, hip: -1, lean: 0, legs: 2, kick: 1 };
  const SKATE_L: Pose = { r: SWING_R, l: SWING_L, hip: -3, lean: -1, legs: 1 };
  const SKATE_R: Pose = { ...SKATE_L, hip: 3, lean: 1, bob: 1 };
  const MERENGUE_R: Pose = { ...POINT_UP, hip: 3 };
  const HANDS_IN: Pose = { r: { elbow: [3, 7], hand: [-3, 7] }, l: { elbow: [-3, 7], hand: [3, 7] }, hip: -3, lean: 0, legs: 2, bob: 1 };
  const CHICKEN: Pose = { r: { elbow: [7, 3], hand: [1, 5] }, l: { elbow: [-7, 3], hand: [-1, 5] }, hip: 0, lean: 0, legs: 1, bob: 1 };
  const CHICKEN_UP: Pose = { r: { elbow: [7, 0], hand: [1, 5] }, l: { elbow: [-7, 0], hand: [-1, 5] }, hip: 0, lean: 0, legs: 1 };
  const TOE_FWD: Pose = { r: SWING_R, l: SWING_L, hip: 0, lean: 0, legs: 2, kick: 1 };
  const KNEE_UP: Pose = { r: { hand: [8, 2] }, l: { hand: [-8, 2] }, hip: -1, lean: 0, legs: 1, kick: 1, back: true };
  const LINE_DANCE: Pose[] = [
    WALK_A, WALK_B, WALK_A, CLAP, WALK_B, WALK_A, WALK_B, CLAP,
    SPIN_SIDE, TURN, SPIN_SIDE, CLAP,
    KICK, WALK_A, KICK, WALK_B,
    SKATE_L, SKATE_R, SKATE_L, SKATE_R,
    MERENGUE_R, HANDS_IN, MERENGUE_R, HANDS_IN,
    ROLL_L, ROLL_R, CHICKEN, CHICKEN_UP,
    TOE_FWD, WALK_B, KNEE_UP, FINISH,
  ];

  // #3 The hustle: a four-count street hustle, stepping side to side with hip bumps and rope arms.
  const BUMP_R: Pose = { r: { elbow: [4, 5], hand: [6, 1] }, l: { elbow: [-5, 5], hand: [-2, 8] }, hip: 4, lean: 1, legs: 3 };
  const BUMP_L: Pose = { r: { elbow: [5, 5], hand: [2, 8] }, l: { elbow: [-4, 5], hand: [-6, 1] }, hip: -4, lean: -1, legs: 3 };
  const ROPE_UP: Pose = { r: { hand: [7, -9] }, l: { elbow: [-5, 4], hand: [-1, 2] }, hip: 2, lean: -1, legs: 2, bob: 1 };
  const ROPE_DOWN: Pose = { r: { elbow: [6, 1], hand: [3, -4] }, l: { elbow: [-5, 4], hand: [-1, 2] }, hip: -2, lean: 1, legs: 2 };
  const HUSTLE: Pose[] = [BUMP_R, BUMP_L, BUMP_R, CLAP, BUMP_L, BUMP_R, BUMP_L, CLAP, ROPE_UP, ROPE_DOWN, ROPE_UP, ROPE_DOWN, ROLL_L, ROLL_R, TURN, POINT_UP];

  // #4 Toe stand & point: hand on the hip, up on the toes with one finger straight up, a lean, a kick, a turn.
  const HAND_HIP: Pose = { r: { elbow: [5, 5], hand: [1, 9] }, l: HIP_L, hip: 2, lean: 0, legs: 2 };
  const TOE_POINT: Pose = { r: { hand: [2, -15], point: true }, l: { hand: [-5, 10] }, hip: 1, lean: 1, legs: 1, toe: true };
  const LEAN: Pose = { r: { hand: [7, 4] }, l: { hand: [-7, 6] }, hip: -3, lean: -2, legs: 2 };
  const SIDE_KICK: Pose = { r: { hand: [5, 7] }, l: { hand: [-8, -2] }, hip: -2, lean: -1, legs: 1, kick: 1 };
  const TOE_STAND: Pose[] = [HAND_HIP, HAND_HIP, TOE_POINT, TOE_POINT, LEAN, SIDE_KICK, TURN, TOE_POINT];

  const ROUTINES: Pose[][] = [ROUTINE, LINE_DANCE, HUSTLE, TOE_STAND];

  // Draws one pose into a GW x GH grid of colours, then outlines it in black.
  function render(pose: Pose, c: Colors): (string | null)[][] {
    const g: (string | null)[][] = Array.from({ length: GH }, () => Array(GW).fill(null));
    const set = (x: number, y: number, col: string) => {
      x = Math.round(x);
      y = Math.round(y);
      if (x >= 0 && y >= 0 && x < GW && y < GH) g[y][x] = col;
    };
    const rect = (x: number, y: number, w: number, h: number, col: string) => {
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) set(x + i, y + j, col);
    };
    const ellipse = (cx: number, cy: number, rx: number, ry: number, col: string, from = -99, to = 99) => {
      for (let y = Math.floor(cy - ry); y <= cy + ry; y++)
        for (let x = Math.floor(cx - rx); x <= cx + rx; x++) {
          if (y < from || y > to) continue;
          if (((x - cx) / (rx + 0.4)) ** 2 + ((y - cy) / (ry + 0.4)) ** 2 <= 1) set(x, y, col);
        }
    };
    const line = (x0: number, y0: number, x1: number, y1: number, w: number, col: string) => {
      const n = Math.ceil(Math.hypot(x1 - x0, y1 - y0) * 2);
      for (let i = 0; i <= n; i++) {
        const x = x0 + ((x1 - x0) * i) / n;
        const y = y0 + ((y1 - y0) * i) / n;
        rect(x - w / 2, y - w / 2, w, w, col);
      }
    };
    const bob = (pose.bob ?? 0) - (pose.toe ? 2 : 0);
    const cx = 20;
    const hip = pose.hip;
    // Legs and boots.
    const legY = 41 + bob;
    for (const side of [-1, 1]) {
      const kicking = pose.kick === side;
      const fx = cx + side * (kicking ? pose.legs + 6 : pose.legs) + hip * 0.5;
      const fy = kicking ? 45 + bob : 49 - (pose.toe ? 2 : 0);
      line(cx + side * 2 + hip, legY, fx, fy, 3, c.robe);
      if (pose.toe && !kicking) rect(fx - 1, fy, 3, 4, c.boots); // on tiptoe: a narrow boot standing up
      else rect(fx - 2, fy, 5, 3, c.boots);
    }
    // Robe: a trapezoid from the shoulders to a hem that swings with the hips, blue pattern, striped hem.
    const top = 24 + bob;
    const bottom = 44 + bob;
    for (let y = top; y <= bottom; y++) {
      const k = (y - top) / (bottom - top);
      const half = 6 + k * 4.5;
      const shift = hip * k;
      for (let x = Math.round(cx - half + shift); x <= Math.round(cx + half + shift); x++) {
        let col = c.robe;
        if (y >= bottom - 2) col = (x + y) % 2 ? c.hem : c.pattern; // striped hem
        else if ((x * 7 + y * 3) % 11 === 0 || (y === top + 6 && Math.abs(x - cx - shift) < 3)) col = c.pattern; // dragon and cloud dots
        set(x, y, col);
      }
    }
    // Arms: wide yellow sleeves with a hand; the pointing hand has a finger.
    for (const [side, arm] of [[1, pose.r], [-1, pose.l]] as [number, Arm][]) {
      const sx = cx + side * 6 + hip * 0.1;
      const sy = top + 2;
      const hx = sx + arm.hand[0];
      const hy = sy + arm.hand[1];
      if (arm.elbow) {
        const ex = sx + arm.elbow[0];
        const ey = sy + arm.elbow[1];
        line(sx, sy, ex, ey, 4, c.robe);
        line(ex, ey, hx, hy, 3, c.robe);
      } else line(sx, sy, hx, hy, 4, c.robe);
      rect(hx - 1, hy - 1, 3, 3, c.skin);
      if (arm.point) {
        const dx = Math.sign(arm.hand[0]) || 1;
        const dy = Math.sign(arm.hand[1]) || -1;
        set(hx + dx * 2, hy + dy * 2, c.skin);
        set(hx + dx * 3, hy + dy * 3, c.skin);
      }
    }
    // Big chibi head with the crown hat.
    const hx = cx + pose.lean + hip * 0.2;
    const hy = 14 + bob;
    ellipse(hx, hy, 8, 8, c.skin);
    if (pose.back) {
      ellipse(hx, hy, 8, 8, c.beard, hy - 2, hy + 6); // the back of the head
    } else {
      // Short dark beard around the jaw, a moustache, eyes and brows.
      ellipse(hx, hy + 1, 8, 7, c.beard, hy + 3, hy + 9);
      rect(hx - 2, hy + 3, 5, 1, c.beard);
      rect(hx - 1, hy + 5, 3, 1, '#b24a3a');
      rect(hx - 4, hy, 2, 2, '#1b1b1b');
      rect(hx + 3, hy, 2, 2, '#1b1b1b');
      rect(hx - 5, hy - 2, 3, 1, c.beard);
      rect(hx + 3, hy - 2, 3, 1, c.beard);
    }
    // Crown hat: black with gold trim and studs, a little gold top.
    rect(hx - 7, hy - 10, 15, 5, c.hat);
    rect(hx - 8, hy - 6, 17, 2, c.hatTrim);
    rect(hx - 1, hy - 13, 3, 3, c.hatTrim);
    for (let i = -6; i <= 6; i += 3) set(hx + i, hy - 8, c.hatTrim);
    // Outline.
    const out = g.map((row) => row.slice());
    for (let y = 0; y < GH; y++)
      for (let x = 0; x < GW; x++) {
        if (g[y][x]) continue;
        if (g[y - 1]?.[x] || g[y + 1]?.[x] || g[y][x - 1] || g[y][x + 1]) out[y][x] = '#0d0b10';
      }
    return out;
  }

  const PALETTES = [
    ['#ff2d95', '#39c5bb', '#ffd23f'],
    ['#7b2ff7', '#ff7a18', '#00e5ff'],
    ['#00ff9c', '#ff3b3b', '#f8f8ff'],
    ['#ff5ec4', '#5e9bff', '#ffe066'],
  ];

  document.querySelectorAll<HTMLElement>('.stage-dancer').forEach((root) => {
    // The page's (possibly translated) words; {name} slots are filled in here.
    const msg = (key: string, vars: Record<string, string | number> = {}) =>
      (root.querySelector(`.stage-dancer__strings [data-k="${key}"]`)?.textContent ?? key).replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
    const canvas = root.querySelector<HTMLCanvasElement>('.stage-dancer__canvas')!;
    const ctx = canvas.getContext('2d')!;
    const colors: Colors = JSON.parse(root.dataset.colors!);
    const beat = 60000 / (Number(root.dataset.bpm) || 110);
    const frames = ROUTINES.map((r) => r.map((p) => render(p, colors)));
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-act="pause"]')!;
    const lightsBtn = root.querySelector<HTMLButtonElement>('[data-act="lights"]')!;
    const musicBtn = root.querySelector<HTMLButtonElement>('[data-act="music"]')!;
    const routineBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-routine]'));
    const meter = root.querySelector<HTMLElement>('.stage-dancer__fever')!;
    const status = root.querySelector<HTMLElement>('.stage-dancer__status')!;
    let routine = 0;
    // Fever: 0-100. Dancing fills it a little every beat, an on-beat tap fills it more. At 100: FEVER!
    let fever = 0;
    let feverUntil = -1; // the beat FEVER! lasts until
    let lastBeat = -1;
    let flash: { text: string; until: number } | null = null;
    // On screen? A closed <details> (a FastTab) keeps its content laid out in Chrome (content-visibility),
    // so offsetParent alone isn't enough; checkVisibility() sees through that.
    const visible = () => (typeof root.checkVisibility === 'function' ? root.checkVisibility() : !!root.offsetParent);
    let W = 0;
    let H = 0;
    let palette = 0;
    let paused = reduced;
    let start = performance.now();
    let pausedAt = start;
    let running = false;

    function size() {
      const r = canvas.getBoundingClientRect();
      if (!r.width) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    }

    function draw(now: number) {
      const t = (paused ? pausedAt : now) - start;
      const b = Math.floor(t / beat);
      const pal = PALETTES[(palette + Math.floor(b / 8)) % PALETTES.length];
      ctx.clearRect(0, 0, W, H);
      // Light-up floor: tiles in perspective, changing colour on the beat (twice a second at most).
      const floorTop = H * 0.62;
      const rows = 5;
      for (let r = 0; r < rows; r++) {
        const y0 = floorTop + ((H - floorTop) * (r / rows) ** 1.3);
        const y1 = floorTop + ((H - floorTop) * ((r + 1) / rows) ** 1.3);
        const cols = 9;
        const spread0 = 0.55 + 0.45 * (r / rows);
        const spread1 = 0.55 + 0.45 * ((r + 1) / rows);
        for (let k = 0; k < cols; k++) {
          const lit = b < feverUntil || (k + r + b) % 3 === 0;
          const x00 = W / 2 + (k / cols - 0.5) * W * spread0;
          const x01 = W / 2 + ((k + 1) / cols - 0.5) * W * spread0;
          const x10 = W / 2 + (k / cols - 0.5) * W * spread1;
          const x11 = W / 2 + ((k + 1) / cols - 0.5) * W * spread1;
          ctx.fillStyle = lit ? pal[(k + r) % 3] : '#1a1424';
          ctx.globalAlpha = lit ? 0.75 : 1;
          ctx.beginPath();
          ctx.moveTo(x00 + 1, y0 + 1);
          ctx.lineTo(x01 - 1, y0 + 1);
          ctx.lineTo(x11 - 1, y1 - 1);
          ctx.lineTo(x10 + 1, y1 - 1);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      // Spotlights sweeping from the top corners onto the dancer.
      const sweep = reduced || paused ? 0 : Math.sin(t / 900) * W * 0.12;
      for (const [i, sx] of [W * 0.08, W * 0.92, W * 0.5].entries()) {
        const tx = W / 2 + (i === 2 ? 0 : sweep * (i ? -1 : 1));
        const grad = ctx.createLinearGradient(sx, 0, tx, floorTop + 30);
        grad.addColorStop(0, pal[i] + 'aa');
        grad.addColorStop(1, pal[i] + '10');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(sx - 6, 0);
        ctx.lineTo(sx + 6, 0);
        ctx.lineTo(tx + 60, floorTop + 40);
        ctx.lineTo(tx - 60, floorTop + 40);
        ctx.fill();
      }
      // Mirror ball with glinting facets.
      // Centred on wide stages; off to the side on narrow ones so the dancer's hat stays clear.
      const mx = W < 520 ? W * 0.8 : W / 2;
      const my = H * 0.11;
      ctx.strokeStyle = '#777';
      ctx.beginPath();
      ctx.moveTo(mx, 0);
      ctx.lineTo(mx, my - 16);
      ctx.stroke();
      ctx.fillStyle = '#cfd3da';
      ctx.beginPath();
      ctx.arc(mx, my, 16, 0, Math.PI * 2);
      ctx.fill();
      for (let i = 0; i < 18; i++) {
        const a = i * 1.7 + (reduced || paused ? 0 : t / 700);
        const fx = mx + Math.cos(a) * 11 * Math.abs(Math.sin(i));
        const fy = my + Math.sin(i * 2.3) * 11;
        ctx.fillStyle = (i + b) % 4 === 0 ? '#ffffff' : '#9aa1ab';
        ctx.fillRect(fx - 2, fy - 2, 4, 4);
      }
      // The dancer, centred on the floor, scaled to the stage in whole pixels.
      const set = frames[routine];
      const frame = reduced ? frames[0][0] : set[b % set.length];
      const p = Math.max(3, Math.floor((H * 0.62) / GH));
      const ox = Math.round(W / 2 - (GW * p) / 2);
      const oy = Math.round(floorTop + H * 0.18 - GH * p);
      // A soft pool of light under the feet.
      ctx.fillStyle = pal[0] + '40';
      ctx.beginPath();
      ctx.ellipse(W / 2, oy + 51 * p, 16 * p, 4 * p, 0, 0, Math.PI * 2);
      ctx.fill();
      for (let y = 0; y < GH; y++)
        for (let x = 0; x < GW; x++) {
          const col = frame[y][x];
          if (!col) continue;
          ctx.fillStyle = col;
          ctx.fillRect(ox + x * p, oy + y * p, p, p);
        }
      // "On beat!" / "FEVER!" call-outs, top left.
      const call = b < feverUntil ? msg('fever') : flash && now < flash.until ? flash.text : '';
      if (call) {
        ctx.font = `900 ${Math.max(16, Math.round(H * 0.07))}px system-ui, sans-serif`;
        ctx.textAlign = 'left';
        ctx.fillStyle = b < feverUntil ? pal[(b % 3)] : '#ffffff';
        ctx.fillText(call, 14, Math.max(26, H * 0.12));
      }
      if (!paused) beatTick(b);
    }

    // Once per beat while dancing: the fever meter fills a little; FEVER! runs its course.
    function beatTick(b: number) {
      if (b === lastBeat) return;
      lastBeat = b;
      if (b < feverUntil) return;
      if (feverUntil > 0 && b === feverUntil) {
        feverUntil = -1;
        setFever(60);
        return;
      }
      setFever(fever + (music.on ? 2.5 : 1.5));
    }
    function setFever(v: number) {
      fever = Math.max(0, Math.min(100, v));
      meter.style.setProperty('--fever', `${fever}%`);
      meter.setAttribute('aria-valuenow', String(Math.round(fever)));
      if (fever >= 100 && feverUntil < 0) {
        feverUntil = lastBeat + 8;
        root.classList.add('is-fever');
        status.textContent = msg('feverLive');
      } else if (fever < 100) {
        root.classList.remove('is-fever');
      }
    }
    // Tapping the stage (or Space/Enter on it): on the beat fills the meter, off the beat drains it a bit.
    function tap() {
      if (paused) return;
      const t = performance.now() - start;
      const phase = (t % beat) / beat;
      const onBeat = phase < 0.2 || phase > 0.8;
      flash = { text: msg(onBeat ? 'onBeat' : 'offBeat'), until: performance.now() + 400 };
      setFever(fever + (onBeat ? 7 : -3));
    }
    canvas.addEventListener('pointerdown', tap);
    canvas.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        tap();
      }
    });

    // The music: an original 8-bit disco loop (not any existing song), synthesized with Web Audio and kept
    // in time with the dance. Four bars (Am, F, G, Em): four-on-the-floor kick, offbeat hi-hats, a clap on
    // 2 and 4, an octave-bouncing bass and a square-wave lead, one note per eighth (null = rest).
    const BASS_ROOTS = [45, 41, 43, 40];
    const LEAD = [
      [69, null, 72, null, 76, 74, null, 72],
      [65, null, 69, null, 72, 69, null, 67],
      [67, null, 71, null, 74, 72, null, 71],
      [64, null, 67, null, 71, 69, 67, null],
    ];
    const music = { on: false, ctx: null as AudioContext | null, timer: 0, next: 0, noise: null as AudioBuffer | null };
    const hz = (m: number) => 440 * 2 ** ((m - 69) / 12);
    function tone(type: OscillatorType, freq: number, at: number, len: number, gain: number) {
      const a = music.ctx!;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = type;
      o.frequency.value = freq;
      g.gain.setValueAtTime(gain, at);
      g.gain.exponentialRampToValueAtTime(0.001, at + len);
      o.connect(g).connect(a.destination);
      o.start(at);
      o.stop(at + len + 0.02);
    }
    function hit(at: number, len: number, gain: number, filter: BiquadFilterType, freq: number) {
      const a = music.ctx!;
      const src = a.createBufferSource();
      src.buffer = music.noise;
      const f = a.createBiquadFilter();
      f.type = filter;
      f.frequency.value = freq;
      const g = a.createGain();
      g.gain.setValueAtTime(gain, at);
      g.gain.exponentialRampToValueAtTime(0.001, at + len);
      src.connect(f).connect(g).connect(a.destination);
      src.start(at);
      src.stop(at + len + 0.02);
    }
    function kick(at: number) {
      const a = music.ctx!;
      const o = a.createOscillator();
      const g = a.createGain();
      o.frequency.setValueAtTime(140, at);
      o.frequency.exponentialRampToValueAtTime(42, at + 0.12);
      g.gain.setValueAtTime(0.5, at);
      g.gain.exponentialRampToValueAtTime(0.001, at + 0.16);
      o.connect(g).connect(a.destination);
      o.start(at);
      o.stop(at + 0.18);
    }
    function playStep(step: number, at: number) {
      const sixteenth = beat / 4000;
      const bar = Math.floor(step / 16) % 4;
      const inBar = step % 16;
      if (inBar % 4 === 0) kick(at);
      if (inBar % 4 === 2) hit(at, 0.04, 0.12, 'highpass', 7000);
      if (inBar === 4 || inBar === 12) hit(at, 0.12, 0.18, 'bandpass', 1800);
      if (inBar % 2 === 0) {
        const eighth = inBar / 2;
        tone('square', hz(BASS_ROOTS[bar] + (eighth % 2 ? 12 : 0)), at, sixteenth * 1.8, 0.07);
        const note = LEAD[bar][eighth];
        if (note !== null) tone('square', hz(note), at, sixteenth * 1.9, 0.05);
      }
    }
    // Schedules the next 150 ms of sixteenths, lined up with the dance's beats.
    function schedule() {
      const a = music.ctx;
      if (!a || !music.on) return;
      if (!visible()) return setMusic(false); // the stage was hidden (tab or FastTab closed): music off
      if (paused) return;
      const step = beat / 4;
      const perfZero = performance.now() - a.currentTime * 1000;
      const now = performance.now();
      if (music.next < now) music.next = start + Math.ceil((now - start) / step) * step;
      while (music.next < now + 150) {
        playStep(Math.round((music.next - start) / step), (music.next - perfZero) / 1000);
        music.next += step;
      }
    }
    function setMusic(on: boolean) {
      music.on = on;
      musicBtn.setAttribute('aria-pressed', String(on));
      musicBtn.textContent = msg(on ? 'musicOn' : 'musicOff');
      clearInterval(music.timer);
      if (!on) return;
      if (!music.ctx) {
        music.ctx = new AudioContext();
        const len = music.ctx.sampleRate * 0.3;
        music.noise = music.ctx.createBuffer(1, len, music.ctx.sampleRate);
        const d = music.noise.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      }
      music.ctx.resume();
      music.next = 0;
      music.timer = window.setInterval(schedule, 25);
    }
    musicBtn.addEventListener('click', () => setMusic(!music.on));

    routineBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        routine = Number(btn.dataset.routine);
        routineBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
        status.textContent = msg('routine', { n: routine + 1, routine: msg(`routine${routine}`) });
        if (paused && size()) draw(performance.now());
      }),
    );

    function loop(now: number) {
      if (!running) return;
      if (visible()) draw(now);
      if (!paused) requestAnimationFrame(loop);
      else running = false;
    }
    function play() {
      if (running || !size()) return;
      running = true;
      requestAnimationFrame(loop);
    }

    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.textContent = msg(paused ? 'dance' : 'pause');
      if (paused) pausedAt = performance.now();
      else {
        start += performance.now() - pausedAt;
        play();
      }
    });
    if (reduced) {
      pauseBtn.textContent = msg('dance');
      pauseBtn.setAttribute('aria-pressed', 'true');
    }
    lightsBtn.addEventListener('click', () => {
      palette = (palette + 1) % PALETTES.length;
      if (paused && size()) draw(performance.now());
    });

    new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      if (paused) {
        if (size()) draw(performance.now());
      } else play();
    }).observe(canvas);
    new ResizeObserver(() => {
      if (size()) draw(performance.now());
    }).observe(canvas);
  });
</script>
