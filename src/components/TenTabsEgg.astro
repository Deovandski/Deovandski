---
import { url } from '../lib/url';
import EasterEggBanner from './reusable/EasterEggBanner.astro';

// Easter egg: once a visitor has opened 10 different facets themselves (not through links),
// this banner pops up at the bottom of the screen, once per page load. Nothing is stored or sent.
const AFTER = 10;
---

<EasterEggBanner
  name="ten-tabs"
  image={url('/tea-sip.gif')}
  imageWidth={480}
  imageHeight={270}
  title="Am I that really interesting?"
  floating
>
  <p>
    Or are you here trying to find ammunition to do something? I'm not tracking anything, but if you want something from
    me, just skip the masturbatory mind games and ask me straight, and save us both time.
  </p>
  <p>I hate triangulation and wishy-washy behavior. I do respect directness and clear communication.</p>
</EasterEggBanner>

<script define:vars={{ AFTER }}>
  // Count the different facets the visitor opens by clicking (the tree's `facetopen` events with source 'user').
  const opened = new Set();
  let shown = false;
  document.addEventListener('facetopen', (e) => {
    const { id, source } = e.detail;
    if (source !== 'user' || shown) return;
    opened.add(id);
    if (opened.size < AFTER) return;
    const egg = document.querySelector('[data-egg="ten-tabs"]');
    if (egg) egg.hidden = false;
    shown = true;
  });
</script>
