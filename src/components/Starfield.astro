<canvas class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.starfield');
  const ctx = canvas?.getContext('2d');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Star = { x: number; y: number; r: number; a: number; tw: number; ph: number; color: string };
  let stars: Star[] = [];

  function pickColor() {
    const roll = Math.random();
    if (roll < 0.08) return '57,197,187'; // Miku teal
    if (roll < 0.1) return '225,40,133'; // Miku pink
    return '230,237,243';
  }

  function build() {
    if (!canvas || !ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = innerWidth * dpr;
    canvas.height = innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.round((innerWidth * innerHeight) / 3200);
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * innerWidth,
      y: Math.random() * innerHeight,
      r: Math.random() < 0.92 ? Math.random() * 0.9 + 0.2 : Math.random() * 1.2 + 1,
      a: Math.random() * 0.6 + 0.3,
      tw: Math.random() < 0.25 ? Math.random() * 0.0015 + 0.0005 : 0,
      ph: Math.random() * Math.PI * 2,
      color: pickColor(),
    }));
  }

  function draw(t = 0) {
    if (!canvas || !ctx) return;
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    for (const s of stars) {
      const alpha = s.tw ? s.a * (0.6 + 0.4 * Math.sin(t * s.tw + s.ph)) : s.a;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${s.color},${alpha})`;
      if (s.r > 1) {
        ctx.shadowBlur = 6;
        ctx.shadowColor = `rgba(${s.color},0.8)`;
      } else {
        ctx.shadowBlur = 0;
      }
      ctx.fill();
    }
    if (!still) requestAnimationFrame(draw);
  }

  build();
  draw();
  let resizeTimer: number | undefined;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      build();
      if (still) draw();
    }, 150);
  });
</script>
