---
/**
 * UrsuSprite: Ursu Sintasus, the race Deo made in Spore (#284), as a little side-on SVG sprite running to the right.
 * Feet at (0, 0), about 60 px tall, two running frames (`data-frame="1"` and `"2"`), drawn from Deo's screenshot
 * (public/ursu-sintasus.webp): cream body, black-banded arms and legs, clawed hands and feet, spikes on the hips, a
 * bony crest, moose antlers, big orange eyes and a wide smile. Made for PlanetLap's `chaser` slot:
 *
 *   <PlanetLap …><UrsuSprite slot="chaser" /></PlanetLap>
 */
const C = '#efe7d6'; // cream
const K = '#2b2118'; // outline
const D = '#1d1814'; // stripes
// A limb: outline, cream, then black bands (a dashed stroke as wide as the limb), and claws at the end.
const limb = (d: string, claws: string, w = 4.4) =>
  `<path d="${d}" fill="none" stroke="${K}" stroke-width="${w + 2}" stroke-linecap="round" stroke-linejoin="round"/>` +
  `<path d="${d}" fill="none" stroke="${C}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"/>` +
  `<path d="${d}" fill="none" stroke="${D}" stroke-width="${w}" stroke-dasharray="1.6 2.6" stroke-dashoffset="-2"/>` +
  `<path d="${claws}" fill="none" stroke="${K}" stroke-width="1.3" stroke-linecap="round"/>`;
// Moose antlers: broad palms with short tines, one sweeping back (near) and one forward (far, behind the head).
const antlerBack = `<path d="M9 -45Q3 -46 -1 -50L-5 -53L-2 -54L-6 -58L-1 -56L-2 -61L2 -57L3 -62L5 -57L8 -60L8 -54Q10 -49 12 -46Z" fill="#e9dfc7" stroke="${K}" stroke-width="0.9" stroke-linejoin="round"/>`;
const antlerFore = `<path d="M13 -46Q17 -50 20 -55L19 -59L22 -56L23 -61L25 -56L28 -59L27 -54L30 -54Q26 -49 17 -45Z" fill="#d9cdb1" stroke="${K}" stroke-width="0.9" stroke-linejoin="round"/>`;
const head =
  antlerFore +
  // the neck, then the head
  `<path d="M4 -27L11 -37" stroke="${K}" stroke-width="9" stroke-linecap="round"/><path d="M4 -27L11 -37" stroke="${C}" stroke-width="7" stroke-linecap="round"/>` +
  `<circle cx="12" cy="-40" r="7.5" fill="${C}" stroke="${K}" stroke-width="1.1"/>` +
  // the far eye, peeking over the muzzle
  `<circle cx="18" cy="-43.5" r="2.6" fill="#f08a24" stroke="${K}" stroke-width="0.7"/><circle cx="18.6" cy="-43.5" r="1.1" fill="#1a0d05"/>` +
  // the muzzle and its wide smile
  `<path d="M14 -42Q27 -43 28 -36Q27 -30 16 -31Z" fill="${C}" stroke="${K}" stroke-width="1.1" stroke-linejoin="round"/>` +
  `<path d="M17 -34.5Q22 -29.5 27 -35Q22 -32.5 17 -34.5Z" fill="#7a2c2c" stroke="${K}" stroke-width="0.8"/>` +
  `<path d="M19 -33.6l7 -1" stroke="#fff8ee" stroke-width="0.9"/>` +
  // the near antler, then the bony crest on top of the head
  antlerBack +
  `<path d="M8 -46Q13 -53 18 -46.5Q13 -49 8 -46Z" fill="#d9cdb1" stroke="${K}" stroke-width="0.9"/>` +
  // the big near eye
  `<circle cx="12.5" cy="-41.5" r="3.9" fill="#f08a24" stroke="${K}" stroke-width="0.8"/><circle cx="13.4" cy="-41.3" r="1.7" fill="#1a0d05"/><circle cx="12.2" cy="-42.8" r="0.8" fill="#fff"/>`;
const body =
  `<ellipse cx="1" cy="-22" rx="10.5" ry="7.8" transform="rotate(-25 1 -22)" fill="${C}" stroke="${K}" stroke-width="1.1"/>` +
  `<ellipse cx="3" cy="-20" rx="5.5" ry="4" transform="rotate(-25 3 -20)" fill="#fbf7ee"/>` +
  // spikes on the hip
  `<path d="M-8 -18l-6 -1l4 -2l-5 -3l6 0l-2 -4l4 3z" fill="#f8f2e4" stroke="${K}" stroke-width="0.8" stroke-linejoin="round"/>`;
// Frame 1: a long stride, arms reaching. Frame 2: legs passing, a little hop.
const frames = [
  limb('M-4 -17L-10 -9L-17 -6', 'M-17 -6l-4 0.5M-17 -6l-3 3M-17 -6l-1 3.5') +
    limb('M2 -27L9 -20L15 -18', 'M15 -18l3.5 -1.5M15 -18l3.5 1M15 -18l2 2.5', 3.8) +
    body +
    limb('M-1 -17L6 -10L9 -1', 'M9 -1l4.5 0.5M9 -1l4 -2M9 -1l1.5 1.5') +
    head +
    limb('M6 -27L14 -25L21 -29', 'M21 -29l3 -2.5M21 -29l4 -0.5M21 -29l3 2', 3.8),
  limb('M-4 -17L-4 -9L-8 -1', 'M-8 -1l4.5 0.5M-8 -1l4 -2M-8 -1l1 1.5') +
    limb('M2 -27L10 -24L17 -27', 'M17 -27l3 -2.5M17 -27l4 -0.5M17 -27l3 2', 3.8) +
    body +
    limb('M-1 -17L6 -12L3 -6', 'M3 -6l4 -1M3 -6l3.5 2M3 -6l1.5 3') +
    head +
    limb('M6 -27L13 -21L20 -20', 'M20 -20l3.5 -1.5M20 -20l3.5 1M20 -20l2 2.5', 3.8),
];
---

<g class="ursu-sprite">
  <g data-frame="1" set:html={frames[0]} />
  <g data-frame="2" transform="translate(0 -1.5)" set:html={frames[1]} />
</g>
